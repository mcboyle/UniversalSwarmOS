def summary(path):
    try:
        head = open(path, errors="ignore").read(600)
    except Exception:  # why: input unavailable/unreadable; return empty so the caller uses its fallback, not a wrong value
        return ""
    m = re.search(r'swarm-[\w-]+\s+--\s+(.+)', head)
    return m.group(1).strip() if m else ""



# ---------------------------------------------------------------------------
# WHEN (702): a catalog tells you a tool EXISTS; it does not tell you WHEN to
# reach for it. 88 tools were previously BOTH uncalled by any other tool AND
# absent from the PK reference -- runnable only by remembering they exist.
#
# Every tool therefore inherits a session-phase TRIGGER from its category. This
# is derived (category -> trigger) rather than 227 hand-written prose lines, so
# it cannot drift per-tool; and `swarm-tools --check` FAILS if any tool in bin/ is
# missing from CATEGORY, so a new tool cannot ship without a "when".
WHEN = {
 "Bootstrap / provisioning": "SESSION START -- opening the sandbox, before any work.",
