[Unit]
Description=Boylenet Cross-Pool Mesh Bus & WAL Daemon (:3004)
After=network.target

[Service]
Type=simple
User=mboyle
WorkingDirectory=/home/mboyle
ExecStart=/usr/bin/python3 /home/mboyle/bin/bd-mesh-bus.py --daemon --port 3004
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
