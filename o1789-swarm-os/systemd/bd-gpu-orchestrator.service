[Unit]
Description=Boylenet Dynamic Tier 1/2/3 GPU Mode Orchestrator & Smart OpenAI Auto-Router (:4010)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mboyle
WorkingDirectory=/home/mboyle
ExecStart=/usr/bin/python3 /usr/local/bin/bd-gpu-orchestrator.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
