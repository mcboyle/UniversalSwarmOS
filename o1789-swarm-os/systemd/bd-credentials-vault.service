[Unit]
Description=Boylenet Unified Credentials, API Key & 27-Node SSH Health Vault (:4087)
After=network.target

[Service]
Type=simple
User=mboyle
WorkingDirectory=/home/mboyle
Environment="HOME=/home/mboyle"
Environment="BD_CREDENTIALS_VAULT_PORT=4087"
ExecStart=/usr/bin/python3 /home/mboyle/bin/bd-credentials-vault.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
