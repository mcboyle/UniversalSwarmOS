[Unit]
Description=Boylenet 24/7 Continuous Autonomous Multi-Platform Swarm Driver (Claude A-D, Codex, Kimi, OpenWebUI, Local Heretic)
After=network.target

[Service]
Type=simple
User=mboyle
WorkingDirectory=/home/mboyle
ExecStart=/usr/bin/python3 /home/mboyle/bin/bd-autonomous-swarm-driver.py --daemon
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
