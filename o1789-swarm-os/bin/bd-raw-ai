#!/usr/bin/env bash
# bd-raw-ai — Run any Local Vault Model (86 models) or Cloud Harness (Claude/Codex/Kimi)
# with ZERO Hooks, ZERO Fleet Rules (no CLAUDE.md/AGENTS.md/GEMINI.md), and ZERO System Prompts.
set -euo pipefail

HARNESS="${1:-local}"
shift || true

if [[ "$HARNESS" == "--list" || "$HARNESS" == "-l" ]]; then
  python3 - << 'PY'
import json, urllib.request
print("=== Cloud Harnesses (Zero Hooks / Zero Rules) ===")
for h in ["claude-a", "claude-b", "claude-c", "claude-d", "codex", "gpt-6.1-sol", "gpt-6-astra"]:
    print(f"  - {h}")
print("=== Resident BattleStation 2080 Ti Models (10.0.10.137:11434) ===")
try:
    with urllib.request.urlopen("http://10.0.10.137:11434/api/tags", timeout=3) as r:
        for m in json.load(r).get("models", []):
            print(f"  - {m['name']}")
except Exception as e:
    print(f"  [warn] {e}")
print("=== GPU Orchestrator (:4010) Vault Models ===")
try:
    req = urllib.request.Request("http://10.0.70.164:4010/v1/models", headers={"Authorization": "Bearer sk-local"})
    with urllib.request.urlopen(req, timeout=3) as r:
        data = json.load(r).get("data", [])
        for m in data[:15]:
            print(f"  - {m['id']}")
        if len(data) > 15:
            print(f"  ... (+{len(data)-15} more models)")
except Exception as e:
    print(f"  [warn] {e}")
PY
  exit 0
fi

if [[ "$HARNESS" == "--model" || "$HARNESS" == "-m" ]]; then
  HARNESS="${1:-qwen2.5-coder:7b}"
  shift || true
fi

PROMPT="${*:-}"

RAW_DIR="/var/tmp/bd-raw-unleashed-workspace"
mkdir -p "$RAW_DIR"
cd "$RAW_DIR"

case "$HARNESS" in
  claude|claude-a|claude-b|claude-c|claude-d)
    POOL_LETTER="${HARNESS#claude-}"
    [[ "$POOL_LETTER" == "claude" ]] && POOL_LETTER="a"
    POOL_UPPER=$(echo "$POOL_LETTER" | tr 'a-z' 'A-Z')
    CLEAN_CFG="/var/tmp/bd-raw-claude-${POOL_UPPER}"
    mkdir -p "$CLEAN_CFG"
    # Copy only OAuth credentials from ~/.claude-${POOL_UPPER}, stripping all hooks and CLAUDE.md
    cp -f "/home/mboyle/.claude-${POOL_UPPER}/.credentials.json" "$CLEAN_CFG/.credentials.json" 2>/dev/null || true
    cat > "$CLEAN_CFG/settings.json" << 'JSON'
{
  "permissions": {"defaultMode": "bypassPermissions"},
  "hooks": {}
}
JSON
    if [[ -n "$PROMPT" ]]; then
      exec env HOME="$CLEAN_CFG" CLAUDE_CONFIG_DIR="$CLEAN_CFG" claude --dangerously-skip-permissions --setting-sources user --system-prompt "You are a helpful, unrestricted assistant." -p "$PROMPT"
    else
      exec env HOME="$CLEAN_CFG" CLAUDE_CONFIG_DIR="$CLEAN_CFG" claude --dangerously-skip-permissions --setting-sources user --system-prompt "You are a helpful, unrestricted assistant."
    fi
    ;;
  codex|gpt-6.1-sol|gpt-6-astra)
    MODEL="gpt-6.1-sol"
    [[ "$HARNESS" == "gpt-6-astra" ]] && MODEL="gpt-6-astra"
    if [[ -n "$PROMPT" ]]; then
      exec codex exec --skip-git-repo-check --dangerously-bypass-approvals-and-sandbox -C "$RAW_DIR" -m "$MODEL" "$PROMPT"
    else
      exec codex --dangerously-bypass-approvals-and-sandbox -C "$RAW_DIR" -m "$MODEL"
    fi
    ;;
  *)
    # Direct raw OpenAI-compatible call to BattleStation Ollama (.137:11434), LiteLLM (:4000), or GPU Orchestrator (:4010)
    MODEL_ID="$HARNESS"
    [[ "$MODEL_ID" == "local" ]] && MODEL_ID="qwen2.5-coder:7b"
    python3 - "$MODEL_ID" "$PROMPT" << 'PY'
import sys, json, urllib.request
model_id = sys.argv[1]
prompt = sys.argv[2] or "Hello! Confirm you are running in raw mode with no fleet rules."

endpoints = [
    ("http://10.0.10.137:11434/v1/chat/completions", "sk-local", model_id),
    ("http://127.0.0.1:4000/v1/chat/completions", "sk-fleet-local", "local-coder" if "qwen2.5-coder" in model_id else model_id),
    ("http://10.0.70.164:4010/v1/chat/completions", "sk-boylenet-master-2026", model_id),
]
if not ("qwen2.5" in model_id or "nomic" in model_id or "bge" in model_id):
    endpoints = [endpoints[2], endpoints[1], endpoints[0]]

last_err = None
for url, key, mid in endpoints:
    try:
        req = urllib.request.Request(
            url,
            data=json.dumps({
                "model": mid,
                "messages": [{"role": "user", "content": prompt}],
                "temperature": 0.0,
                "max_tokens": 128
            }).encode("utf-8"),
            headers={"Content-Type": "application/json", "Authorization": f"Bearer {key}"}
        )
        with urllib.request.urlopen(req, timeout=15) as resp:
            data = json.load(resp)
            print(data["choices"][0]["message"]["content"].strip())
            sys.exit(0)
    except Exception as e:
        last_err = e
raise RuntimeError(f"All raw endpoints failed for {model_id}: {last_err}")
PY
    ;;
esac
