        "cmd_turn": lambda sid, prompt: ["/usr/bin/env", "ACCOUNT_AUTOCOMPACT_WINDOW=150000", "BD_MAX_TURNS=20", "/home/mboyle/bin/bd-agy-lean-spawn", "--model", "claude-opus-4-6-thinking", "--conversation", sid, "-p", prompt],
