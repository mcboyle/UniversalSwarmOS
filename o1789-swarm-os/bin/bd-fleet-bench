        "cmd_turn": lambda sid, prompt: ["/usr/bin/env", "ACCOUNT_AUTOCOMPACT_WINDOW=150000", "BD_MAX_TURNS=20", "/home/mboyle/bin/bd-agy-lean-spawn", "--model", "gemini-3.1-pro-high", "--conversation", sid, "-p", prompt],
