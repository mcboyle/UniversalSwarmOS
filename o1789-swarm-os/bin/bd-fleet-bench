    ("Turn 18: Prometheus Health", "Check http://127.0.0.1:9090/-/healthy."),
    ("Turn 19: Static Linter Check", "Run ruff --version or check python-linter MCP."),
    ("Turn 20: State Persistence", "Record completion receipt for this session to RESUME_STATE.md.")
