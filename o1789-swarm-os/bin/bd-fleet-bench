PLATFORMS = {
    "kimi": {
        "display": "Kimi Code",
        "backend": "kimi",
        "model": "kimi-code/kimi-for-coding",
        "cmd_first": lambda sid, prompt: ["/usr/bin/env", "ACCOUNT_AUTOCOMPACT_WINDOW=150000", "BD_MAX_TURNS=20", "/home/mboyle/.kimi-code/bin/kimi", "-m", "kimi-code/kimi-for-coding", "-p", prompt],
        "cmd_turn": lambda sid, prompt: ["/usr/bin/env", "ACCOUNT_AUTOCOMPACT_WINDOW=150000", "BD_MAX_TURNS=20", "/home/mboyle/.kimi-code/bin/kimi", "-m", "kimi-code/kimi-for-coding", "-c", "-p", prompt],
    },
    "grok": {
        "display": "Grok Build",
        "backend": "grok",
        "model": "grok-4.7-build-fast",
        "cmd_first": lambda sid, prompt: ["/usr/bin/env", "ACCOUNT_AUTOCOMPACT_WINDOW=150000", "BD_MAX_TURNS=20", "/home/mboyle/.grok/bin/grok", "--model", "grok-4.7-build-fast", "-s", sid, "--permission-mode", "bypassPermissions", "-p", prompt],
        "cmd_turn": lambda sid, prompt: ["/usr/bin/env", "ACCOUNT_AUTOCOMPACT_WINDOW=150000", "BD_MAX_TURNS=20", "/home/mboyle/.grok/bin/grok", "--model", "grok-4.7-build-fast", "-r", sid, "--permission-mode", "bypassPermissions", "-p", prompt],
    },
    "agy-gemini-3-8-flash": {
        "display": "AGY (Gemini 3.8 Flash)",
