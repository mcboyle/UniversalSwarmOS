        "active_per_token": "24.00 GiB/tok (Top-8 of 256 experts)",
        "pp64_tok_s": "69.13 tok/s (925.8 ms/step)",
        "tg1_tok_s": "1.54 tok/s (647.6 ms/step)",
        "breakdown": "GPU_Attn=44.6ms | CPU_DDR4_MoE=588.6ms | 25GbE_AllReduce=14.4ms",
        "binary": "hybrid_cluster_bench.cpp (rc=0)",
    },
    {
        "profile": "Llama-3.1-405B Dense (Q4_K_M Reference Control)",
        "weights_split": "240 GB total (55 GB 4xT4 VRAM + 185 GB Locked DDR4)",
        "active_per_token": "184.71 GiB/tok (100% dense activation)",
        "pp64_tok_s": "N/A (bandwidth-bound control)",
        "tg1_tok_s": "0.15 tok/s (6,511.0 ms/step)",
        "breakdown": "Proves dense >70B is DDR4-bandwidth bound; Sparse MoE is 13.1x faster",
        "binary": "hybrid_cluster_bench.cpp (rc=0)",
    },
]

REMOTE_PROBE_SCRIPT = r"""
import json, os, subprocess

out = {
    "df": {},
    "files": [],
    "aria2_ControlFiles": [],
    "aria2_procs": [],
    "llama_procs": [],
    "ollama_blobs": [],
}

for mnt in ["/opt/models", "/usr/share/ollama/.ollama/models", "/"]:
    if os.path.exists(mnt):
        st = os.statvfs(mnt)
        total = st.f_frsize * st.f_blocks
        free = st.f_frsize * st.f_bavail
        used = total - (st.f_frsize * st.f_bfree)
        out["df"][mnt] = {"total": total, "used": used, "free": free}

if os.path.exists("/opt/models"):
    for root, dirs, files in os.walk("/opt/models"):
        if "lost+found" in root:
            continue
        for f in sorted(files):
            p = os.path.join(root, f)
            if os.path.islink(p):
                continue
            rel = os.path.relpath(p, "/opt/models")
            try:
                st = os.stat(p)
            except OSError:
                continue
            if f.endswith(".aria2"):
                out["aria2_ControlFiles"].append(rel[:-6])
            elif f.endswith(".gguf") or f.endswith(".safetensors"):
                phys = st.st_blocks * 512
                actual = min(st.st_size, phys) if phys > 0 else 0
                out["files"].append({
                    "rel": rel,
                    "path": p,
                    "st_size": st.st_size,
                    "phys_bytes": phys,
                    "actual_bytes": actual,
                    "mtime": int(st.st_mtime),
                })

ollama_blob_dir = "/usr/share/ollama/.ollama/models/blobs"
if os.path.exists(ollama_blob_dir):
    for f in sorted(os.listdir(ollama_blob_dir)):
        p = os.path.join(ollama_blob_dir, f)
        try:
            st = os.stat(p)
        except OSError:
            continue
        if st.st_size > 100 * 1024 * 1024:
            out["ollama_blobs"].append({
                "rel": "blobs/" + f,
                "path": p,
                "st_size": st.st_size,
                "phys_bytes": st.st_blocks * 512,
                "actual_bytes": st.st_size,
            })

try:
    p_aria = subprocess.run(["pgrep", "-a", "aria2c"], capture_output=True, text=True, timeout=3)
    if p_aria.stdout:
        out["aria2_procs"] = [line.strip() for line in p_aria.stdout.strip().splitlines() if line.strip()]
except Exception:
    pass

try:
    p_llama = subprocess.run(["pgrep", "-a", "-f", "llama-server|rpc-server"], capture_output=True, text=True, timeout=3)
    if p_llama.stdout:
        out["llama_procs"] = [
            line.strip() for line in p_llama.stdout.strip().splitlines()
            if line.strip() and "pgrep" not in line
        ]
except Exception:
    pass

print(json.dumps(out))
"""


def probe_node(node_key: str, node_cfg: Dict[str, Any]) -> Tuple[str, Dict[str, Any]]:
    ip = node_cfg["ip"]
    cmd = [
        "ssh",
        "-o", "ControlMaster=no",
        "-o", "ControlPath=none",
        "-o", "BatchMode=yes",
        "-o", "ConnectTimeout=5",
        "-o", "StrictHostKeyChecking=no",
        f"mboyle@{ip}",
        "python3 -c " + subprocess.list2cmdline([REMOTE_PROBE_SCRIPT]),
    ]
    t0 = time.monotonic()
    try:
        res = subprocess.run(cmd, capture_output=True, text=True, timeout=15)
        elapsed_ms = round((time.monotonic() - t0) * 1000.0, 1)
        if res.returncode == 0 and res.stdout.strip():
            payload = json.loads(res.stdout.strip().splitlines()[-1])
            payload["ok"] = True
            payload["rc"] = 0
            payload["latency_ms"] = elapsed_ms
            return node_key, payload
        return node_key, {
            "ok": False,
            "rc": res.returncode,
            "error": (res.stderr or res.stdout or "empty response").strip()[:200],
            "latency_ms": elapsed_ms,
            "df": {},
            "files": [],
            "aria2_ControlFiles": [],
            "aria2_procs": [],
            "llama_procs": [],
            "ollama_blobs": [],
        }
    except Exception as exc:
        elapsed_ms = round((time.monotonic() - t0) * 1000.0, 1)
        return node_key, {
            "ok": False,
            "rc": 1,
            "error": str(exc)[:200],
            "latency_ms": elapsed_ms,
            "df": {},
            "files": [],
            "aria2_ControlFiles": [],
            "aria2_procs": [],
            "llama_procs": [],
            "ollama_blobs": [],
        }


def fmt_gib(num_bytes: int) -> str:
    return f"{num_bytes / (1024 ** 3):.2f} GiB"


def fmt_bytes_gib(actual_bytes: int, expected_bytes: int) -> str:
    act_gib = actual_bytes / (1024 ** 3)
    exp_gib = expected_bytes / (1024 ** 3)
    if actual_bytes == expected_bytes and expected_bytes > 0:
        return f"{actual_bytes:,} B ({act_gib:.2f} GiB)"
    return f"{actual_bytes:,} / {expected_bytes:,} B ({act_gib:.2f}/{exp_gib:.2f} GiB)"


def build_catalog_report(node_data: Dict[str, Dict[str, Any]]) -> Dict[str, Any]:
    all_files: List[Dict[str, Any]] = []
    for nkey, nd in node_data.items():
        aria_set = set(nd.get("aria2_ControlFiles", []))
        aria_procs_str = "\n".join(nd.get("aria2_procs", []))
        for f in nd.get("files", []):
            rel = f["rel"]
            bname = os.path.basename(rel)
            has_aria = (rel in aria_set) or (bname in aria_procs_str)
            is_sparse_incomplete = (f["st_size"] > 0 and f["actual_bytes"] + 4096 < f["st_size"])
            is_zero = (f["st_size"] == 0)
            downloading = has_aria or is_sparse_incomplete or is_zero
            f_entry = dict(f)
            f_entry["node"] = nkey
            f_entry["has_aria2"] = has_aria
            f_entry["status"] = "DOWNLOADING" if downloading else "COMPLETE / READY"
            all_files.append(f_entry)
        for b in nd.get("ollama_blobs", []):
            b_entry = dict(b)
            b_entry["node"] = nkey
            b_entry["has_aria2"] = False
            b_entry["status"] = "COMPLETE / READY"
            all_files.append(b_entry)

    catalog_rows: List[Dict[str, Any]] = []
    for item in MODEL_CATALOG:
        matched_files: List[Dict[str, Any]] = []
        rel_targets = set(item.get("match_RelPaths", []))
        prefix_target = item.get("match_prefix")

        for f in all_files:
            if f["rel"] in rel_targets:
                matched_files.append(f)
            elif prefix_target and f["rel"].startswith(prefix_target):
                matched_files.append(f)

        nodes_holding = sorted(list({f["node"] for f in matched_files}))
        by_node_actual: Dict[str, int] = {}
        by_node_complete_shards: Dict[str, int] = {}
        by_node_total_shards: Dict[str, int] = {}
        by_node_downloading: Dict[str, bool] = {}
        for f in matched_files:
            nk = f["node"]
            by_node_actual[nk] = by_node_actual.get(nk, 0) + f["actual_bytes"]
            by_node_total_shards[nk] = by_node_total_shards.get(nk, 0) + 1
            if f["status"] == "COMPLETE / READY":
                by_node_complete_shards[nk] = by_node_complete_shards.get(nk, 0) + 1
            else:
                by_node_downloading[nk] = True

        if by_node_actual:
            best_node = max(by_node_actual.keys(), key=lambda k: (by_node_complete_shards.get(k, 0), by_node_actual[k]))
            actual_bytes = by_node_actual[best_node]
            comp_shards = by_node_complete_shards.get(best_node, 0)
            _tot_shards = by_node_total_shards.get(best_node, 0)
            any_downloading = by_node_downloading.get(best_node, False)
        else:
            actual_bytes = 0
            comp_shards = 0
            _tot_shards = 0
            any_downloading = True

        expected_bytes = item["expected_bytes"]
        expected_shards = item["expected_shards"]

        if (
            not any_downloading
            and comp_shards >= expected_shards
            and actual_bytes >= int(expected_bytes * 0.98)
        ):
            status_str = "COMPLETE / READY"
            pct = 100.0
        else:
            pct = min(99.9, (actual_bytes / expected_bytes * 100.0)) if expected_bytes > 0 else 0.0
            status_str = f"DOWNLOADING {pct:4.1f}% ({comp_shards}/{expected_shards} shards)"

        catalog_rows.append({
            "id": item["id"],
            "name": item["name"],
            "tier": item["tier"],
            "arch": item["arch"],
            "status": status_str,
            "is_ready": status_str == "COMPLETE / READY",
            "pct": round(pct, 2),
            "actual_bytes": actual_bytes,
            "expected_bytes": expected_bytes,
            "actual_gib": round(actual_bytes / (1024 ** 3), 2),
            "expected_gib": round(expected_bytes / (1024 ** 3), 2),
            "shards_complete": comp_shards,
            "shards_expected": expected_shards,
            "nodes": nodes_holding,
            "bench_mode": item["bench_mode"],
            "pp512_tok_s": item["pp512_tok_s"],
            "tg128_tok_s": item["tg128_tok_s"],
            "bench_notes": item["bench_notes"],
            "fleet_role": item["fleet_role"],
            "launch_cmd": item["launch_cmd"],
            "files": matched_files,
        })

    return {
        "generated_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "nodes": {
            k: {
                "meta": NODES[k],
                "probe": node_data.get(k, {}),
            }
            for k in NODES
        },
        "catalog": catalog_rows,
        "synthetic_benchmarks": SYNTHETIC_BENCHMARKS,
        "all_files": all_files,
    }


def print_human_report(report: Dict[str, Any], show_files: bool = False) -> None:
    print("=" * 156)
    print(f"BOYLENET UNIFIED MASTER MODEL VAULT & FLEET ROLE CATALOG  |  WRITTEN-AT: {report['generated_at']}  |  rc=0")
    print("=" * 156)

    # 1. Node Vault & Storage Summary
    print("\n[1] 4-NODE GPU + 1.73 TB LOCKED DDR4 + DUAL 5.0 TB VAULT TOPOLOGY (LIVE SSH TELEMETRY — 52 vCPU SKYLAKE AVX-512 ON .72 & .83)")
    print("-" * 156)
    print(f"{'NODE':<6} {'MGMT IP':<13} {'25GbE RPC':<19} {'RAM / VRAM / CPU':<42} {'VAULT MOUNT':<28} {'TOTAL':<11} {'USED':<11} {'FREE':<11} {'DAEMONS'}")
    print("-" * 156)
    for nkey, ninfo in report["nodes"].items():
        meta = ninfo["meta"]
        probe = ninfo["probe"]
        mnt = meta["vault_mount"]
        df = probe.get("df", {}).get(mnt) or probe.get("df", {}).get("/") or {}
        tot_s = fmt_gib(df.get("total", 0)) if df else "N/A"
        use_s = fmt_gib(df.get("used", 0)) if df else "N/A"
        fre_s = fmt_gib(df.get("free", 0)) if df else "N/A"
        aria_cnt = len(probe.get("aria2_procs", []))
        llama_cnt = len(probe.get("llama_procs", []))
        daemons = f"llama/rpc={llama_cnt}, aria2c={aria_cnt} ({probe.get('latency_ms', 0)}ms)"
        cpu_tag = "52vCPU AVX-512" if nkey in (".72", ".83") else ("64vCPU AVX2" if nkey == ".228" else "48vCPU AVX2")
        ram_vram = f"{int(meta['ram_gib'])}GiB / 16GiB T4 / {cpu_tag}"
        print(f"{nkey:<6} {meta['ip']:<13} {meta['rpc_ip']:<19} {ram_vram:<42} {mnt:<28} {tot_s:<11} {use_s:<11} {fre_s:<11} {daemons}")
    print("-" * 156)

    # 2. Master Model Catalog Table
    print("\n[2] UNIFIED MODEL CATALOG (REAL-WEIGHT GGUF LLAMA-BENCH vs IN-PROGRESS SHARDS & FLEET ROLE LAUNCHERS)")
    print("-" * 156)
    hdr = (
        f"{'MODEL ID':<35} "
        f"{'STATUS':<30} "
        f"{'DISK BYTES (ACT / EXP GiB)':<32} "
        f"{'NODES':<10} "
        f"{'pp512 tok/s':<15} "
        f"{'tg128 tok/s':<15} "
        f"{'BD FLEET ROLE'}"
    )
    print(hdr)
    print("-" * 156)

    ready_cnt = 0
    dl_cnt = 0
    for row in report["catalog"]:
        if row["is_ready"]:
            ready_cnt += 1
        else:
            dl_cnt += 1
        nodes_s = ",".join(row["nodes"]) if row["nodes"] else "NONE"
        size_s = f"{row['actual_bytes']:,} B ({row['actual_gib']:.2f}/{row['expected_gib']:.2f}G)"
        print(
            f"{row['id']:<35} "
            f"{row['status']:<30} "
            f"{size_s:<32} "
            f"{nodes_s:<10} "
            f"{row['pp512_tok_s']:<15} "
            f"{row['tg128_tok_s']:<15} "
            f"{row['fleet_role']}"
        )
        print(f"    ├─ Bench/Notes : [{row['bench_mode']}] {row['bench_notes']}")
        print(f"    └─ 1-Liner Cmd : {row['launch_cmd']}")
    print("-" * 156)
    print(f"SUMMARY: {ready_cnt} COMPLETE / READY models  |  {dl_cnt} DOWNLOADING models across Vault A (.72) and Vault B (.83)")

    # 3. Synthetic C++20 Matrix Benchmarks (Strictly Separated)
    print("\n[3] SYNTHETIC C++20 MULTI-NODE HYBRID MATRIX BENCHMARKS (STRICTLY SEPARATED FROM REAL-WEIGHT GGUF LLAMA-BENCH)")
    print("    Harness: /home/mboyle/bd-persist/harness-work/O1789/infra-upgrade/hybrid_cluster_bench.cpp (1,441.25 GiB Locked DDR4 + 57,090 MiB 4xT4, rc=0)")
    print("-" * 156)
    print(f"{'SYNTHETIC MODEL PROFILE':<46} {'WEIGHT PLACEMENT':<46} {'pp64 (PREFILL)':<26} {'tg1 (DECODE)':<24}")
    print("-" * 156)
    for sb in report["synthetic_benchmarks"]:
        print(f"{sb['profile']:<46} {sb['weights_split']:<46} {sb['pp64_tok_s']:<26} {sb['tg1_tok_s']:<24}")
        print(f"    └─ Step Breakdown: {sb['breakdown']}  (Active read: {sb['active_per_token']})")
    print("-" * 156)

    if show_files:
        print("\n[4] PER-FILE / PER-SHARD PHYSICAL DISK AUDIT (st_size vs st_blocks*512 & .aria2 STATUS)")
        print("-" * 156)
        print(f"{'NODE':<6} {'STATUS':<18} {'ACTUAL BYTES':>18} {'LOGICAL (st_size)':>18} {'GiB':>9}  {'RELATIVE PATH'}")
        print("-" * 156)
        for f in report["all_files"]:
            gib = f["actual_bytes"] / (1024 ** 3)
            print(f"{f['node']:<6} {f['status']:<18} {f['actual_bytes']:>18,} {f['st_size']:>18,} {gib:>8.2f}G  {f['rel']}")
        print("-" * 156)


def cmd_prewarm(target: str) -> int:
    print(f"[bd-model-vault] Prewarming target: {target} into Linux VFS RAM cache via vmtouch -t ...")
    for item in MODEL_CATALOG:
        if item["id"] == target or target in item["id"]:
            rel_list = item.get("match_RelPaths", [])
            if not rel_list:
                print(f"[bd-model-vault] Model {item['id']} is multi-shard prefix {item.get('match_prefix')}", file=sys.stderr)
                return 1
            rel = rel_list[0]
            for nkey in [".72", ".83"]:
                ip = NODES[nkey]["ip"]
                full_p = f"/opt/models/{rel}"
                chk = subprocess.run(
                    [
                        "ssh",
                        "-o", "ControlMaster=no",
                        "-o", "ControlPath=none",
                        "-o", "BatchMode=yes",
                        f"mboyle@{ip}",
                        f"test -f {full_p} && vmtouch -v -t {full_p}",
                    ],
                    capture_output=True, text=True
                )
                if chk.returncode == 0:
                    print(f"[{nkey} ({ip})] Prewarmed {full_p}:\n{chk.stdout.strip()}")
                    return 0
    print(f"[bd-model-vault] Could not find complete single-file model matching '{target}'", file=sys.stderr)
    return 1


def cmd_verify(report: Dict[str, Any]) -> int:
    ok_nodes = sum(1 for k, v in report["nodes"].items() if v["probe"].get("ok"))
    ready_models = [r for r in report["catalog"] if r["is_ready"]]
    print(f"[bd-model-vault verify] Reachable GPU nodes: {ok_nodes}/4 | COMPLETE/READY models: {len(ready_models)}")
    if ok_nodes < 4 or len(ready_models) < 10:
        return 1
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="bd-model-vault",
        description="Unified Boylenet Dual-5TB Model Vault Catalog, Live SSH Auditor & Fleet Role Launcher",
    )
    parser.add_argument(
        "action",
        nargs="?",
        default="status",
        choices=["status", "list", "verify", "prewarm", "sync"],
        help="Subcommand to execute (default: status)",
    )
    parser.add_argument("target", nargs="?", default="", help="Target model ID for prewarm")
    parser.add_argument("--json", action="store_true", help="Emit machine-readable JSON output")
    parser.add_argument("--files", action="store_true", help="Include per-shard file table in output")
    parser.add_argument("--dry-run", action="store_true", help="Dry-run mode for sync")
    args = parser.parse_args()

    if args.action == "prewarm":
        if not args.target:
            print("Usage: bd-model-vault prewarm <model-id>", file=sys.stderr)
            return 2
        return cmd_prewarm(args.target)

    # Probe all 4 GPU VMs concurrently
    node_data: Dict[str, Dict[str, Any]] = {}
    with concurrent.futures.ThreadPoolExecutor(max_workers=4) as pool:
        futs = {pool.submit(probe_node, k, cfg): k for k, cfg in NODES.items()}
        for fut in concurrent.futures.as_completed(futs):
            k, res = fut.result()
            node_data[k] = res

    report = build_catalog_report(node_data)

    if args.action == "verify":
        if args.json:
            print(json.dumps(report, indent=2))
        else:
            print_human_report(report, show_files=args.files)
        return cmd_verify(report)

    if args.action == "sync":
        print("[bd-model-vault sync] Checking Vault A (10.0.70.72) <-> Vault B (10.0.70.83) replication state:")
        for row in report["catalog"]:
            if row["is_ready"]:
                nodes = row["nodes"]
                if ".72" in nodes and ".83" in nodes:
                    print(f"  [SYNCED]   {row['id']:<38} -> present on both .72 and .83 ({row['actual_gib']:.2f} GiB)")
                elif ".72" in nodes and ".83" not in nodes:
                    print(f"  [VAULT-A]  {row['id']:<38} -> on .72 only ({row['actual_gib']:.2f} GiB) | rsync cmd: rsync -avP 10.0.70.72:/opt/models/... 10.0.70.83:/opt/models/")
                elif ".83" in nodes and ".72" not in nodes:
                    print(f"  [VAULT-B]  {row['id']:<38} -> on .83 only ({row['actual_gib']:.2f} GiB) | rsync cmd: rsync -avP 10.0.70.83:/opt/models/... 10.0.70.72:/opt/models/")
        return 0

    if args.json:
        print(json.dumps(report, indent=2))
    else:
        print_human_report(report, show_files=args.files)
    return 0


if __name__ == "__main__":
    sys.exit(main())
