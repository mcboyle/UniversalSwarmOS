#!/usr/bin/env python3
"""
bd-speculative-patch: Deterministic Speculative Code Editing for LLM Agents.
Treats the existing file on disk as a deterministic draft.
Applies localized search-and-replace or unified hunk patches with atomic write,
instant AST/syntax verification, and automatic rollback on failure.
"""

import sys
import os
import argparse
import subprocess
import shutil
import stat
import tempfile

def verify_syntax(file_path: str, source: str) -> tuple:
    """Verify syntax of source destined for file_path, in-process (F5: no temp-path suffix test,
    no __pycache__ write). Returns (ok: bool, err_msg: str)."""
    if not file_path.endswith(".py"):
        return True, ""
    try:
        compile(source, file_path, "exec")
        return True, ""
    except (SyntaxError, ValueError) as e:
        return False, str(e)

def verify_ruff(file_path: str) -> tuple:
    """Run ruff check if available. Returns (ok: bool, err_msg: str)."""
    if not file_path.endswith(".py"):
        return True, ""
    ruff_bin = shutil.which("ruff")
    if not ruff_bin:
        # Check standard virtualenv paths
        for candidate in ["/home/mboyle/BulkDownloader/venv/bin/ruff", "/home/mboyle/.local/bin/ruff"]:
            if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
                ruff_bin = candidate
                break
    if not ruff_bin:
        return True, ""

    try:
        res = subprocess.run([ruff_bin, "check", "--no-fix", "--no-cache", file_path], capture_output=True, text=True)
        if res.returncode == 0:
            return True, ""
        return False, res.stdout.strip() + "\n" + res.stderr.strip()
    except Exception:
        return True, ""  # Don't hard-fail if ruff execution fails

def _write_atomic(target_file: str, data: bytes, mode: int) -> None:
    """Write data to target_file via a temp file in its directory + os.replace, the temp file
    chmod-ed to mode first. A rename needs only directory write permission, so this also
    restores a 0444 target (R1), and bytes and mode come back in one step."""
    tmp_path = None
    try:
        with tempfile.NamedTemporaryFile("wb", dir=os.path.dirname(target_file), delete=False) as tf:
            tmp_path = tf.name
            tf.write(data)
        os.chmod(tmp_path, mode)
        os.replace(tmp_path, target_file)
        tmp_path = None
    finally:
        if tmp_path and os.path.exists(tmp_path):
            os.remove(tmp_path)

def apply_block_replace(target_file: str, search_str: str, replace_str: str, allow_multiple: bool = False) -> None:
    if not os.path.isfile(target_file):
        print(f"ERROR: target file not found: {target_file}", file=sys.stderr)
        sys.exit(1)

    # F9: edit the symlink's target, never replace the link itself
    target_file = os.path.realpath(target_file)
    # F15/F16: bytes in, bytes out; no newline translation, so CRLF survives
    with open(target_file, "rb") as f:
        orig_bytes = f.read()
    content = orig_bytes.decode("utf-8")

    count = content.count(search_str)
    if count == 0:
        print(f"ERROR: search string not found in {target_file}", file=sys.stderr)
        sys.exit(2)
    if count > 1 and not allow_multiple:
        print(f"ERROR: search string occurs {count} times (must be unique). Use --allow-multiple to replace all.", file=sys.stderr)
        sys.exit(3)

    # Backup original content
    orig_content = content
    new_content = content.replace(search_str, replace_str, -1 if allow_multiple else 1)

    # Syntax check before anything is written (F5)
    ok_syntax, err = verify_syntax(target_file, new_content)
    if not ok_syntax:
        print(f"ERROR: syntax error in modified code:\n{err}", file=sys.stderr)
        sys.exit(4)
    try:
        new_bytes = new_content.encode("utf-8")
    except UnicodeEncodeError as e:
        # F10: refuse before a temp file exists
        print(f"ERROR: replacement is not encodable as UTF-8: {e}", file=sys.stderr)
        sys.exit(6)

    # F4: keep the original file mode across os.replace; R1: rollback uses the same mode
    orig_mode = stat.S_IMODE(os.stat(target_file).st_mode)
    replaced = False
    try:
        # Atomic replace
        _write_atomic(target_file, new_bytes, orig_mode)
        replaced = True

        # Post-replace ruff check
        ok_ruff, ruff_err = verify_ruff(target_file)
        if not ok_ruff:
            # Rollback (R1: temp + rename, never open(target, "wb"): a 0444 target is not writable)
            _write_atomic(target_file, orig_bytes, orig_mode)
            print(f"ERROR: ruff lint failed, rolled back to original:\n{ruff_err}", file=sys.stderr)
            sys.exit(5)

        delta_bytes = len(new_content) - len(orig_content)
        sign = "+" if delta_bytes >= 0 else ""
        print(f"[SPECULATIVE-PATCH] OK {target_file} (bytes: {sign}{delta_bytes})")

    except Exception as e:
        # Restore original only if the target was replaced; a failed restore raises, never reports success
        if replaced:
            _write_atomic(target_file, orig_bytes, orig_mode)
        print(f"ERROR: exception during patch application: {e}", file=sys.stderr)
        sys.exit(6)

def main():
    parser = argparse.ArgumentParser(description="Deterministic Speculative Code Editing")
    parser.add_argument("target", help="Target file path")
    parser.add_argument("--search", required=True, help="Exact code block to find")
    parser.add_argument("--replace", required=True, help="Replacement code block")
    parser.add_argument("--allow-multiple", action="store_true", help="Allow multiple occurrences")
    args = parser.parse_args()

    apply_block_replace(args.target, args.search, args.replace, args.allow_multiple)

if __name__ == "__main__":
    main()
