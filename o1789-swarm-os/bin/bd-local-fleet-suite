#!/usr/bin/env bash
# bd-local-fleet-suite — Master CLI Index & Executability Verifier for bd-local-* and bd-*-local tools
# Usage: bd-local-fleet-suite [--json] [--check-only] [--help]

set -eo pipefail

BIN_DIR="${BD_BIN_DIR:-/home/mboyle/bin}"
MODE="text"

for arg in "$@"; do
  case "$arg" in
    --json) MODE="json" ;;
    --check-only) MODE="check" ;;
    -h|--help)
      echo "Usage: bd-local-fleet-suite [--json] [--check-only] [--help]"
      echo "Lists, verifies executable permissions (-x), and prints usage examples for all bd-local-* and bd-*-local CLI tools in /home/mboyle/bin/."
      exit 0
      ;;
  esac
done

shopt -s nullglob
declare -A seen
tools=()
for f in "$BIN_DIR"/bd-local-* "$BIN_DIR"/bd-*-local; do
  [[ -f "$f" ]] || continue
  base="$(basename "$f")"
  if [[ -z "${seen[$base]:-}" ]]; then
    seen[$base]=1
    tools+=("$f")
  fi
done

IFS=$'\n' sorted_tools=($(printf '%s\n' "${tools[@]}" | sort))
unset IFS

total="${#sorted_tools[@]}"
pass_count=0
fail_count=0

extract_usage() {
  local file="$1"
  local name
  name="$(basename "$file")"
  local usage_line=""
  usage_line="$(grep -m1 -E '^#[[:space:]]*(Usage|USAGE|Example):' "$file" 2>/dev/null | sed -E 's/^#[[:space:]]*(Usage|USAGE|Example):[[:space:]]*//' || true)"
  if [[ -z "$usage_line" ]]; then
    usage_line="$name --help"
  fi
  printf '%s' "$usage_line"
}

if [[ "$MODE" == "json" ]]; then
  printf '{"bin_dir":"%s","total":%d,"tools":[' "$BIN_DIR" "$total"
fi

if [[ "$MODE" == "text" ]]; then
  echo "================================================================================"
  echo " BD-LOCAL FLEET SUITE — MASTER CLI INDEX ($BIN_DIR)"
  echo "================================================================================"
  printf "%-36s | %-6s | %s\n" "TOOL" "EXEC" "USAGE EXAMPLE"
  echo "--------------------------------------------------------------------------------"
fi

idx=0
for tool in "${sorted_tools[@]}"; do
  name="$(basename "$tool")"
  if [[ -x "$tool" ]]; then
    exec_ok="PASS"
    pass_count=$((pass_count + 1))
  else
    exec_ok="FAIL"
    fail_count=$((fail_count + 1))
  fi
  usage_ex="$(extract_usage "$tool")"

  if [[ "$MODE" == "text" ]]; then
    printf "%-36s | %-6s | %s\n" "$name" "$exec_ok" "$usage_ex"
  elif [[ "$MODE" == "json" ]]; then
    [[ $idx -gt 0 ]] && printf ','
    esc_usage="${usage_ex//\"/\\\"}"
    printf '{"name":"%s","path":"%s","executable":%s,"status":"%s","usage":"%s"}' \
      "$name" "$tool" "$([[ "$exec_ok" == "PASS" ]] && echo true || echo false)" "$exec_ok" "$esc_usage"
  fi
  idx=$((idx + 1))
done

if [[ "$MODE" == "text" ]]; then
  echo "--------------------------------------------------------------------------------"
  echo "SUMMARY: FOUND $total tools | EXECUTABLE (-x): $pass_count/$total PASS | FAIL: $fail_count"
elif [[ "$MODE" == "json" ]]; then
  printf '],"pass":%d,"fail":%d,"status":"%s"}\n' "$pass_count" "$fail_count" "$([[ $fail_count -eq 0 ]] && echo PASS || echo FAIL)"
elif [[ "$MODE" == "check" ]]; then
  echo "FOUND $total | PASS $pass_count | FAIL $fail_count"
fi

[[ $fail_count -eq 0 ]]
