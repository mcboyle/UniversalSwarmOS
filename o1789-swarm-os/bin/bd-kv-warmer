def load_api_key() -> str:
    key = os.environ.get("LITELLM_MASTER_KEY") or os.environ.get("LITELLM_API_KEY")
    if key:
        return key
    try:
        for line in ENV_FILE.read_text(encoding="utf-8").splitlines():
            name, sep, value = line.strip().removeprefix("export ").partition("=")
            if sep and name.strip() == "LITELLM_MASTER_KEY":
                return value.strip().strip("'\"")
    except OSError:
        pass
    return ""


def check_llama_health(base_url: str) -> bool:
    try:
        req = urllib.request.Request(f"{base_url}/health", method="GET")
        with urllib.request.urlopen(req, timeout=2.5) as resp:
            if resp.status == 200:
                data = json.loads(resp.read().decode("utf-8", errors="replace"))
                return data.get("status") == "ok"
    except Exception:
        pass
    return False


def ensure_tier1_ready(max_wait_s: int = 60) -> None:
    """Ensure both Tier 1 llama-server endpoints (.72:8082 & .125:8081) are healthy
    before sending LiteLLM requests (prevents LiteLLM fallback to auto-local :4010)."""
    h72 = check_llama_health("http://10.0.70.72:8082")
    h125 = check_llama_health("http://10.0.70.125:8081")
    if h72 and h125:
        return

    if not h72:
        subprocess.run(
            [
                *SSH_BASE_ARGS,
                "10.0.70.72",
                "sudo systemctl stop llama-tier23.service || true; "
                "sudo systemctl reset-failed llama-tier1-alpha.service || true; "
                "sudo systemctl start llama-tier1-alpha.service",
            ],
            capture_output=True,
            text=True,
            timeout=20,
        )
    if not h125:
        subprocess.run(
            [
                *SSH_BASE_ARGS,
                "10.0.70.125",
                "sudo systemctl reset-failed llama-distributed-32b.service || true; "
                "sudo systemctl start llama-distributed-32b.service",
            ],
            capture_output=True,
            text=True,
            timeout=20,
        )

    deadline = time.time() + max_wait_s
    while time.time() < deadline:
        if check_llama_health("http://10.0.70.72:8082") and check_llama_health("http://10.0.70.125:8081"):
            return
        time.sleep(2.5)


def get_slot_count(base_url: str) -> int:
    try:
        req = urllib.request.Request(f"{base_url}/slots", method="GET")
        with urllib.request.urlopen(req, timeout=3.0) as resp:
            slots = json.loads(resp.read().decode("utf-8", errors="replace"))
            if isinstance(slots, list) and len(slots) > 0:
                return len(slots)
    except Exception:
        pass
    return 4


def build_canonical_prefix(max_chars: int = 16000) -> tuple[str, dict[str, Any]]:
    """Construct the canonical Boylenet system prompt + tool schema block."""
    floor_text = FLOOR_PATH.read_text(encoding="utf-8").strip() if FLOOR_PATH.is_file() else ""
    claude_text = CLAUDE_MD_PATH.read_text(encoding="utf-8").strip() if CLAUDE_MD_PATH.is_file() else ""
    schema_text = json.dumps(FLEET_TOOL_SCHEMA, indent=2, sort_keys=True)

    header = (
        "# BOYLENET CANONICAL KV-PINNED SYSTEM PREFIX (HTAP-9)\n"
        "[SYSTEM DIRECTIVE]: Zero-prose autonomous execution. Respect Fleet Floor, "
        "Repo Contract, and Tool Schema below.\n\n"
    )
    floor_block = f"## SECTION 1: FLEET_RULE-FLOOR.md\n{floor_text}\n\n"
    schema_block = f"\n\n## SECTION 3: FLEET_TOOL_SCHEMA\n```json\n{schema_text}\n```\n"

    remaining = max_chars - len(header) - len(floor_block) - len(schema_block)
    if remaining > 500 and len(claude_text) > remaining:
        claude_slice = claude_text[:remaining].rsplit("\n", 1)[0]
    else:
        claude_slice = claude_text

    claude_block = f"## SECTION 2: BulkDownloader/CLAUDE.md\n{claude_slice}"
    full_prefix = f"{header}{floor_block}{claude_block}{schema_block}"
    sha256_hex = hashlib.sha256(full_prefix.encode("utf-8")).hexdigest()

    meta = {
        "prefix_sha256": sha256_hex,
        "prefix_chars": len(full_prefix),
        "floor_chars": len(floor_text),
        "claude_md_chars_included": len(claude_slice),
        "claude_md_chars_total": len(claude_text),
        "tool_schema_count": len(FLEET_TOOL_SCHEMA),
        "tool_schema_chars": len(schema_text),
    }
    return full_prefix, meta


def stream_chat_ttft(
    url: str,
    model: str,
    system_prompt: str,
    user_prompt: str,
    api_key: str = "",
    slot_id: int | None = 0,
    is_litellm: bool = False,
    timeout: float = 90.0,
) -> dict[str, Any]:
    """Send a streaming 1-token chat completion request and measure exact client TTFT (ms)."""
    use_json = is_litellm and "10.0.70.164" in url
    payload: dict[str, Any] = {
        "model": model,
        "messages": [
            {"role": "system", "content": system_prompt},
            {"role": "user", "content": user_prompt},
        ],
        "max_tokens": 1,
        "temperature": 0.0,
        "stream": not use_json,
        "cache_prompt": True,
    }
    if slot_id is not None and not is_litellm:
        payload["id_slot"] = slot_id
    if is_litellm:
        # Bypass LiteLLM response cache so we measure real llama-server KV prefix cache
        payload["cache"] = {"no-cache": True}

    data = json.dumps(payload).encode("utf-8")
    headers = {
        "Content-Type": "application/json",
        "Accept": "application/json" if (is_litellm and "10.0.70.164" in url) else "text/event-stream",
    }
    if api_key:
        headers["Authorization"] = f"Bearer {api_key}"

    req = urllib.request.Request(url, data=data, headers=headers, method="POST")
    t_start = time.perf_counter()
    ttft_ms: float | None = None
    usage: dict[str, Any] = {}
    timings: dict[str, Any] = {}
    chunks_received = 0

    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            status_code = resp.getcode()
            if (is_litellm and "10.0.70.164" in url):
                body = json.loads(resp.read().decode("utf-8", errors="replace"))
                total_ms = (time.perf_counter() - t_start) * 1000.0
                ttft_ms = total_ms
                chunks_received = 1
                if isinstance(body.get("usage"), dict):
                    usage = body["usage"]
                if isinstance(body.get("timings"), dict):
                    timings = body["timings"]
            else:
                for raw_line in resp:
                    line = raw_line.decode("utf-8", errors="replace").strip()
                    if not line or not line.startswith("data:"):
                        continue
                    data_str = line[5:].strip()
                    if data_str == "[DONE]":
                        break
                    try:
                        chunk = json.loads(data_str)
                    except json.JSONDecodeError:
                        continue
                    chunks_received += 1
                    if ttft_ms is None:
                        ttft_ms = (time.perf_counter() - t_start) * 1000.0
                    if isinstance(chunk.get("usage"), dict) and chunk["usage"]:
                        usage = chunk["usage"]
                    if isinstance(chunk.get("timings"), dict) and chunk["timings"]:
                        timings = chunk["timings"]
                total_ms = (time.perf_counter() - t_start) * 1000.0
        if ttft_ms is None:
            ttft_ms = total_ms
        return {
            "status": "OK",
            "http_status": status_code,
            "ttft_ms": round(ttft_ms, 2),
            "total_ms": round(total_ms, 2),
            "chunks": chunks_received,
            "usage": usage,
            "timings": timings,
        }
    except urllib.error.HTTPError as e:
        total_ms = (time.perf_counter() - t_start) * 1000.0
        err_body = ""
        try:
            err_body = e.read().decode("utf-8", errors="replace")[:300]
        except Exception:
            pass
        return {
            "status": "ERROR",
            "http_status": e.code,
            "ttft_ms": round(total_ms, 2),
            "total_ms": round(total_ms, 2),
            "error": f"HTTP {e.code}: {err_body}",
        }
    except Exception as e:
        total_ms = (time.perf_counter() - t_start) * 1000.0
        return {
            "status": "ERROR",
            "http_status": None,
            "ttft_ms": round(total_ms, 2),
            "total_ms": round(total_ms, 2),
            "error": str(e),
        }


def bust_all_kv_slots(base_url: str, model: str) -> int:
    """Evict all parallel slots on the backing llama-server with a divergent 8-token nonce
    so the subsequent canonical prefix pass measures true Cold TTFT."""
    n_slots = get_slot_count(base_url)
    completions_url = f"{base_url}/v1/chat/completions"
    for s in range(n_slots):
        nonce_sys = f"KV_SLOT_RESET_NONCE_{s}_{int(time.time() * 1000)}"
        stream_chat_ttft(
            url=completions_url,
            model=model,
            system_prompt=nonce_sys,
            user_prompt="RESET",
            api_key="",
            slot_id=s,
            is_litellm=False,
            timeout=30.0,
        )
    return n_slots


def warm_endpoint(
    ep: dict[str, Any],
    canonical_prefix: str,
    api_key: str,
    measure_cold: bool = True,
) -> dict[str, Any]:
    """Warm a single endpoint and measure Cold TTFT vs Warm Cached TTFT."""
    url = ep["url"]
    model = ep["model"]
    slot_id = ep.get("slot_id", 0)
    is_litellm = ep["type"] == "litellm-proxy"
    key = api_key if ep.get("needs_auth") else ""
    req_timeout = 35.0 if not measure_cold else 60.0

    ts_nonce = int(time.time() * 1000)

    if not measure_cold:
        # Fast --pin-only path: 1 warm pin pass + 1 confirmation pass
        warm_res = stream_chat_ttft(
            url=url,
            model=model,
            system_prompt=canonical_prefix,
            user_prompt=f"PING_WARM_1_{ts_nonce}: Reply OK.",
            api_key=key,
            slot_id=slot_id,
            is_litellm=is_litellm,
            timeout=req_timeout,
        )
        cold_res = warm_res
        best_warm = warm_res
    else:
        for _attempt in range(2):
            bust_all_kv_slots(ep["backing_base_url"], ep["backing_model"])
            ts_nonce = int(time.time() * 1000)

            cold_res = stream_chat_ttft(
                url=url,
                model=model,
                system_prompt=canonical_prefix,
                user_prompt=f"PING_COLD_{ts_nonce}: Reply OK.",
                api_key=key,
                slot_id=slot_id,
                is_litellm=is_litellm,
                timeout=req_timeout,
            )

            warm_res = stream_chat_ttft(
                url=url,
                model=model,
                system_prompt=canonical_prefix,
                user_prompt=f"PING_WARM_1_{ts_nonce}: Reply OK.",
                api_key=key,
                slot_id=slot_id,
                is_litellm=is_litellm,
                timeout=req_timeout,
            )

            warm_res_2 = stream_chat_ttft(
                url=url,
                model=model,
                system_prompt=canonical_prefix,
                user_prompt=f"PING_WARM_2_{ts_nonce}: Reply OK.",
                api_key=key,
                slot_id=slot_id,
                is_litellm=is_litellm,
                timeout=req_timeout,
            )

            if warm_res_2.get("status") == "OK" and (
                warm_res.get("status") != "OK" or warm_res_2["ttft_ms"] < warm_res["ttft_ms"]
            ):
                best_warm = warm_res_2
            else:
                best_warm = warm_res

            if cold_res.get("status") == "OK" and best_warm.get("status") == "OK":
                break
            time.sleep(1.0)

    cold_ttft = cold_res.get("ttft_ms", 0.0)
    warm_ttft = best_warm.get("ttft_ms", 0.0)
    speedup = round(cold_ttft / warm_ttft, 2) if warm_ttft > 0 else 0.0
    reduction_pct = round((1.0 - (warm_ttft / cold_ttft)) * 100.0, 2) if cold_ttft > 0 else 0.0

    timings_warm = best_warm.get("timings") or {}
    timings_cold = cold_res.get("timings") or {}
    usage_warm = best_warm.get("usage") or {}

    return {
        "id": ep["id"],
        "name": ep["name"],
        "url": url,
        "model": model,
        "type": ep["type"],
        "status": "OK" if (cold_res["status"] == "OK" and best_warm["status"] == "OK") else "DEGRADED",
        "cold_ttft_ms": cold_ttft,
        "warm_ttft_ms": warm_ttft,
        "speedup_x": speedup,
        "ttft_reduction_pct": reduction_pct,
        "cold_server_prompt_ms": round(timings_cold.get("prompt_ms", 0.0), 2) if timings_cold else None,
        "warm_server_prompt_ms": round(timings_warm.get("prompt_ms", 0.0), 2) if timings_warm else None,
        "cached_tokens": timings_warm.get("cache_n") or usage_warm.get("prompt_tokens"),
        "prompt_tokens_evaluated_warm": timings_warm.get("prompt_n"),
        "cold_pass": cold_res,
        "warm_pass": best_warm,
    }


def pin_all_parallel_slots(canonical_prefix: str, fast_pin: bool = False) -> dict[str, int]:
    """Ensure parallel slots on llama-server pools have the canonical prefix pinned."""
    pinned: dict[str, int] = {}
    for ep in ENDPOINTS:
        if ep["type"] != "llama-server":
            continue
        base_url = ep["base_url"]
        n_slots = 1 if fast_pin else get_slot_count(base_url)
        for s in range(n_slots):
            if fast_pin and s == 0:
                # Slot 0 was already warmed in warm_endpoint()
                continue
            stream_chat_ttft(
                url=ep["url"],
                model=ep["model"],
                system_prompt=canonical_prefix,
                user_prompt=f"PIN_SLOT_{s}: Reply OK.",
                api_key="",
                slot_id=s,
                is_litellm=False,
                timeout=25.0,
            )
        pinned[ep["id"]] = get_slot_count(base_url)
    return pinned


def run_warmer(measure_cold: bool = True) -> dict[str, Any]:
    import concurrent.futures

    prev_cold_by_id: dict[str, dict[str, Any]] = {}
    if not measure_cold and STATUS_PATH.is_file():
        try:
            prev_data = json.loads(STATUS_PATH.read_text(encoding="utf-8"))
            for prev_ep in prev_data.get("endpoints", []):
                if prev_ep.get("id") and prev_ep.get("cold_ttft_ms", 0) > 0:
                    prev_cold_by_id[prev_ep["id"]] = prev_ep
        except Exception:
            pass

    ensure_tier1_ready(max_wait_s=15)
    api_key = load_api_key()
    canonical_prefix, prefix_meta = build_canonical_prefix()
    t0 = time.time()

    def _warm_one(ep: dict[str, Any]) -> dict[str, Any]:
        res = warm_endpoint(ep, canonical_prefix, api_key, measure_cold=measure_cold)
        if not measure_cold and ep["id"] in prev_cold_by_id:
            prev_ep = prev_cold_by_id[ep["id"]]
            cold_ttft = prev_ep["cold_ttft_ms"]
            warm_ttft = res["warm_ttft_ms"]
            res["cold_ttft_ms"] = cold_ttft
            res["cold_server_prompt_ms"] = prev_ep.get("cold_server_prompt_ms")
            res["cold_pass"] = prev_ep.get("cold_pass", res["cold_pass"])
            res["speedup_x"] = round(cold_ttft / warm_ttft, 2) if warm_ttft > 0 else 0.0
            res["ttft_reduction_pct"] = (
                round((1.0 - (warm_ttft / cold_ttft)) * 100.0, 2) if cold_ttft > 0 else 0.0
            )
        return res

    # Group by backing_base_url so two requests never contend for slot_id=0 on the same llama-server simultaneously
    groups: dict[str, list[dict[str, Any]]] = {}
    for ep in ENDPOINTS:
        groups.setdefault(ep["backing_base_url"], []).append(ep)

    def _warm_group(ep_list: list[dict[str, Any]]) -> list[dict[str, Any]]:
        return [_warm_one(ep) for ep in ep_list]

    results_by_id: dict[str, dict[str, Any]] = {}
    with concurrent.futures.ThreadPoolExecutor(max_workers=len(groups)) as ex:
        for grp_res in ex.map(_warm_group, groups.values()):
            for r in grp_res:
                results_by_id[r["id"]] = r
    results = [results_by_id[ep["id"]] for ep in ENDPOINTS]

    slots_pinned = pin_all_parallel_slots(canonical_prefix, fast_pin=not measure_cold)

    ok_count = sum(1 for r in results if r["status"] == "OK")
    avg_cold = round(sum(r["cold_ttft_ms"] for r in results) / len(results), 2) if results else 0.0
    avg_warm = round(sum(r["warm_ttft_ms"] for r in results) / len(results), 2) if results else 0.0
    avg_speedup = round(avg_cold / avg_warm, 2) if avg_warm > 0 else 0.0

    report = {
        "written_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "daemon": "bd-kv-warmer",
        "mode": "benchmark-and-pin" if measure_cold else "pin-refresh",
        "timer_interval_seconds": 600,
        "overall_status": "OK" if ok_count == len(results) else f"PARTIAL ({ok_count}/{len(results)})",
        "endpoints_warmed": ok_count,
        "endpoints_total": len(results),
        "slots_pinned": slots_pinned,
        "avg_cold_ttft_ms": avg_cold,
        "avg_warm_ttft_ms": avg_warm,
        "avg_speedup_x": avg_speedup,
        "elapsed_seconds": round(time.time() - t0, 2),
        "prefix_metadata": prefix_meta,
        "endpoints": results,
    }

    STATUS_PATH.parent.mkdir(parents=True, exist_ok=True)
    tmp_path = STATUS_PATH.with_suffix(".json.tmp")
    tmp_path.write_text(json.dumps(report, indent=2) + "\n", encoding="utf-8")
    tmp_path.replace(STATUS_PATH)
    return report


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Boylenet Prompt-Cache KV-Prefix Pinning Daemon (bd-kv-warmer)"
    )
    parser.add_argument(
        "--run-once",
        action="store_true",
        help="Warm all endpoints once, benchmark Cold vs Warm TTFT, and write status JSON.",
    )
    parser.add_argument(
        "--pin-only",
        action="store_true",
        help="Refresh KV cache prefix without busting existing slot cache first.",
    )
    parser.add_argument(
        "--status",
        action="store_true",
        help="Display latest /var/tmp/bd-kv-warmer-status.json summary.",
    )
    args = parser.parse_args()

    if args.status:
        if not STATUS_PATH.is_file():
            print(f"STATUS FILE NOT FOUND: {STATUS_PATH}", file=sys.stderr)
            return 1
        print(STATUS_PATH.read_text(encoding="utf-8"))
        return 0

    measure_cold = not args.pin_only
    report = run_warmer(measure_cold=measure_cold)
    print(
        f"bd-kv-warmer: {report['overall_status']} | "
        f"warmed={report['endpoints_warmed']}/{report['endpoints_total']} | "
        f"avg_cold_ttft={report['avg_cold_ttft_ms']}ms -> "
        f"avg_warm_ttft={report['avg_warm_ttft_ms']}ms "
        f"({report['avg_speedup_x']}x) | status={STATUS_PATH}"
    )
    for ep in report["endpoints"]:
        print(
            f"  - {ep['id']} ({ep['model']}): {ep['status']} | "
            f"cold={ep['cold_ttft_ms']}ms -> warm={ep['warm_ttft_ms']}ms "
            f"({ep['speedup_x']}x, -{ep['ttft_reduction_pct']}%)"
        )
    return 0 if report["endpoints_warmed"] == report["endpoints_total"] else 1


if __name__ == "__main__":
    raise SystemExit(main())
