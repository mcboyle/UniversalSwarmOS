#!/usr/bin/env python3
"""bd-kv-warmer: Boylenet Prompt-Cache KV-Prefix Pinning Daemon & TTFT Benchmark.

Pre-warms the canonical Boylenet system prompt (FLEET_RULE-FLOOR.md +
BulkDownloader/CLAUDE.md + Fleet Tool Schema) into the KV cache of active
local llama-server and LiteLLM proxy endpoints:
  - Tier 1 Pool Alpha: http://10.0.70.72:8082/v1/chat/completions
  - Tier 1 Pool Beta:  http://10.0.70.125:8081/v1/chat/completions
  - LiteLLM Proxy 164: http://10.0.70.164:4000/v1/chat/completions
  - LiteLLM Proxy 228: http://10.0.70.228:4000/v1/chat/completions

Measures Cold TTFT (ms) vs Warm Cached TTFT (ms) and writes telemetry to
/var/tmp/bd-kv-warmer-status.json.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import subprocess
import sys
import time
import urllib.error
import urllib.request
for _k in ("http_proxy", "https_proxy", "HTTP_PROXY", "HTTPS_PROXY"): os.environ.pop(_k, None)
from pathlib import Path
from typing import Any

FLOOR_PATH = Path("/home/mboyle/bd-persist/FLEET_RULE-FLOOR.md")
CLAUDE_MD_PATH = Path("/home/mboyle/BulkDownloader/CLAUDE.md")
ENV_FILE = Path("/home/mboyle/infra/support-layer/litellm/.env")
STATUS_PATH = Path("/var/tmp/bd-kv-warmer-status.json")

