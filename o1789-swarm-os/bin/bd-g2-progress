#!/bin/bash
# bd-g2-progress -- read-only live view of the G2 path (O2531). Writes nothing in bd-persist.
#   bd-g2-progress            loop in this terminal (refresh 10 s)
#   bd-g2-progress --tmux     start/attach tmux session g2-progress running the loop
#   bd-g2-progress --once     print one frame and exit
# ROUND=r15f3p by default; override: ROUND=r15f3q bd-g2-progress
ROUND=${ROUND:-r15f3q}
NOLENS=${NOLENS:-1}
NOSMOKE=${NOSMOKE:-1}   # O2555: official smoke skipped   # O2546: r15f3q has no lens legs (operator)
CUT=/home/mboyle/bd-cuts/cut/o1789-g2-rig-r3
G2=/home/mboyle/bd-persist/harness-work/O1789/g2
RUN=$G2/G2-RUN-$ROUND

if [ "${1:-}" = --tmux ]; then
  tmux has-session -t g2-progress 2>/dev/null || tmux new-session -d -s g2-progress "ROUND=$ROUND $0"
  [ -n "${TMUX:-}" ] && exec tmux switch-client -t g2-progress || exec tmux attach -t g2-progress
fi

line1(){ [ -f "$1" ] && head -1 "$1" | tr -d '\r'; }
newest(){ ls -t $1 2>/dev/null | head -1; }

# step state: OK | FAIL | RUN | WAIT
verdict_state(){ local f; f=$(newest "$CUT/.review/VERDICT-*$1*$ROUND*.md")
  case "$(line1 "$f")" in *BOARD*) echo OK;; *REFUTE*|*BOUNCE*) echo FAIL;; *) echo WAIT;; esac; }
phase_state(){ local d; d=$(ls -dt "$RUN"/$1-*/ 2>/dev/null | head -1)
  [ -z "$d" ] && { echo WAIT; return; }
  local a; a=$(ls -t "$d"/AUDIT-*FINAL*.md "$d"/AUDIT-*.md "$d"/audit-*/AUDIT-*.md 2>/dev/null | head -1)
  if [ -n "$a" ]; then grep -qiE 'FAIL|REFUTE|INVALID|NOT CLEAN' <(head -3 "$a") && echo FAIL || echo OK
  else echo RUN; fi; }   # dir exists, no audit yet = running or awaiting audit

frame(){
  local s=() n=() i ok=0
  { grep -q "^ROUND: $ROUND" "$CUT/DONE.md" 2>/dev/null || [ -f "$CUT/.review/DONE-$ROUND.md" ]; } && s+=(OK) || s+=(WAIT); n+=("rig $ROUND filed (FX155-B)")
  if [ "$NOLENS" = 1 ]; then s+=(OK OK); n+=("review cx15 (skipped, O2546)" "review O23-B (skipped, O2546)")
  else s+=("$(verdict_state cx-review-correctness15)"); n+=("review cx15 (Codex)")
       s+=("$(verdict_state O23-B)");                   n+=("review O23-B (Claude)"); fi
  [ -d "$RUN" ] && s+=(OK) || s+=(WAIT);           n+=("spare4 install")
  if [ "$NOSMOKE" = 1 ]; then s+=(OK); n+=("smoke (skipped, O2555)"); else s+=("$(phase_state smoke)"); n+=("smoke + adjB audit"); fi
  s+=("$(phase_state parta)");                     n+=("part A + audit")
  s+=("$(phase_state partb)");                     n+=("part B + audit")
  for i in "${s[@]}"; do [ "$i" = OK ] && ok=$((ok+1)); done
  local w=28 f=$(( ok * 28 / ${#s[@]} )) bar
  bar=$(printf '%*s' "$f" '' | tr ' ' '#')$(printf '%*s' $((w-f)) '' | tr ' ' '-')
  printf 'G2 %s  %s  [%s] %d/%d\n' "$ROUND" "$(date -u +%H:%M:%SZ)" "$bar" "$ok" "${#s[@]}"
  [ -f "$RUN/PARKED" ] && printf ' *** %s\n' "$(cat "$RUN/PARKED")"
  for i in "${!s[@]}"; do
    case "${s[$i]}" in OK) m='[x]';; FAIL) m='[!]';; RUN) m='[>]';; *) m='[ ]';; esac
    printf ' %s %s\n' "$m" "${n[$i]}"
  done
  local live; live=$(timeout 6 ssh -o BatchMode=yes -o ConnectTimeout=3 mboyle@10.0.70.81 \
    'R=$(sudo -n ls -dt /var/tmp/g2rig/run-* 2>/dev/null | head -1); pgrep -f "[g]2rig.py" >/dev/null || exit 0; sudo -n awk -F"\t" "NR>1{n++; v=\$17; if(v==\"PASS\")p++; else if(v==\"FAIL\")f++; else if(v==\"INVALID-RIG\")i++; else if(v ~ /COULD/)c++; else o++} END{printf \"%d %d %d %d %d %d\", n,p,f,i,c,o}" $R/out/trials.tsv 2>/dev/null' 2>/dev/null)
  if [ -n "$live" ]; then
    set -- $live; local tot st el rate eta
    tot=$(cat "$RUN"/parta-*/EXPECT_TRIALS "$RUN"/partb-*/EXPECT_TRIALS 2>/dev/null | tail -1)
    st=$(date -d "$(cat $(ls -dt "$RUN"/part*-*/ 2>/dev/null | head -1)start.time 2>/dev/null)" +%s 2>/dev/null)
    el=$(( $(date +%s) - ${st:-$(date +%s)} )); rate=$(( el > 0 ? $1 * 60 / el : 0 ))
    eta=$(( rate > 0 ? (${tot:-0} - $1) / rate : 0 ))
    printf ' spare4 live: %s of %s trials  (%s/min, ~%dh%02dm left)\n' "$1" "${tot:-?}" "$rate" $((eta/60)) $((eta%60))
    printf ' PASS %s | FAIL %s | INVALID-RIG %s | COULD-NOT-LOOK %s | other %s\n' "$2" "$3" "$4" "$5" "$6"
  fi
  local fx; fx=$(tmux capture-pane -p -t bd-fixer-FX155-B 2>/dev/null | grep -E '^● ' | tail -1 | sed 's/^● //' | cut -c1-90)
  [ -n "$fx" ] && printf ' FX155-B: %s\n' "$fx"
}

[ "${1:-}" = --once ] && { frame; exit 0; }
while true; do clear; frame; sleep 10; done
