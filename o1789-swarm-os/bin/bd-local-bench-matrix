def print_table() -> None:
    headers = ("Model", "Quant", "Gen Speed (tg)", "Prompt Speed (pp)", "Mode")
    rows = [
        (r["model"], r["quant"], r["tg_tok_s"], r["pp_tok_s"], r["mode"])
        for r in MATRIX
    ]
    widths = [
        max(len(headers[i]), *(len(row[i]) for row in rows))
        for i in range(len(headers))
    ]
    fmt = "  ".join(f"{{:<{w}}}" for w in widths)
    sep = "  ".join("-" * w for w in widths)
    print("Argon-4 Verified llama-bench Speed Matrix")
    print(sep)
    print(fmt.format(*headers))
    print(sep)
    for row in rows:
        print(fmt.format(*row))
    print(sep)


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Print the Argon-4 verified llama-bench speed matrix."
    )
    parser.add_argument(
        "--json",
        action="store_true",
        help="Output matrix in JSON format",
    )
    args = parser.parse_args()

    if args.json:
        payload = {
            "host": "Argon-4",
            "benchmark": "llama-bench",
            "verified": True,
            "count": len(MATRIX),
            "models": MATRIX,
        }
        print(json.dumps(payload, indent=2))
    else:
        print_table()
    return 0


if __name__ == "__main__":
    sys.exit(main())
