def _extract_markdown_summary(path: str, max_chars: int = 1400) -> tuple[str, str, list[str]]:
    """Extract clean title, dense summary (including headings, key bullets, metrics), and tags from a markdown file."""
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as f:
            raw = f.read(65536)
    except OSError:
        return os.path.basename(path), "", []

    lines = [ln.strip() for ln in raw.splitlines() if ln.strip()]
    title = os.path.basename(path).replace(".md", "")
    for ln in lines[:15]:
        if ln.startswith("# "):
            title = ln.lstrip("# ").strip()
            break
        elif ln.startswith("## ") and title == os.path.basename(path).replace(".md", ""):
            title = ln.lstrip("# ").strip()

    kept: list[str] = []
    in_code = False
    for ln in lines:
        if ln.startswith("```"):
            in_code = not in_code
            continue
        if in_code:
            if any(k in ln.lower() for k in ("http", "tok/s", "psql", "login", "skylakex", "avx", "pass", "rc=0")):
                kept.append(ln[:180])
            continue
        if ln.startswith("| :---") or ln.startswith("|---"):
            continue
        cleaned = re.sub(r"\s+", " ", ln)
        kept.append(cleaned)
        if sum(len(x) for x in kept) >= max_chars * 1.5:
            break

    summary = " ".join(kept)
    if len(summary) > max_chars:
        summary = summary[:max_chars].rsplit(" ", 1)[0] + "..."

    tags: set[str] = set()
    bname = os.path.basename(path).lower()
    m_agent = re.match(r"(agent\d+)", bname)
    if m_agent:
        tags.add(m_agent.group(1))
    blob_lower = (title + " " + summary).lower()
    for kw in (
        "litellm", "postgres", "postgresql", "custom_auth", "skylake", "avx-512", "avx512",
        "libggml-cpu-skylakex", "benchmark", "speedup", "vsan", "esxi", "lacp", "roce",
        "qdrant", "tei", "openwebui", "cockpit", "dashy", "traefik", "unifi", "dns",
        "opencode", "openclaw", "aider", "claude", "codex", "kimi", "hermes", "agy",
        "tier1", "tier2", "tier3", "qwen3", "deepseek", "glm", "argon4", "ramdisk",
    ):
        if kw in blob_lower:
            tags.add(kw)
    for ip in re.findall(r"10\.0\.\d+\.\d+", title + " " + summary):
        tags.add(ip)

    return title, summary, sorted(tags)[:20]


def _extract_sections_from_key_receipt(path: str, category: str) -> list[MemoryItem]:
    """Split key multi-section receipts into section-level episodic memories for granular recall."""
    items: list[MemoryItem] = []
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as f:
            content = f.read(65536)
    except OSError:
        return items

    bname = os.path.basename(path).replace(".md", "")
    sections = re.split(r"\n(?=##\s+)", content)
    for idx, sec in enumerate(sections):
        sec = sec.strip()
        if not sec or len(sec) < 80:
            continue
        lines = [ln.strip() for ln in sec.splitlines() if ln.strip()]
        header = lines[0].lstrip("#").strip()
        sec_title = f"{bname}: {header}"
        body_lines = [
            re.sub(r"\s+", " ", ln)
            for ln in lines[1:]
            if not ln.startswith("```") and not ln.startswith("| :---")
        ]
        summary = " ".join(body_lines)[:1200]
        if len(summary) < 40:
            continue
        slug = _slugify(f"{bname}-sec{idx}-{header}")
        _, _, tags = _extract_markdown_summary(path, max_chars=600)
        for tok in re.findall(r"[a-z0-9_.-]{3,}", header.lower()):
            if tok not in STOPWORDS:
                tags.append(tok)
        items.append(
            MemoryItem(
                slug=slug,
                category=category,
                title=sec_title,
                summary=summary,
                source_path=path,
                tags=sorted(set(tags))[:20],
            )
        )
    return items


def harvest_all_memories() -> tuple[list[MemoryItem], dict[str, int]]:
    """Harvest episodic memories across all Boylenet harnesses and receipt directories."""
    by_slug: dict[str, MemoryItem] = {}
    counts: dict[str, int] = {
        "curated_golden": 0,
        "infra_upgrade_receipts": 0,
        "infra_upgrade_sections": 0,
        "fleet_lessons_and_findings": 0,
        "claude_session_memories": 0,
        "agy_brain_artifacts": 0,
        "codex_kimi_openclaw_configs": 0,
    }

    # 1. Curated golden memories
    for item in _curated_golden_memories():
        by_slug[item.slug] = item
        counts["curated_golden"] += 1

    # 2. All /home/mboyle/bd-persist/harness-work/O1789/infra-upgrade/*.md receipts
    for path in sorted(glob.glob(f"{INFRA_UPGRADE_DIR}/*.md")):
        bname = os.path.basename(path)
        title, summary, tags = _extract_markdown_summary(path, max_chars=1400)
        if not summary:
            continue
        slug = _slugify(f"o1789-infra-{bname.replace('.md', '')}")
        by_slug[slug] = MemoryItem(
            slug=slug,
            category="o1789-infra-receipt",
            title=title,
            summary=summary,
            source_path=path,
            tags=tags,
        )
        counts["infra_upgrade_receipts"] += 1

        if any(
            k in bname
            for k in (
                "AGENT36", "AGENT38", "AGENT39", "AGENT40", "AGENT41",
                "AGENT42", "AGENT43", "AGENT44", "AGENT45", "AGENT46",
                "AGENT47", "AGENT48", "CHEATSHEET",
            )
        ):
            for sec_item in _extract_sections_from_key_receipt(path, "o1789-infra-section"):
                if sec_item.slug not in by_slug:
                    by_slug[sec_item.slug] = sec_item
                    counts["infra_upgrade_sections"] += 1

    # 3. Fleet lessons, findings, acceptance receipts & O1789 research reports
    os.makedirs(LESSONS_DIR, exist_ok=True)
    lesson_globs = (
        sorted(glob.glob(f"{LESSONS_DIR}/*.md"))
        + sorted(glob.glob(f"{O1789_DIR}/REPORT-*.md"))
        + sorted(glob.glob(f"{PERSIST_DIR}/FINDING-*.md"))
        + sorted(glob.glob(f"{PERSIST_DIR}/ACCEPTANCE-*.md"))[:40]
        + sorted(glob.glob(f"{PERSIST_DIR}/harness/*.md"))
        + ([f"{PERSIST_DIR}/role-state/dispatch-lessons.md"] if os.path.exists(f"{PERSIST_DIR}/role-state/dispatch-lessons.md") else [])
    )
    for path in lesson_globs:
        if not os.path.isfile(path):
            continue
        title, summary, tags = _extract_markdown_summary(path, max_chars=1100)
        if not summary:
            continue
        slug = _slugify(f"fleet-lesson-{os.path.basename(path).replace('.md', '')}")
        if slug not in by_slug:
            by_slug[slug] = MemoryItem(
                slug=slug,
                category="fleet-lesson",
                title=title,
                summary=summary,
                source_path=path,
                tags=sorted(set(tags + ["fleet-lesson"])),
            )
            counts["fleet_lessons_and_findings"] += 1

    # 4. Claude Code session memories (/home/mboyle/.claude/projects/*/memory/*.md)
    for path in sorted(glob.glob(f"{CLAUDE_PROJECTS_DIR}/*/memory/*.md")):
        if os.path.basename(path) == "MEMORY.md":
            continue
        ns = path.split("/")[-3]
        title, summary, tags = _extract_markdown_summary(path, max_chars=1000)
        if not summary:
            continue
        slug = _slugify(f"claude-mem-{ns}-{os.path.basename(path).replace('.md', '')}")
        if slug not in by_slug:
            by_slug[slug] = MemoryItem(
                slug=slug,
                category="claude-memory",
                title=f"[Claude {ns}] {title}",
                summary=summary,
                source_path=path,
                tags=sorted(set(tags + ["claude", "session-memory"])),
            )
            counts["claude_session_memories"] += 1

    # 5. AGY brain session artifacts (/home/mboyle/.gemini/antigravity-cli/brain/*/*.md)
    for path in sorted(glob.glob(f"{AGY_BRAIN_DIR}/*/*.md")):
        bname = os.path.basename(path)
        if bname in ("prompt_draft.md", "task.md"):
            continue
        conv_id = path.split("/")[-2][:8]
        title, summary, tags = _extract_markdown_summary(path, max_chars=1100)
        if not summary:
            continue
        slug = _slugify(f"agy-brain-{conv_id}-{bname.replace('.md', '')}")
        if slug not in by_slug:
            by_slug[slug] = MemoryItem(
                slug=slug,
                category="agy-session-artifact",
                title=f"[AGY {conv_id}] {title}",
                summary=summary,
                source_path=path,
                tags=sorted(set(tags + ["agy", "antigravity", "brain-artifact"])),
            )
            counts["agy_brain_artifacts"] += 1

    # 6. Codex / Kimi / OpenClaw / Hermes profile & harness configurations
    for path in sorted(glob.glob(f"{CODEX_DIR}/bd-*.config.toml"))[:25]:
        bname = os.path.basename(path)
        try:
            with open(path, "r", encoding="utf-8", errors="replace") as f:
                txt = re.sub(r"\s+", " ", f.read(4096)).strip()
        except OSError:
            continue
        if not txt:
            continue
        slug = _slugify(f"codex-profile-{bname.replace('.config.toml', '')}")
        if slug not in by_slug:
            by_slug[slug] = MemoryItem(
                slug=slug,
                category="codex-harness-config",
                title=f"Codex Harness Profile: {bname}",
                summary=txt[:800],
                source_path=path,
                tags=["codex", "harness-config", bname.replace(".config.toml", "")],
            )
            counts["codex_kimi_openclaw_configs"] += 1

    for item in _curated_golden_memories():
        lesson_file = os.path.join(LESSONS_DIR, f"{item.slug}.md")
        if not os.path.exists(lesson_file):
            try:
                with open(lesson_file, "w", encoding="utf-8") as f:
                    f.write(f"# {item.title}\n\n- **Category**: `{item.category}`\n- **Source**: `{item.source_path}`\n- **Tags**: `{', '.join(item.tags)}`\n\n## Distilled Summary\n\n{item.summary}\n")
            except OSError:
                pass

    return list(by_slug.values()), counts


def ensure_pg_databases_and_tables() -> list[str]:
    """Ensure `boylenet_memory` database exists and `boylenet_episodic_memory` table + GIN index exist in target DBs."""
    conn = psycopg2.connect(
        host=PG_HOST, port=PG_PORT, user=PG_USER, password=PG_PASS, dbname="postgres", connect_timeout=5
    )
    conn.autocommit = True
    with conn.cursor() as cur:
        cur.execute("SELECT 1 FROM pg_database WHERE datname = %s", (PG_PRIMARY_DB,))
        if not cur.fetchone():
            cur.execute(f"CREATE DATABASE {PG_PRIMARY_DB} OWNER {PG_USER}")
    conn.close()

    ready_dbs: list[str] = []
    ddl = f"""
    CREATE TABLE IF NOT EXISTS {PG_TABLE} (
        id SERIAL PRIMARY KEY,
        slug TEXT UNIQUE,
        category TEXT,
        title TEXT,
        summary TEXT,
        source_path TEXT,
        tags TEXT[],
        created_at TIMESTAMPTZ DEFAULT NOW()
    );
    ALTER TABLE {PG_TABLE}
        ADD COLUMN IF NOT EXISTS fts_vec tsvector
        GENERATED ALWAYS AS (to_tsvector('english', coalesce(title, '') || ' ' || coalesce(summary, ''))) STORED;
    CREATE INDEX IF NOT EXISTS idx_{PG_TABLE}_fts
        ON {PG_TABLE} USING GIN (to_tsvector('english', title || ' ' || summary));
    CREATE INDEX IF NOT EXISTS idx_{PG_TABLE}_fts_vec
        ON {PG_TABLE} USING GIN (fts_vec);
    CREATE INDEX IF NOT EXISTS idx_{PG_TABLE}_category
        ON {PG_TABLE} (category);
    """
    for db in PG_MIRROR_DBS:
        try:
            c = psycopg2.connect(
                host=PG_HOST, port=PG_PORT, user=PG_USER, password=PG_PASS, dbname=db, connect_timeout=5
            )
            c.autocommit = True
            with c.cursor() as cur:
                cur.execute(ddl)
            c.close()
            ready_dbs.append(db)
        except Exception:
            pass
    return ready_dbs


def upsert_pg_memories(items: list[MemoryItem], dbs: list[str]) -> dict[str, int]:
    """Batch upsert MemoryItems into PostgreSQL databases, prune stale rows, and return slug -> id map."""
    slug_to_id: dict[str, int] = {}
    rows = [
        (it.slug, it.category, it.title, it.summary, it.source_path, it.tags)
        for it in items
    ]
    valid_slugs = tuple(it.slug for it in items)
    sql = f"""
    INSERT INTO {PG_TABLE} (slug, category, title, summary, source_path, tags)
    VALUES %s
    ON CONFLICT (slug) DO UPDATE SET
        category = EXCLUDED.category,
        title = EXCLUDED.title,
        summary = EXCLUDED.summary,
        source_path = EXCLUDED.source_path,
        tags = EXCLUDED.tags
    RETURNING slug, id;
    """
    for db in dbs:
        conn = psycopg2.connect(
            host=PG_HOST, port=PG_PORT, user=PG_USER, password=PG_PASS, dbname=db, connect_timeout=5
        )
        with conn:
            with conn.cursor() as cur:
                if valid_slugs:
                    cur.execute(f"DELETE FROM {PG_TABLE} WHERE slug NOT IN %s;", (valid_slugs,))
                returned = execute_values(cur, sql, rows, fetch=True)
                if db == PG_PRIMARY_DB or not slug_to_id:
                    for slug, pid in returned:
                        slug_to_id[slug] = int(pid)
        conn.close()
    return slug_to_id


def ensure_qdrant_collection(collection: str = QDRANT_COLLECTION, recreate: bool = False) -> None:
    conn = http.client.HTTPConnection(QDRANT_HOST, QDRANT_PORT, timeout=5.0)
    try:
        if recreate:
            conn.request("DELETE", f"/collections/{collection}")
            conn.getresponse().read()
        conn.request("GET", f"/collections/{collection}")
        resp = conn.getresponse()
        resp.read()
        if resp.status != 200:
            payload = json.dumps({"vectors": {"size": VECTOR_DIM, "distance": "Cosine"}}).encode("utf-8")
            conn.request("PUT", f"/collections/{collection}", body=payload, headers={"Content-Type": "application/json"})
            r2 = conn.getresponse()
            r2.read()
    finally:
        conn.close()


def upsert_qdrant_memories(
    items: list[MemoryItem],
    vectors: list[list[float]],
    slug_to_id: dict[str, int],
    collections: tuple[str, ...] = (QDRANT_COLLECTION, QDRANT_MIRROR_COLLECTION),
) -> float:
    """Batch upsert embedded memory points into Qdrant collections."""
    t0 = time.perf_counter()
    now_iso = datetime.now(timezone.utc).isoformat()
    for col in collections:
        ensure_qdrant_collection(col, recreate=True)

    conn = http.client.HTTPConnection(QDRANT_HOST, QDRANT_PORT, timeout=10.0)
    try:
        batch_size = 64
        for i in range(0, len(items), batch_size):
            points = []
            for it, vec in zip(items[i : i + batch_size], vectors[i : i + batch_size]):
                points.append(
                    {
                        "id": _point_id_from_slug(it.slug),
                        "vector": vec,
                        "payload": {
                            "pg_id": slug_to_id.get(it.slug, 0),
                            "slug": it.slug,
                            "category": it.category,
                            "title": it.title,
                            "summary": it.summary,
                            "source_path": it.source_path,
                            "tags": it.tags,
                            "created_at": now_iso,
                        },
                    }
                )
            body = json.dumps({"points": points}).encode("utf-8")
            for col in collections:
                conn.request(
                    "PUT",
                    f"/collections/{col}/points?wait=true",
                    body=body,
                    headers={"Content-Type": "application/json"},
                )
                resp = conn.getresponse()
                resp.read()
    finally:
        conn.close()
    return (time.perf_counter() - t0) * 1000.0


def run_consolidate(as_json: bool = False) -> int:
    t_start = time.perf_counter()
    items, source_counts = harvest_all_memories()
    dbs = ensure_pg_databases_and_tables()
    t_pg0 = time.perf_counter()
    slug_to_id = upsert_pg_memories(items, dbs)
    pg_ms = (time.perf_counter() - t_pg0) * 1000.0

    embed_inputs = [
        f"{it.title}\nKeywords: {' '.join(it.tags)}\n{it.summary}"
        for it in items
    ]
    vectors, tei_ms = embed_texts_tei(embed_inputs, batch_size=32)
    qdrant_ms = upsert_qdrant_memories(items, vectors, slug_to_id)
    total_ms = (time.perf_counter() - t_start) * 1000.0

    report = {
        "status": "OK",
        "timestamp_utc": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "total_memories_consolidated": len(items),
        "source_breakdown": source_counts,
        "postgres": {
            "host": f"{PG_HOST}:{PG_PORT}",
            "databases": dbs,
            "table": PG_TABLE,
            "rows_upserted": len(slug_to_id),
            "upsert_ms": round(pg_ms, 2),
        },
        "qdrant": {
            "url": QDRANT_URL,
            "collection": QDRANT_COLLECTION,
            "mirror_collection": QDRANT_MIRROR_COLLECTION,
            "vector_dim": VECTOR_DIM,
            "points_upserted": len(items),
            "tei_embed_ms": round(tei_ms, 2),
            "qdrant_upsert_ms": round(qdrant_ms, 2),
        },
        "total_duration_ms": round(total_ms, 2),
    }

    if as_json:
        print(json.dumps(report, indent=2))
    else:
        print(
            f"[bd-memory-dreamer] CONSOLIDATE OK | memories={len(items)} "
            f"| pg_dbs={','.join(dbs)} ({pg_ms:.1f}ms) "
            f"| tei_embed={tei_ms:.1f}ms | qdrant_upsert={qdrant_ms:.1f}ms "
            f"| total={total_ms:.1f}ms"
        )
        for k, v in source_counts.items():
            print(f"  - {k}: {v}")
    return 0


QUERY_CACHE_PATH = "/var/tmp/bd-memory-dreamer-query-cache.json"


def _qdrant_semantic_search(query: str, limit: int) -> tuple[list[dict[str, Any]], float, float]:
    """Embed query via TEI and search Qdrant `boylenet_episodic_memory` in <15ms."""
    t0 = time.perf_counter()
    q_clean = query.strip()[:1500]
    q_key = hashlib.sha1(q_clean.encode("utf-8")).hexdigest()
    q_vec: list[float] | None = None
    q_cache: dict[str, list[float]] = {}
    if os.path.exists(QUERY_CACHE_PATH):
        try:
            with open(QUERY_CACHE_PATH, "r", encoding="utf-8") as f:
                q_cache = json.load(f)
            q_vec = q_cache.get(q_key)
        except Exception:
            q_vec = None

    if q_vec is None:
        conn_tei = http.client.HTTPConnection(TEI_HOST, TEI_PORT, timeout=4.0)
        try:
            payload = json.dumps({"inputs": q_clean, "truncate": True}).encode("utf-8")
            conn_tei.request("POST", "/embed", body=payload, headers={"Content-Type": "application/json"})
            resp = conn_tei.getresponse()
            body = resp.read()
            data = json.loads(body.decode("utf-8"))
            raw_vec = data[0] if isinstance(data[0], list) else data
            q_vec = _normalize_to_1024(raw_vec)
            q_cache[q_key] = q_vec
            if len(q_cache) <= 200:
                with open(QUERY_CACHE_PATH, "w", encoding="utf-8") as f:
                    json.dump(q_cache, f)
        except Exception:
            q_vec = _deterministic_vec_1024(q_clean)
        finally:
            conn_tei.close()
    tei_ms = (time.perf_counter() - t0) * 1000.0

    t_q0 = time.perf_counter()
    conn_qd = http.client.HTTPConnection(QDRANT_HOST, QDRANT_PORT, timeout=3.0)
    hits: list[dict[str, Any]] = []
    try:
        search_body = json.dumps(
            {
                "vector": q_vec,
                "limit": max(limit * 2, 8),
                "with_payload": True,
            }
        ).encode("utf-8")
        conn_qd.request(
            "POST",
            f"/collections/{QDRANT_COLLECTION}/points/search",
            body=search_body,
            headers={"Content-Type": "application/json"},
        )
        r_qd = conn_qd.getresponse()
        qd_data = json.loads(r_qd.read().decode("utf-8"))
        hits = qd_data.get("result", []) or []
    finally:
        conn_qd.close()
    qdrant_ms = (time.perf_counter() - t_q0) * 1000.0
    return hits, tei_ms, qdrant_ms


def _pg_fts_search(query: str, limit: int) -> tuple[list[dict[str, Any]], float]:
    """Run PostgreSQL GIN full-text search (OR-tsquery across query tokens) on boylenet_episodic_memory."""
    t0 = time.perf_counter()
    tokens = [
        re.sub(r"[^a-z0-9]", "", w.lower())
        for w in query.split()
    ]
    tokens = [t for t in tokens if len(t) >= 2 and t not in STOPWORDS]
    if not tokens:
        return [], 0.0
    tsq_str = " | ".join(tokens)

    sql = f"""
    SELECT id, slug, category, title, summary, source_path, tags,
           ts_rank_cd(fts_vec, to_tsquery('english', %s)) AS fts_rank
    FROM {PG_TABLE}
    WHERE fts_vec @@ to_tsquery('english', %s)
    ORDER BY fts_rank DESC
    LIMIT %s;
    """
    rows: list[dict[str, Any]] = []
    try:
        pg_host = "/var/run/postgresql" if os.path.exists("/var/run/postgresql/.s.PGSQL.5432") else PG_HOST
        conn = psycopg2.connect(
            host=pg_host, port=PG_PORT, user=PG_USER, password=PG_PASS, dbname=PG_PRIMARY_DB, connect_timeout=3, sslmode="disable"
        )
        with conn.cursor() as cur:
            cur.execute(sql, (tsq_str, tsq_str, max(limit * 2, 8)))
            for r in cur.fetchall():
                rows.append(
                    {
                        "pg_id": r[0],
                        "slug": r[1],
                        "category": r[2],
                        "title": r[3],
                        "summary": r[4],
                        "source_path": r[5],
                        "tags": r[6] or [],
                        "fts_rank": float(r[7] or 0.0),
                    }
                )
        conn.close()
    except Exception:
        pass
    pg_ms = (time.perf_counter() - t0) * 1000.0
    return rows, pg_ms


def run_recall(query: str, top_k: int = 5, as_json: bool = False) -> int:
    t0 = time.perf_counter()
    with ThreadPoolExecutor(max_workers=2) as pool:
        fut_qd = pool.submit(_qdrant_semantic_search, query, top_k)
        fut_pg = pool.submit(_pg_fts_search, query, top_k)
        qd_hits, tei_ms, qdrant_ms = fut_qd.result()
        pg_hits, pg_ms = fut_pg.result()

    # Hybrid Reciprocal Rank Fusion (RRF) + Lexical Keyword Boost
    q_tokens = [
        tok for tok in re.findall(r"[a-z0-9_.-]+", query.lower())
        if len(tok) >= 2 and tok not in STOPWORDS
    ]
    merged: dict[str, dict[str, Any]] = {}

    for rank, h in enumerate(qd_hits, start=1):
        payload = h.get("payload") or {}
        slug = payload.get("slug")
        if not slug:
            continue
        vec_score = float(h.get("score") or 0.0)
        merged[slug] = {
            "slug": slug,
            "pg_id": payload.get("pg_id", 0),
            "category": payload.get("category", ""),
            "title": payload.get("title", ""),
            "summary": payload.get("summary", ""),
            "source_path": payload.get("source_path", ""),
            "tags": payload.get("tags", []),
            "vector_score": round(vec_score, 4),
            "fts_score": 0.0,
            "rrf_score": (1.0 / (20.0 + rank)) + (vec_score * 0.6),
        }

    for rank, row in enumerate(pg_hits, start=1):
        slug = row["slug"]
        fts_score = float(row.get("fts_rank", 0.0))
        if slug not in merged:
            merged[slug] = {
                "slug": slug,
                "pg_id": row["pg_id"],
                "category": row["category"],
                "title": row["title"],
                "summary": row["summary"],
                "source_path": row["source_path"],
                "tags": row["tags"],
                "vector_score": 0.0,
                "fts_score": round(fts_score, 4),
                "rrf_score": (1.0 / (20.0 + rank)) + min(fts_score * 0.4, 0.5),
            }
        else:
            merged[slug]["fts_score"] = round(fts_score, 4)
            merged[slug]["rrf_score"] += (1.0 / (20.0 + rank)) + min(fts_score * 0.4, 0.5)

    # Exact token overlap boost
    for slug, entry in merged.items():
        haystack = f"{entry['title']} {' '.join(entry['tags'])} {entry['summary']}".lower()
        matched = sum(1 for tok in q_tokens if tok in haystack)
        if q_tokens:
            overlap_ratio = matched / len(q_tokens)
            entry["keyword_overlap"] = round(overlap_ratio, 4)
            entry["rrf_score"] = round(entry["rrf_score"] + overlap_ratio * 0.75, 4)
        else:
            entry["keyword_overlap"] = 0.0
            entry["rrf_score"] = round(entry["rrf_score"], 4)

    ranked = sorted(merged.values(), key=lambda x: x["rrf_score"], reverse=True)[:top_k]
    total_ms = (time.perf_counter() - t0) * 1000.0

    out = {
        "query": query,
        "top_k": top_k,
        "latency_ms": {
            "total_ms": round(total_ms, 2),
            "tei_embed_ms": round(tei_ms, 2),
            "qdrant_search_ms": round(qdrant_ms, 2),
            "pg_fts_ms": round(pg_ms, 2),
        },
        "results": ranked,
    }

    if as_json:
        print(json.dumps(out, indent=2))
    else:
        print(
            f"[bd-memory-dreamer] RECALL query={query!r} | hits={len(ranked)} "
            f"| total={total_ms:.2f}ms (qdrant={qdrant_ms:.2f}ms, tei={tei_ms:.2f}ms, pg_fts={pg_ms:.2f}ms)"
        )
        for idx, r in enumerate(ranked, start=1):
            print(
                f"\n  [{idx}] {r['title']} (score={r['rrf_score']:.4f}, vec={r['vector_score']:.4f}, fts={r['fts_score']:.4f}, kw={r['keyword_overlap']:.2f})\n"
                f"      slug: {r['slug']} | category: {r['category']}\n"
                f"      source: {r['source_path']}\n"
                f"      tags: {', '.join(r['tags'][:12])}\n"
                f"      summary: {r['summary']}"
            )
    return 0


def run_stats(as_json: bool = False) -> int:
    t0 = time.perf_counter()
    pg_stats: dict[str, Any] = {}
    for db in PG_MIRROR_DBS:
        try:
            conn = psycopg2.connect(
                host=PG_HOST, port=PG_PORT, user=PG_USER, password=PG_PASS, dbname=db, connect_timeout=3
            )
            with conn.cursor() as cur:
                cur.execute(f"SELECT COUNT(*) FROM {PG_TABLE};")
                total = cur.fetchone()[0]
                cur.execute(f"SELECT category, COUNT(*) FROM {PG_TABLE} GROUP BY category ORDER BY COUNT(*) DESC;")
                by_cat = {r[0]: r[1] for r in cur.fetchall()}
            conn.close()
            pg_stats[db] = {"total_rows": total, "by_category": by_cat}
        except Exception as e:
            pg_stats[db] = {"error": str(e)}

    qd_stats: dict[str, Any] = {}
    conn_qd = http.client.HTTPConnection(QDRANT_HOST, QDRANT_PORT, timeout=3.0)
    try:
        for col in (QDRANT_COLLECTION, QDRANT_MIRROR_COLLECTION):
            conn_qd.request("GET", f"/collections/{col}")
            resp = conn_qd.getresponse()
            data = json.loads(resp.read().decode("utf-8"))
            res = data.get("result", {})
            qd_stats[col] = {
                "status": res.get("status"),
                "points_count": res.get("points_count"),
                "vector_size": res.get("config", {}).get("params", {}).get("vectors", {}).get("size"),
                "distance": res.get("config", {}).get("params", {}).get("vectors", {}).get("distance"),
            }
    finally:
        conn_qd.close()

    elapsed_ms = (time.perf_counter() - t0) * 1000.0
    stats = {
        "status": "OK",
        "elapsed_ms": round(elapsed_ms, 2),
        "postgres": pg_stats,
        "qdrant": qd_stats,
        "lessons_dir_files": len(glob.glob(f"{LESSONS_DIR}/*.md")),
    }
    if as_json:
        print(json.dumps(stats, indent=2))
    else:
        primary_rows = pg_stats.get(PG_PRIMARY_DB, {}).get("total_rows", 0)
        qd_pts = qd_stats.get(QDRANT_COLLECTION, {}).get("points_count", 0)
        print(
            f"[bd-memory-dreamer] STATS | pg({PG_PRIMARY_DB})={primary_rows} rows "
            f"| qdrant({QDRANT_COLLECTION})={qd_pts} points (1024-dim Cosine) "
            f"| lessons_dir={stats['lessons_dir_files']} files | latency={elapsed_ms:.2f}ms"
        )
        for cat, cnt in pg_stats.get(PG_PRIMARY_DB, {}).get("by_category", {}).items():
            print(f"  - {cat}: {cnt}")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="bd-memory-dreamer",
        description="Boylenet Cross-Harness Episodic Memory Consolidator ('Dreamer' Swarm #11)",
    )
    parser.add_argument("--consolidate", action="store_true", help="Harvest and index episodic memories into PostgreSQL + Qdrant")
    parser.add_argument("--recall", type=str, default=None, help="Semantic + FTS hybrid recall query (<50ms)")
    parser.add_argument("--top-k", type=int, default=5, help="Number of top memories to return (default: 5)")
    parser.add_argument("--stats", action="store_true", help="Show PostgreSQL and Qdrant memory substrate statistics")
    parser.add_argument("--json", action="store_true", help="Emit structured JSON output")

    args = parser.parse_args()
    if args.consolidate:
        return run_consolidate(as_json=args.json)
    if args.recall is not None:
        return run_recall(args.recall, top_k=args.top_k, as_json=args.json)
    if args.stats:
        return run_stats(as_json=args.json)

    parser.print_help()
    return 0


if __name__ == "__main__":
    sys.exit(main())
