@dataclass
class MemoryItem:
    slug: str
    category: str
    title: str
    summary: str
    source_path: str
    tags: list[str] = field(default_factory=list)


def _slugify(text: str, max_len: int = 80) -> str:
    s = re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")
    if len(s) > max_len:
        h = hashlib.sha1(s.encode("utf-8")).hexdigest()[:8]
        s = f"{s[:max_len - 9].rstrip('-')}-{h}"
    return s or "memory-item"


def _point_id_from_slug(slug: str) -> str:
    """Deterministic UUIDv5-style string from slug for Qdrant point ID."""
    h = hashlib.md5(slug.encode("utf-8")).hexdigest()
    return f"{h[:8]}-{h[8:12]}-{h[12:16]}-{h[16:20]}-{h[20:32]}"


def _normalize_to_1024(vec: list[float]) -> list[float]:
    """L2-normalize vector and project/pad into 1024-dim Cosine space."""
    norm = math.sqrt(sum(x * x for x in vec))
    if norm > 0.0:
        unit = [float(x / norm) for x in vec]
    else:
        unit = [1.0] + [0.0] * (len(vec) - 1)
    if len(unit) == VECTOR_DIM:
        return unit
    if len(unit) < VECTOR_DIM:
        # Zero-padding a unit vector preserves exact dot-product & cosine similarity!
        return unit + [0.0] * (VECTOR_DIM - len(unit))
    return _normalize_to_1024(unit[:VECTOR_DIM])


def _deterministic_vec_1024(text: str) -> list[float]:
    vec = [0.0] * VECTOR_DIM
    for tok in re.findall(r"[a-z0-9_.-]+", text.lower()):
        if len(tok) < 2:
            continue
        h = int(hashlib.md5(tok.encode("utf-8")).hexdigest(), 16)
        vec[h % VECTOR_DIM] += 1.0
    return _normalize_to_1024(vec)


VEC_CACHE_PATH = "/var/tmp/bd-memory-dreamer-vec-cache.json"


def embed_texts_tei(texts: list[str], batch_size: int = 32) -> tuple[list[list[float]], float]:
    """Embed a list of texts via local TEI (10.0.70.164:8081/embed) and normalize to 1024-dim, with disk cache."""
    t0 = time.perf_counter()
    cache: dict[str, list[float]] = {}
    if os.path.exists(VEC_CACHE_PATH):
        try:
            with open(VEC_CACHE_PATH, "r", encoding="utf-8") as f:
                cache = json.load(f)
        except Exception:
            cache = {}

    keys = [hashlib.sha1(t.encode("utf-8")).hexdigest() for t in texts]
    missing_indices = [idx for idx, k in enumerate(keys) if k not in cache]

    if missing_indices:
        conn = http.client.HTTPConnection(TEI_HOST, TEI_PORT, timeout=8.0)
        try:
            for i in range(0, len(missing_indices), batch_size):
                batch_idxs = missing_indices[i : i + batch_size]
                batch = [texts[idx][:2000] if texts[idx] else "empty" for idx in batch_idxs]
                payload = json.dumps({"inputs": batch, "truncate": True}).encode("utf-8")
                try:
                    conn.request("POST", "/embed", body=payload, headers={"Content-Type": "application/json"})
                    resp = conn.getresponse()
                    body = resp.read()
                    if resp.status == 200:
                        data = json.loads(body.decode("utf-8"))
                        if isinstance(data, list) and data:
                            if isinstance(data[0], list):
                                for idx, v in zip(batch_idxs, data):
                                    cache[keys[idx]] = _normalize_to_1024(v)
                                continue
                            elif isinstance(data[0], (int, float)) and len(batch_idxs) == 1:
                                cache[keys[batch_idxs[0]]] = _normalize_to_1024(data)
                                continue
                except Exception:
                    conn = http.client.HTTPConnection(TEI_HOST, TEI_PORT, timeout=8.0)
                for idx in batch_idxs:
                    cache[keys[idx]] = _deterministic_vec_1024(texts[idx])
        finally:
            conn.close()
        try:
            with open(VEC_CACHE_PATH, "w", encoding="utf-8") as f:
                json.dump(cache, f)
        except Exception:
            pass

    all_vecs = [cache[k] for k in keys]
    elapsed_ms = (time.perf_counter() - t0) * 1000.0
    return all_vecs, elapsed_ms


