def compute_model_metrics(
    spec: ModelSpec,
    ctx_per_slot: int,
    vram_total_mib: float,
    cuda_overhead_mib: float,
) -> dict:
    usable_kv_vram_mib = max(0.0, vram_total_mib - cuda_overhead_mib - spec.vram_weights_mib)
    ddr4_free_gib = max(0.0, TOTAL_DDR4_GIB - spec.ddr4_weights_gib)

    kv_metrics = {}
    for kv_type in ("FP16", "Q8_0", "Q4_0"):
        mib_per_1k = spec.kv_mib_per_1k_tokens(kv_type)
        slot_kv_mib = mib_per_1k * (ctx_per_slot / 1024.0)
        max_parallel = int(math.floor(usable_kv_vram_mib / slot_kv_mib)) if slot_kv_mib > 0 else 0
        max_total_ctx_k = int(math.floor((usable_kv_vram_mib / mib_per_1k))) if mib_per_1k > 0 else 0
        kv_metrics[kv_type] = {
            "mib_per_1k_tok": round(mib_per_1k, 3),
            "slot_kv_mib": round(slot_kv_mib, 2),
            "max_parallel_slots": max_parallel,
            "recommended_parallel_flag": f"--parallel {max_parallel}",
            "max_total_ctx_tokens": max_total_ctx_k * 1024,
            "vram_utilized_mib": round(
                spec.vram_weights_mib + cuda_overhead_mib + (max_parallel * slot_kv_mib), 1
            ),
            "vram_headroom_mib": round(
                vram_total_mib - (spec.vram_weights_mib + cuda_overhead_mib + (max_parallel * slot_kv_mib)), 1
            ),
        }

    return {
        "model": spec.name,
        "tier": spec.tier,
        "arch": spec.arch,
        "layers": spec.n_layers,
        "kv_heads": spec.n_kv_heads,
        "head_dim": spec.head_dim,
        "vram_weights_mib": spec.vram_weights_mib,
        "ddr4_weights_gib": spec.ddr4_weights_gib,
        "ddr4_remaining_gib": round(ddr4_free_gib, 1),
        "usable_kv_vram_mib": round(usable_kv_vram_mib, 1),
        "ctx_per_slot": ctx_per_slot,
        "kv_types": kv_metrics,
        "notes": spec.notes,
    }


def print_table(results: List[dict], ctx_per_slot: int, vram_total_mib: float, cuda_overhead_mib: float) -> None:
    print("=" * 132)
    print(
        f"BOYLENET KV-CACHE & CONCURRENCY CALCULATOR | 4x Tesla T4 ({vram_total_mib:,.0f} MiB GDDR6) + "
        f"{TOTAL_DDR4_GIB:,.0f} GiB Locked DDR4 | Slot Ctx: {ctx_per_slot:,} tok"
    )
    print(
        f"CUDA/Compute Reserve: {cuda_overhead_mib:,.0f} MiB | KV Element Sizes: "
        f"FP16=2.000 B, Q8_0=1.0625 B (GGML blk32), Q4_0=0.5625 B (GGML blk32)"
    )
    print("=" * 132)
    header = (
        f"{'Tier':<4} | {'Model':<35} | {'Arch':<9} | {'VRAM Wt':>8} | {'DDR4 Wt':>7} | {'KV Pool':>8} | "
        f"{'FP16 Slot / N':>16} | {'Q8_0 Slot / N':>16} | {'Q4_0 Slot / N':>16}"
    )
    print(header)
    print("-" * 132)
    current_tier = None
    for r in results:
        if current_tier is not None and r["tier"] != current_tier:
            print("-" * 132)
        current_tier = r["tier"]
        fp16 = r["kv_types"]["FP16"]
        q8 = r["kv_types"]["Q8_0"]
        q4 = r["kv_types"]["Q4_0"]
        fp16_str = f"{fp16['slot_kv_mib']:>6.0f}M / p={fp16['max_parallel_slots']:<3}"
        q8_str = f"{q8['slot_kv_mib']:>6.0f}M / p={q8['max_parallel_slots']:<3}"
        q4_str = f"{q4['slot_kv_mib']:>6.0f}M / p={q4['max_parallel_slots']:<3}"
        print(
            f"T{r['tier']:<3} | {r['model']:<35} | {r['arch']:<9} | "
            f"{r['vram_weights_mib']:>7.0f}M | {r['ddr4_weights_gib']:>6.0f}G | "
            f"{r['usable_kv_vram_mib']:>7.0f}M | {fp16_str:>16} | {q8_str:>16} | {q4_str:>16}"
        )
    print("=" * 132)


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Exact KV-cache VRAM & max concurrent agent slot (--parallel N) calculator for 4x Tesla T4 + 1,730 GiB Locked DDR4."
    )
    parser.add_argument("--ctx", type=int, default=16384, help="Context tokens per agent slot (default: 16384)")
    parser.add_argument("--tier", type=int, choices=[1, 2, 3], help="Filter by model tier (1, 2, or 3)")
    parser.add_argument("--model", type=str, help="Substring filter for model name")
    parser.add_argument("--vram-mib", type=float, default=TOTAL_VRAM_MIB, help="Total usable VRAM in MiB (default: 59648)")
    parser.add_argument(
        "--overhead-mib",
        type=float,
        default=DEFAULT_CUDA_OVERHEAD_MIB,
        help="Total CUDA/compute buffer overhead across 4x T4 in MiB (default: 2048)",
    )
    parser.add_argument("--json", action="store_true", help="Emit machine-readable JSON output")
    args = parser.parse_args()

    selected = MODELS
    if args.tier is not None:
        selected = [m for m in selected if m.tier == args.tier]
    if args.model:
        q = args.model.lower()
        selected = [m for m in selected if q in m.name.lower()]

    results = [
        compute_model_metrics(m, args.ctx, args.vram_mib, args.overhead_mib)
        for m in selected
    ]

    if args.json:
        payload = {
            "cluster_hardware": {
                "gpu_nodes": "4x NVIDIA Tesla T4",
                "usable_vram_mib": args.vram_mib,
                "cuda_overhead_mib": args.overhead_mib,
                "locked_ddr4_gib": TOTAL_DDR4_GIB,
            },
            "ctx_per_slot": args.ctx,
            "models": results,
        }
        print(json.dumps(payload, indent=2))
    else:
        print_table(results, args.ctx, args.vram_mib, args.overhead_mib)

    return 0


if __name__ == "__main__":
    sys.exit(main())
