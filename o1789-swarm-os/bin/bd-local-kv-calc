#!/usr/bin/env python3
"""
bd-local-kv-calc: Exact KV-Cache VRAM & Max Concurrent Agent Slot (--parallel N) Calculator
Hardware Target:
  - 4x NVIDIA Tesla T4 GPUs = 59,648 MiB usable GDDR6 VRAM (4 x 14,912 MiB)
  - 27-Node Boylenet Cluster = 1,730 GiB (1,771,520 MiB) Locked DDR4 System RAM
Supports KV Cache Quantization Types: FP16 (2.0 B/elem), Q8_0 (1.0625 B/elem), Q4_0 (0.5625 B/elem)
Covers Tier 1 (Pure VRAM Dense/MoE), Tier 2 (Hybrid GPU+DDR4 MoE Offload), and Tier 3 (Cluster-Scale Giant Models).
"""

import argparse
import json
import math
import sys
from dataclasses import dataclass
from typing import Dict, List

# Hardware Constants
T4_COUNT = 4
T4_VRAM_PER_GPU_MIB = 14912.0
TOTAL_VRAM_MIB = 59648.0  # 4 x 14,912 MiB usable GDDR6
TOTAL_DDR4_GIB = 1730.0   # Locked DDR4 across cluster
TOTAL_DDR4_MIB = TOTAL_DDR4_GIB * 1024.0
DEFAULT_CUDA_OVERHEAD_MIB = 2048.0  # 512 MiB per GPU compute/scratch buffer

# GGML KV cache bytes per element (including block scale overhead for Q8_0/Q4_0 block_size=32)
# FP16: 2.0 bytes/elem
# Q8_0: 34 bytes / 32 elems = 1.0625 bytes/elem (or 1.0 nominal; we compute exact GGML block bytes)
# Q4_0: 18 bytes / 32 elems = 0.5625 bytes/elem
KV_TYPES: Dict[str, float] = {
    "FP16": 2.0,
    "Q8_0": 34.0 / 32.0,
    "Q4_0": 18.0 / 32.0,
}


@dataclass
class ModelSpec:
    name: str
    tier: int
    arch: str
    n_layers: int
    n_kv_heads: int
    head_dim: int
    is_mla: bool
    mla_elements_per_token: int  # If MLA (DeepSeek V2.5/V3/R1), elements per layer per token (e.g. 576)
    vram_weights_mib: float      # Resident weights + compute graph in 59,648 MiB GDDR6
    ddr4_weights_gib: float      # Offloaded expert/cold weights in 1,730 GiB Locked DDR4
    default_ctx_per_slot: int    # Standard per-slot context window (tokens)
    notes: str

    def kv_elements_per_token_per_layer(self) -> int:
        if self.is_mla:
            return self.mla_elements_per_token
        # Standard GQA: 2 (K and V) * n_kv_heads * head_dim
        return 2 * self.n_kv_heads * self.head_dim

    def kv_mib_per_1k_tokens(self, kv_type: str) -> float:
        bytes_per_elem = KV_TYPES[kv_type]
        elems_per_tok = self.n_layers * self.kv_elements_per_token_per_layer()
        bytes_per_1k = elems_per_tok * 1024.0 * bytes_per_elem
        return bytes_per_1k / (1024.0 * 1024.0)


