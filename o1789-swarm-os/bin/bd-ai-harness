def verify_argon4_pretool_hooks(run_live_probe: bool = False) -> Dict[str, Any]:
    """Verify ~/.claude/settings.json, ~/.codex/hooks.json, bd-token-guard.py, and shield.py."""
    claude_settings = os.path.expanduser("~/.claude/settings.json")
    codex_hooks = os.path.expanduser("~/.codex/hooks.json")
    codex_config = os.path.expanduser("~/.codex/config.toml")
    agy_hooks = os.path.expanduser("~/.gemini/config/hooks.json")

    checks: Dict[str, Any] = {
        "claude_settings_path": claude_settings,
        "codex_hooks_path": codex_hooks,
        "codex_config_path": codex_config,
        "agy_hooks_path": agy_hooks,
        "shield_py_path": SHIELD_SCRIPT,
        "bd_token_guard_path": TOKEN_GUARD_SCRIPT,
        "mcp_bridge_path": MCP_BRIDGE_SCRIPT,
        "mcp_tools_enabled": [
            t["function"]["name"] for t in bd_local_mcp_bridge.FLEET_MCP_TOOLS_OPENAI
        ],
        "web_tools_enabled": ["web_search", "web_fetch"],
    }

    try:
        with open(claude_settings, "r", encoding="utf-8") as f:
            c_txt = f.read()
        checks["claude_shield_active"] = "shield.py" in c_txt
        checks["claude_token_guard_active"] = "bd-token-guard-hook.py" in c_txt
    except Exception:
        checks["claude_shield_active"] = False
        checks["claude_token_guard_active"] = False

    try:
        with open(codex_hooks, "r", encoding="utf-8") as f:
            cx_txt = f.read()
        checks["codex_shield_active"] = "shield.py" in cx_txt
        checks["codex_token_guard_active"] = "bd-token-guard-hook.py" in cx_txt
    except Exception:
        checks["codex_shield_active"] = False
        checks["codex_token_guard_active"] = False

    try:
        with open(codex_config, "r", encoding="utf-8") as f:
            cxc_txt = f.read()
        checks["codex_boylenet_provider_configured"] = (
            "[model_providers.boylenet]" in cxc_txt
        )
    except Exception:
        checks["codex_boylenet_provider_configured"] = False

    try:
        with open(agy_hooks, "r", encoding="utf-8") as f:
            ag_txt = f.read()
        checks["agy_shield_active"] = "shield.py" in ag_txt
    except Exception:
        checks["agy_shield_active"] = False

    checks["shield_py_exists"] = os.path.isfile(SHIELD_SCRIPT)
    checks["bd_token_guard_exists"] = os.path.isfile(TOKEN_GUARD_SCRIPT)

    if run_live_probe:
        probe_shield_payload = json.dumps(
            {
                "tool_name": "Bash",
                "tool_input": {"command": "git checkout -- ."},
                "cwd": "/home/mboyle/BulkDownloader",
            }
        )
        p_shield = subprocess.run(
            ["python3", SHIELD_SCRIPT],
            input=probe_shield_payload,
            capture_output=True,
            text=True,
            timeout=10,
            check=False,
        )
        checks["shield_live_block_rc"] = p_shield.returncode
        checks["shield_live_block_verified"] = p_shield.returncode == 2

        probe_tg_payload = json.dumps(
            {
                "tool_name": "Bash",
                "tool_input": {"command": "pytest tests/"},
                "cwd": "/home/mboyle/BulkDownloader",
            }
        )
        p_tg = subprocess.run(
            ["python3", TOKEN_GUARD_SCRIPT, "hook"],
            input=probe_tg_payload,
            capture_output=True,
            text=True,
            timeout=10,
            check=False,
        )
        checks["token_guard_live_block_rc"] = p_tg.returncode
        checks["token_guard_live_block_verified"] = p_tg.returncode == 2

    all_ok = (
        checks["claude_shield_active"]
        and checks["claude_token_guard_active"]
        and checks["codex_shield_active"]
        and checks["codex_token_guard_active"]
        and checks["codex_boylenet_provider_configured"]
        and checks["agy_shield_active"]
        and checks["shield_py_exists"]
        and checks["bd_token_guard_exists"]
    )
    if run_live_probe:
        all_ok = (
            all_ok
            and checks["shield_live_block_verified"]
            and checks["token_guard_live_block_verified"]
        )

    return {
        "argon4_enforced": all_ok,
        "system_prompt_contract": ARGON4_SYSTEM_PROMPT,
        "checks": checks,
    }


def enforce_pretool_hooks_on_tool_call(
    tool_name: str, tool_args: Dict[str, Any]
) -> Tuple[bool, str]:
    """Run shield.py and bd-token-guard.py before executing any local tool in hermes/agent loops."""
    cwd = os.getcwd()
    if tool_name == "bash_exec":
        cmd = str(tool_args.get("command", ""))
        hook_payload = json.dumps(
            {
                "tool_name": "Bash",
                "tool_input": {"command": cmd},
                "cwd": cwd,
            }
        )
        if os.path.isfile(SHIELD_SCRIPT):
            p_s = subprocess.run(
                ["python3", SHIELD_SCRIPT],
                input=hook_payload,
                capture_output=True,
                text=True,
                timeout=10,
                check=False,
            )
            if p_s.returncode != 0:
                return (
                    False,
                    f"[Argon-4 shield.py BLOCKED (rc={p_s.returncode})]: {p_s.stderr.strip() or p_s.stdout.strip()}",
                )
        if os.path.isfile(TOKEN_GUARD_SCRIPT):
            p_t = subprocess.run(
                ["python3", TOKEN_GUARD_SCRIPT, "hook"],
                input=hook_payload,
                capture_output=True,
                text=True,
                timeout=10,
                check=False,
            )
            if p_t.returncode != 0:
                return (
                    False,
                    f"[Argon-4 bd-token-guard.py BLOCKED (rc={p_t.returncode})]: {p_t.stderr.strip() or p_t.stdout.strip()}",
                )
    elif tool_name == "read_file":
        path = str(tool_args.get("path", ""))
        max_lines = int(tool_args.get("max_lines", 100))
        hook_payload = json.dumps(
            {
                "tool_name": "Read",
                "tool_input": {
                    "file_path": path,
                    "StartLine": 1,
                    "EndLine": min(max_lines, 100),
                },
                "cwd": cwd,
            }
        )
        if os.path.isfile(TOKEN_GUARD_SCRIPT):
            p_t = subprocess.run(
                ["python3", TOKEN_GUARD_SCRIPT, "hook"],
                input=hook_payload,
                capture_output=True,
                text=True,
                timeout=10,
                check=False,
            )
            if p_t.returncode != 0:
                return (
                    False,
                    f"[Argon-4 bd-token-guard.py BLOCKED (rc={p_t.returncode})]: {p_t.stderr.strip() or p_t.stdout.strip()}",
                )
    return True, "ALLOWED"


def resolve_model(harness: str, tier: str, explicit_model: Optional[str]) -> str:
    if explicit_model:
        if harness == "deepseek" and explicit_model in DEEPSEEK_MODEL_MAP:
            return DEEPSEEK_MODEL_MAP[explicit_model]
        return explicit_model
    if harness == "deepseek":
        if tier == "tier1":
            return "tier1-deepseek-v4-flash-bf16"
        if tier == "tier2":
            return "tier2-deepseek-r1-70b"
        if tier == "tier3":
            return "tier3-deepseek-v3-671b"
        return "tier1-deepseek-v4-flash-bf16"
    return TIER_DEFAULT_MODELS.get(tier, "tier1-qwen3-coder-30b-a3b")


def http_request_json(
    url: str,
    method: str = "GET",
    payload: Optional[Dict[str, Any]] = None,
    headers: Optional[Dict[str, str]] = None,
    timeout: float = 180.0,
) -> Tuple[int, Dict[str, str], Dict[str, Any]]:
    req_headers = {"Content-Type": "application/json", "Connection": "close"}
    if headers:
        req_headers.update(headers)
    data = json.dumps(payload).encode("utf-8") if payload is not None else None
    for attempt in range(3):
        req = urllib.request.Request(url, data=data, headers=req_headers, method=method)
        try:
            with urllib.request.urlopen(req, timeout=timeout) as resp:
                resp_headers = {k.lower(): v for k, v in resp.getheaders()}
                body_bytes = resp.read()
                body_json = json.loads(body_bytes.decode("utf-8")) if body_bytes else {}
                return resp.status, resp_headers, body_json
        except urllib.error.HTTPError as exc:
            err_bytes = exc.read() if exc.fp else b""
            try:
                err_json = (
                    json.loads(err_bytes.decode("utf-8", errors="replace"))
                    if err_bytes
                    else {"error": str(exc)}
                )
            except Exception:
                err_json = {
                    "error": err_bytes.decode("utf-8", errors="replace") or str(exc)
                }
            if (
                attempt == 0
                and exc.code in (502, 503, 504)
                and "/chat/completions" in url
            ):
                model_req = str((payload or {}).get("model", ""))
                heal_tier = (
                    "tier2"
                    if model_req.startswith("tier2")
                    else ("tier3" if model_req.startswith("tier3") else "tier1")
                )
                print(
                    f"[bd-ai-harness] Backend HTTP {exc.code} on {url}; auto-healing {heal_tier} pool via bd-tier-switch...",
                    file=sys.stderr,
                )
                subprocess.run(
                    ["/home/mboyle/bin/bd-tier-switch", heal_tier], check=False
                )
                continue
            return exc.code, dict(exc.headers.items()) if exc.headers else {}, err_json
        except (urllib.error.URLError, OSError) as exc:
            if attempt < 2:
                time.sleep(0.5)
                continue
            return 502, {}, {"error": str(exc)}
    return 502, {}, {"error": "Exhausted retries"}


def maybe_switch_tier(tier: str, model: Optional[str], do_switch: bool) -> None:
    if not do_switch:
        return
    cmd = ["/home/mboyle/bin/bd-tier-switch", tier]
    if model:
        cmd.append(model)
    subprocess.run(cmd, check=True)


# ---------------------------------------------------------------------------
# LIVE WEB SEARCH & LIVE WEB FETCH IMPLEMENTATIONS
# ---------------------------------------------------------------------------
def html_to_clean_text(raw_html: str, max_chars: int = 4000) -> str:
    cleaned = re.sub(r"(?is)<(script|style|noscript).*?>.*?</\1>", " ", raw_html)
    cleaned = re.sub(r"(?s)<[^>]+>", " ", cleaned)
    cleaned = html.unescape(cleaned)
    cleaned = re.sub(r"[ \t\r\f\v]+", " ", cleaned)
    cleaned = re.sub(r"\n\s*\n+", "\n", cleaned).strip()
    return cleaned[:max_chars]


def execute_web_fetch(url: str, max_chars: int = 4000) -> Dict[str, Any]:
    req = urllib.request.Request(
        url,
        headers={
            "User-Agent": "Mozilla/5.0 (X11; Linux x86_64) BoylenetAIHarness/2.0",
            "Accept": "text/html,application/json,text/plain,*/*",
        },
        method="GET",
    )
    with urllib.request.urlopen(req, timeout=15.0) as resp:
        ctype = resp.headers.get("Content-Type", "")
        raw_bytes = resp.read(256 * 1024)
        raw_text = raw_bytes.decode("utf-8", errors="replace")
        if "html" in ctype.lower() or "<html" in raw_text[:500].lower():
            title_m = re.search(r"(?is)<title[^>]*>(.*?)</title>", raw_text)
            title = html.unescape(title_m.group(1).strip()) if title_m else ""
            text_out = html_to_clean_text(raw_text, max_chars=max_chars)
        else:
            title = ""
            text_out = raw_text[:max_chars]
        return {
            "rc": 0,
            "status_code": resp.status,
            "url": url,
            "content_type": ctype,
            "title": title,
            "content": text_out,
        }


def execute_web_search(query: str, max_results: int = 5) -> Dict[str, Any]:
    results: List[Dict[str, str]] = []
    # Primary: DuckDuckGo HTML endpoint
    try:
        q_enc = urllib.parse.urlencode({"q": query})
        ddg_url = f"https://html.duckduckgo.com/html/?{q_enc}"
        req = urllib.request.Request(
            ddg_url,
            headers={
                "User-Agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 Chrome/126.0.0.0 Safari/537.36"
            },
        )
        with urllib.request.urlopen(req, timeout=12.0) as resp:
            page = resp.read().decode("utf-8", errors="replace")
        blocks = re.findall(
            r'<a rel="nofollow" class="result__a" href="([^"]+)">(.*?)</a>.*?<a class="result__snippet"[^>]*>(.*?)</a>',
            page,
            flags=re.DOTALL,
        )
        for href, raw_title, raw_snip in blocks[:max_results]:
            # Unwrap uddg redirect if present
            parsed_href = urllib.parse.urlparse(href)
            qs = urllib.parse.parse_qs(parsed_href.query)
            real_url = qs.get("uddg", [href])[0]
            results.append(
                {
                    "title": html_to_clean_text(raw_title, 200),
                    "url": real_url,
                    "snippet": html_to_clean_text(raw_snip, 400),
                }
            )
    except Exception:
        pass

    # Fallback / supplement: Wikipedia OpenSearch + MediaWiki API if results are empty
    if not results:
        try:
            wiki_q = urllib.parse.urlencode(
                {
                    "action": "query",
                    "list": "search",
                    "srsearch": query,
                    "format": "json",
                    "srlimit": str(max_results),
                }
            )
            wiki_url = f"https://en.wikipedia.org/w/api.php?{wiki_q}"
            req = urllib.request.Request(
                wiki_url,
                headers={
                    "User-Agent": "BoylenetAIHarness/2.0 (https://boylenet.local)"
                },
            )
            with urllib.request.urlopen(req, timeout=10.0) as resp:
                wdata = json.loads(resp.read().decode("utf-8"))
            for item in wdata.get("query", {}).get("search", [])[:max_results]:
                title = item.get("title", "")
                results.append(
                    {
                        "title": title,
                        "url": f"https://en.wikipedia.org/wiki/{urllib.parse.quote(title.replace(' ', '_'))}",
                        "snippet": html_to_clean_text(item.get("snippet", ""), 400),
                    }
                )
        except Exception as exc:
            return {"rc": 1, "query": query, "error": str(exc), "results": []}

    return {
        "rc": 0,
        "query": query,
        "result_count": len(results),
        "results": results,
    }


# ---------------------------------------------------------------------------
# 1. CLAUDE CODE HARNESS (--harness claude / bd-claude-local)
# ---------------------------------------------------------------------------
def run_harness_claude(
    tier: str,
    model: Optional[str],
    prompt: Optional[str],
    print_env: bool,
    extra_args: List[str],
    skills: Optional[List[str]] = None,
) -> int:
    selected_model = resolve_model("claude", tier, model)
    argon_status = verify_argon4_pretool_hooks(run_live_probe=False)
    skill_block, skill_receipts = bd_local_mcp_bridge.build_skill_injection_block(
        skills, prompt=prompt
    )
    effective_sys = ARGON4_SYSTEM_PROMPT + skill_block
    env = os.environ.copy()
    env["ANTHROPIC_BASE_URL"] = LITELLM_BASE
    env["ANTHROPIC_AUTH_TOKEN"] = DEFAULT_API_KEY
    env["ANTHROPIC_API_KEY"] = DEFAULT_API_KEY
    env["ANTHROPIC_MODEL"] = selected_model
    env["BD_ARGON4_CONTRACT"] = effective_sys

    if print_env:
        print(f"export ANTHROPIC_BASE_URL={env['ANTHROPIC_BASE_URL']}")
        print(f"export ANTHROPIC_AUTH_TOKEN={env['ANTHROPIC_AUTH_TOKEN']}")
        print(f"export ANTHROPIC_MODEL={env['ANTHROPIC_MODEL']}")
        print(f"export BD_ARGON4_CONTRACT={json.dumps(effective_sys)}")
        print(
            f"# Argon-4 PreToolUse Hooks Active: {argon_status['argon4_enforced']} (~/.claude/settings.json)"
        )
        print(f"# Loaded Skills: {json.dumps(skill_receipts)}")
        print("# Live Web & Fleet MCP Tools: enabled")
        return 0

    if prompt and "--api-messages" in extra_args:
        url = f"{LITELLM_BASE}/v1/messages"
        headers = {
            "x-api-key": DEFAULT_API_KEY,
            "Authorization": f"Bearer {DEFAULT_API_KEY}",
            "anthropic-version": "2023-06-01",
        }
        payload: Dict[str, Any] = {
            "model": selected_model,
            "max_tokens": 512,
            "system": effective_sys,
            "messages": [{"role": "user", "content": prompt}],
        }
        status, _, resp_json = http_request_json(
            url, method="POST", payload=payload, headers=headers
        )
        if skill_receipts:
            resp_json["skills_loaded"] = skill_receipts
        print(json.dumps(resp_json, indent=2))
        return 0 if status == 200 else 1

    claude_bin = shutil.which("claude") or "/home/mboyle/.local/bin/claude"
    cmd = [
        claude_bin,
        "--model",
        selected_model,
        "--append-system-prompt",
        effective_sys,
        "--allowedTools",
        "Bash,Read,Edit,Write,WebSearch,WebFetch",
    ]
    if prompt:
        cmd.extend(["-p", prompt])
    cmd.extend([a for a in extra_args if a != "--api-messages"])
    print(
        f"[bd-claude-local] Launching Claude Code -> ANTHROPIC_BASE_URL={env['ANTHROPIC_BASE_URL']} "
        f"ANTHROPIC_MODEL={selected_model} | Argon-4 Hooks={argon_status['argon4_enforced']} "
        f"| Skills={[r['skill'] for r in skill_receipts]} | WebTools=ENABLED",
        file=sys.stderr,
    )
    proc = subprocess.run(cmd, env=env, check=False)
    return proc.returncode


# ---------------------------------------------------------------------------
# 2. CODEX HARNESS (--harness codex / bd-codex-local)
# ---------------------------------------------------------------------------
def run_harness_codex(
    tier: str,
    model: Optional[str],
    prompt: Optional[str],
    print_env: bool,
    extra_args: List[str],
    skills: Optional[List[str]] = None,
) -> int:
    selected_model = resolve_model("codex", tier, model)
    argon_status = verify_argon4_pretool_hooks(run_live_probe=False)
    skill_block, skill_receipts = bd_local_mcp_bridge.build_skill_injection_block(
        skills, prompt=prompt
    )
    effective_sys = ARGON4_SYSTEM_PROMPT + skill_block
    env = os.environ.copy()
    env["OPENAI_BASE_URL"] = f"{LITELLM_BASE}/v1"
    env["BOYLENET_ORCHESTRATOR_V1"] = f"{ORCHESTRATOR_BASE}/v1"
    env["OPENAI_API_KEY"] = DEFAULT_API_KEY
    env["OPENAI_MODEL"] = selected_model
    env["BD_ARGON4_CONTRACT"] = effective_sys

    if print_env:
        print(f"export OPENAI_BASE_URL={env['OPENAI_BASE_URL']}")
        print(f"export BOYLENET_ORCHESTRATOR_V1={env['BOYLENET_ORCHESTRATOR_V1']}")
        print(f"export OPENAI_API_KEY={env['OPENAI_API_KEY']}")
        print(f"export OPENAI_MODEL={env['OPENAI_MODEL']}")
        print(f"export BD_ARGON4_CONTRACT={json.dumps(effective_sys)}")
        print(f"# Loaded Skills: {json.dumps(skill_receipts)}")
        print(
            f'# Codex Local Provider: model_provider="boylenet" ({ORCHESTRATOR_BASE}/v1) & '
            f'"boylenet_litellm" ({LITELLM_BASE}/v1) | sandbox=danger-full-access | web_search=enabled'
        )
        print(
            f"# Argon-4 PreToolUse Hooks Active: {argon_status['argon4_enforced']} (~/.codex/hooks.json)"
        )
        return 0

    if prompt and ("--api-chat" in extra_args or "--non-interactive" in extra_args):
        return run_harness_hermes(
            tier, selected_model, prompt, max_steps=5, skills=skills
        )

    codex_bin = shutil.which("codex") or "/home/mboyle/.local/bin/codex"
    cmd = [
        codex_bin,
        "-c",
        'model_provider="boylenet"',
        "-m",
        selected_model,
        "-s",
        "danger-full-access",
        "--search",
        "-c",
        f"developer_instructions={json.dumps(effective_sys)}",
    ]
    if prompt:
        cmd.extend(["exec", prompt])
    cmd.extend([a for a in extra_args if a not in ("--api-chat", "--non-interactive")])
    print(
        f"[bd-codex-local] Launching Codex -> model_provider=boylenet ({ORCHESTRATOR_BASE}/v1) "
        f"OPENAI_BASE_URL={env['OPENAI_BASE_URL']} MODEL={selected_model} "
        f"| Argon-4 Hooks={argon_status['argon4_enforced']} | Skills={[r['skill'] for r in skill_receipts]} | WebSearch=ENABLED",
        file=sys.stderr,
    )
    proc = subprocess.run(cmd, env=env, check=False)
    return proc.returncode


