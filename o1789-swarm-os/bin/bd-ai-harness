def run_harness_opencode(
    tier: str,
    model: Optional[str],
    prompt: Optional[str],
    print_env: bool,
    extra_args: List[str],
    skills: Optional[List[str]] = None,
) -> int:
    selected_model = resolve_model("opencode", tier, model)
    skill_block, skill_receipts = bd_local_mcp_bridge.build_skill_injection_block(
        skills, prompt=prompt
    )
    effective_sys = ARGON4_SYSTEM_PROMPT + skill_block
    cfg_path = configure_opencode_provider(
        selected_model, instructions_list=[effective_sys]
    )
    argon_status = verify_argon4_pretool_hooks(run_live_probe=False)
    env = os.environ.copy()
    env["OPENAI_BASE_URL"] = f"{LITELLM_BASE}/v1"
    env["OPENAI_API_BASE"] = f"{LITELLM_BASE}/v1"
    env["OPENAI_API_KEY"] = DEFAULT_API_KEY
    env["BOYLENET_ORCHESTRATOR_V1"] = f"{ORCHESTRATOR_BASE}/v1"
    env["OPENCODE_CONFIG"] = cfg_path
    env["BD_ARGON4_CONTRACT"] = effective_sys

    if print_env:
        print(f"export OPENAI_BASE_URL={env['OPENAI_BASE_URL']}")
        print(f"export OPENAI_API_BASE={env['OPENAI_API_BASE']}")
        print(f"export OPENAI_API_KEY={env['OPENAI_API_KEY']}")
        print(f"export BOYLENET_ORCHESTRATOR_V1={env['BOYLENET_ORCHESTRATOR_V1']}")
        print(f"export OPENCODE_CONFIG={cfg_path}")
        print(f"export BD_ARGON4_CONTRACT={json.dumps(effective_sys)}")
        print(f"# Loaded Skills: {json.dumps(skill_receipts)}")
        return 0

    print(
        f"[bd-opencode-local] Configured OpenCode/Aider/Continue local provider -> {cfg_path}\n"
        f"  LiteLLM Gateway     : {LITELLM_BASE}/v1\n"
        f"  Orchestrator Direct : {ORCHESTRATOR_BASE}/v1\n"
        f"  Selected Model      : {selected_model}\n"
        f"  Argon-4 Contract    : ENFORCED (hooks_verified={argon_status['argon4_enforced']})\n"
        f"  Loaded Skills       : {[r['skill'] for r in skill_receipts]}\n"
        f"  Fleet MCP & Web     : {len(bd_local_mcp_bridge.FLEET_MCP_TOOLS_OPENAI)} TOOLS ENABLED"
    )

    if prompt:
        return run_harness_hermes(
            tier, selected_model, prompt, max_steps=5, skills=skills
        )

    opencode_bin = shutil.which("opencode") or shutil.which("aider")
    if opencode_bin:
        proc = subprocess.run([opencode_bin] + extra_args, env=env, check=False)
        return proc.returncode
    return 0


