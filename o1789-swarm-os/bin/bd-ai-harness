FLEET_TOOLS_SCHEMA: List[Dict[str, Any]] = list(
    bd_local_mcp_bridge.FLEET_MCP_TOOLS_OPENAI
)
if not any(
    t.get("function", {}).get("name") == "bd_semantic_search"
    for t in FLEET_TOOLS_SCHEMA
):
    FLEET_TOOLS_SCHEMA.append(
        {
            "type": "function",
            "function": {
                "name": "bd_semantic_search",
                "description": "Fleet-Wide Hybrid RAG + AST Semantic Search on Qdrant (10.0.70.125:6333, collection boylenet_fleet_rag) + TEI BGE Embeddings (:8081) + TEI BGE-Reranker-Large (:8082).",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "query": {
                            "type": "string",
                            "description": "Natural language or technical search query.",
                        },
                        "top_k": {
                            "type": "integer",
                            "description": "Number of top reranked results to return (default 5).",
                        },
                        "collection": {
                            "type": "string",
                            "description": "Optional Qdrant collection name (default 'boylenet_fleet_rag').",
                        },
                    },
                    "required": ["query"],
                },
            },
        }
    )
AGENT_TOOLS_SCHEMA: List[Dict[str, Any]] = FLEET_TOOLS_SCHEMA


def execute_fleet_tool(name: str, args: Dict[str, Any]) -> str:
    clean_name = (name or "").strip()
    if clean_name in ("bd_semantic_search", "semantic_search"):
        q = str(args.get("query") or "").strip()
        top_k = int(args.get("top_k") or args.get("limit") or 5)
        collection = str(args.get("collection") or "boylenet_fleet_rag").strip()
        if not q:
            return json.dumps(
                {"rc": 1, "tool": "bd_semantic_search", "error": "query is required"}
            )
        proc = subprocess.run(
            [
                "python3",
                "/home/mboyle/bin/bd-semantic-search",
                q,
                "--top-k",
                str(top_k),
                "--collection",
                collection,
                "--json",
            ],
            capture_output=True,
            text=True,
            timeout=45,
            check=False,
        )
        if proc.returncode == 0 and proc.stdout.strip():
            return proc.stdout.strip()
        return json.dumps(
            {
                "rc": proc.returncode or 1,
                "tool": "bd_semantic_search",
                "error": (proc.stderr or proc.stdout).strip(),
            }
        )
    return json.dumps(bd_local_mcp_bridge.execute_mcp_tool(clean_name, args))


def execute_agent_tool(name: str, args: Dict[str, Any]) -> str:
    return execute_fleet_tool(name, args)


def parse_xml_tool_calls(text: str) -> List[Dict[str, Any]]:
    """Fallback parser for Hermes/Qwen <tool_call>{...}</tool_call> tags."""
    matches = re.findall(
        r"<tool_call>\s*(\{.*?\})\s*</tool_call>", text, flags=re.DOTALL
    )
    calls: List[Dict[str, Any]] = []
    for idx, m in enumerate(matches):
        try:
            obj = json.loads(m)
            if "name" in obj:
                calls.append(
                    {
                        "id": f"call_xml_{idx}",
                        "type": "function",
                        "function": {
                            "name": obj["name"],
                            "arguments": json.dumps(
                                obj.get("arguments", obj.get("args", {}))
                            ),
                        },
                    }
                )
        except Exception:
            pass
    return calls


def run_hermes_turn(
    messages: List[Dict[str, Any]],
    selected_model: str,
    gateway_url: str,
    max_steps: int = 5,
    tool_subset: Optional[List[str]] = None,
    skill_receipts: Optional[List[Dict[str, Any]]] = None,
) -> int:
    headers = {"Authorization": f"Bearer {DEFAULT_API_KEY}"}
    active_tools = bd_local_mcp_bridge.get_openai_tools_schema(tool_subset)
    loaded_skill_names = [
        r["skill"] for r in (skill_receipts or []) if r.get("rc") == 0
    ]
    for step in range(1, max_steps + 1):
        payload: Dict[str, Any] = {
            "model": selected_model,
            "messages": messages,
            "tools": active_tools,
            "tool_choice": "auto",
            "temperature": 0.1,
            "max_tokens": 1024,
        }
        t0 = time.time()
        status, resp_headers, resp_json = http_request_json(
            f"{gateway_url}/chat/completions",
            method="POST",
            payload=payload,
            headers=headers,
            timeout=180.0,
        )
        elapsed = time.time() - t0
        if status != 200:
            print(f"[bd-hermes-local] HTTP {status}: {resp_json}", file=sys.stderr)
            return 1

        choice = (resp_json.get("choices") or [{}])[0]
        msg = choice.get("message") or {}
        content = msg.get("content") or ""
        tool_calls = msg.get("tool_calls") or parse_xml_tool_calls(content)

        tier_hdr = resp_headers.get("x-orchestrator-tier", "")
        model_hdr = resp_headers.get("x-orchestrator-model", selected_model)
        usage = resp_json.get("usage", {})
        comp_tokens = usage.get("completion_tokens", 0)
        tok_s = (comp_tokens / elapsed) if elapsed > 0 and comp_tokens else 0.0

        print(
            f"[bd-hermes-local step={step}] model={model_hdr} tier={tier_hdr or 'local'} "
            f"elapsed={elapsed:.2f}s tokens={comp_tokens} ({tok_s:.1f} tok/s) "
            f"| argon4=ENFORCED | mcp_tools={len(active_tools)} | skills={loaded_skill_names}"
        )

        if not tool_calls:
            print("\n=== HERMES AGENT FINAL RESPONSE ===")
            print(content.strip())
            messages.append({"role": "assistant", "content": content})
            return 0

        messages.append(
            {
                "role": "assistant",
                "content": content if content else None,
                "tool_calls": tool_calls,
            }
        )
        for tc in tool_calls:
            fn = tc.get("function", {})
            fn_name = fn.get("name", "")
            raw_args = fn.get("arguments", "{}")
            try:
                parsed_args = (
                    json.loads(raw_args) if isinstance(raw_args, str) else raw_args
                )
            except Exception:
                parsed_args = {}
            print(f"  -> [TOOL CALL] {fn_name}({json.dumps(parsed_args)})")
            tool_out = execute_agent_tool(fn_name, parsed_args)
            print(f"  <- [TOOL RESULT] {tool_out[:600]}")
            messages.append(
                {
                    "role": "tool",
                    "tool_call_id": tc.get("id", "call_0"),
                    "name": fn_name,
                    "content": tool_out,
                }
            )
    return 0


def run_harness_hermes(
    tier: str,
    model: Optional[str],
    prompt: Optional[str],
    max_steps: int = 5,
    skills: Optional[List[str]] = None,
    tool_subset: Optional[List[str]] = None,
) -> int:
    selected_model = resolve_model("hermes", tier, model)
    gateway_url = f"{ORCHESTRATOR_BASE}/v1"
    skill_block, skill_receipts = bd_local_mcp_bridge.build_skill_injection_block(
        skills, prompt=prompt
    )
    tool_names = [
        t["function"]["name"]
        for t in bd_local_mcp_bridge.get_openai_tools_schema(tool_subset)
    ]
    if skill_receipts:
        print(f"[bd-ai-harness] Fleet Skills Injected: {json.dumps(skill_receipts)}")
    sys_msg = {
        "role": "system",
        "content": (
            f"{ARGON4_SYSTEM_PROMPT}\n"
            "You are a Boylenet Local Coding Agent on the 4-GPU + 1.73 TB DDR4 cluster with full Fleet MCP parity. "
            f"Use the provided tools ({', '.join(tool_names)}) whenever you need to slice AST symbols/lines, "
            "run ruff/mypy/pytest-digest, read/publish on bd-bus, recall/store in hivemind-memory, "
            "search/fetch the web, or run guarded bash/edit commands."
            f"{skill_block}"
        ),
    }
    messages: List[Dict[str, Any]] = [sys_msg]

    if prompt:
        messages.append({"role": "user", "content": prompt})
        return run_hermes_turn(
            messages,
            selected_model,
            gateway_url,
            max_steps=max_steps,
            tool_subset=tool_subset,
            skill_receipts=skill_receipts,
        )

    print(
        f"[bd-hermes-local] Interactive Agentic Tool REPL (tier={tier}, model={selected_model}, "
        f"Argon-4=ENFORCED, MCPTools={len(tool_names)}, Skills={[r['skill'] for r in skill_receipts]}). Type '/exit' or 'exit' to quit.",
        flush=True,
    )
    while True:
        try:
            user_in = input("\nhermes> ").strip()
        except EOFError:
            break
        if not user_in:
            continue
        if user_in.lower() in ("exit", "quit", "/exit", "/quit"):
            print("[bd-hermes-local] Session retired cleanly (/exit).", flush=True)
            break
        messages.append({"role": "user", "content": user_in})
        run_hermes_turn(
            messages,
            selected_model,
            gateway_url,
            max_steps=max_steps,
            tool_subset=tool_subset,
            skill_receipts=skill_receipts,
        )
    return 0


# ---------------------------------------------------------------------------
# 5. DEEPSEEK <think> REASONING + CODE RUNNER (bd-deepseek-local)
# ---------------------------------------------------------------------------
def extract_thinking_and_answer(msg: Dict[str, Any]) -> Tuple[str, str]:
    reasoning = str(msg.get("reasoning_content") or "").strip()
    content = str(msg.get("content") or "")
    for pat in (r"<think>(.*?)</think>", r"\[THINK\](.*?)\[/THINK\]"):
        m = re.search(pat, content, flags=re.DOTALL | re.IGNORECASE)
        if m:
            extracted = m.group(1).strip()
            reasoning = (
                (reasoning + "\n" + extracted).strip() if reasoning else extracted
            )
            content = (content[: m.start()] + content[m.end() :]).strip()
            break
    else:
        if "</think>" in content:
            parts = content.split("</think>", 1)
            extracted = parts[0].replace("<think>", "").strip()
            reasoning = (
                (reasoning + "\n" + extracted).strip() if reasoning else extracted
            )
            content = parts[1].strip()
    return reasoning, content.strip()


def run_harness_deepseek(
    tier: str,
    model: Optional[str],
    prompt: Optional[str],
    skills: Optional[List[str]] = None,
) -> int:
    selected_model = resolve_model("deepseek", tier, model)
    gateway_url = f"{ORCHESTRATOR_BASE}/v1"
    user_prompt = (
        prompt
        or "Write a fast Python function to compute the nth Fibonacci number in O(log n) matrix exponentiation and prove its time complexity."
    )
    skill_block, skill_receipts = bd_local_mcp_bridge.build_skill_injection_block(
        skills, prompt=user_prompt
    )

    messages = [
        {
            "role": "system",
            "content": (
                f"{ARGON4_SYSTEM_PROMPT}\n"
                "You are a DeepSeek reasoning and coding engine running locally on Boylenet. "
                "Always enclose your concise step-by-step mathematical and architectural reasoning inside "
                "[THINK]...[/THINK] (or <think>...</think>) tags first, followed by your clean final code."
                f"{skill_block}"
            ),
        },
        {"role": "user", "content": user_prompt},
    ]
    payload = {
        "model": selected_model,
        "messages": messages,
        "temperature": 0.2,
        "max_tokens": 1024,
    }
    headers = {"Authorization": f"Bearer {DEFAULT_API_KEY}"}
    t0 = time.time()
    status, resp_headers, resp_json = http_request_json(
        f"{gateway_url}/chat/completions",
        method="POST",
        payload=payload,
        headers=headers,
        timeout=240.0,
    )
    elapsed = time.time() - t0
    if status != 200:
        print(f"[bd-deepseek-local] HTTP {status}: {resp_json}", file=sys.stderr)
        return 1

    choice = (resp_json.get("choices") or [{}])[0]
    msg = choice.get("message") or {}
    reasoning, final_answer = extract_thinking_and_answer(msg)
    usage = resp_json.get("usage", {})
    comp_tokens = usage.get("completion_tokens", 0)
    tok_s = (comp_tokens / elapsed) if elapsed > 0 and comp_tokens else 0.0
    routing = resp_json.get("orchestrator_routing", {})

    print("=" * 96)
    print(
        f" [bd-deepseek-local] Model: {selected_model} | Effective Tier: {routing.get('effective_tier', tier)} "
        f"| Speed: {tok_s:.2f} tok/s ({comp_tokens} tokens in {elapsed:.2f}s) | Argon-4: ENFORCED "
        f"| Skills: {[r['skill'] for r in skill_receipts]}"
    )
    print("=" * 96)
    if reasoning:
        print(
            "\n┌─── [DEEPSEEK <think> REASONING TRACE] ───────────────────────────────────────────────────┐"
        )
        for line in reasoning.splitlines():
            print(f"│ {line}")
        print(
            "└──────────────────────────────────────────────────────────────────────────────────────────┘"
        )
    print("\n=== [DEEPSEEK CODE & SOLUTION OUTPUT] ===")
    print(final_answer)
    return 0


# ---------------------------------------------------------------------------
# 6. OPENROUTER LOCAL GATEWAY HARNESS (bd-openrouter-local)
# ---------------------------------------------------------------------------
def run_harness_openrouter(
    tier: str,
    model: Optional[str],
    prompt: Optional[str],
    list_models: bool = False,
    skills: Optional[List[str]] = None,
) -> int:
    selected_model = resolve_model(
        "openrouter", tier, model or ("auto-local" if tier == "auto" else None)
    )
    headers = {
        "Authorization": f"Bearer {DEFAULT_API_KEY}",
        "HTTP-Referer": "https://jarvis.boylenet.local",
        "X-Title": "Boylenet Multi-Harness CLI (Argon-4)",
    }

    if list_models or not prompt:
        status_o, _, models_o = http_request_json(
            f"{ORCHESTRATOR_BASE}/v1/models",
            method="GET",
            headers=headers,
            timeout=10.0,
        )
        print(
            f"[bd-openrouter-local] Orchestrator /v1/models ({ORCHESTRATOR_BASE}/v1/models) — "
            f"{len(models_o.get('data', []))} models available:"
        )
        for m in models_o.get("data", []):
            print(
                f"  - {m.get('id'):<32} | tier={str(m.get('tier')):<6} | measured_tok_s={m.get('measured_tok_s')}"
            )
        if not prompt:
            return 0 if status_o == 200 else 1

    skill_block, skill_receipts = bd_local_mcp_bridge.build_skill_injection_block(
        skills, prompt=prompt
    )
    payload = {
        "model": selected_model,
        "messages": [
            {"role": "system", "content": ARGON4_SYSTEM_PROMPT + skill_block},
            {"role": "user", "content": prompt},
        ],
        "temperature": 0.1,
        "max_tokens": 512,
    }
    t0 = time.time()
    status, resp_headers, resp_json = http_request_json(
        f"{ORCHESTRATOR_BASE}/v1/chat/completions",
        method="POST",
        payload=payload,
        headers=headers,
        timeout=180.0,
    )
    elapsed = time.time() - t0
    if status != 200:
        print(f"[bd-openrouter-local] HTTP {status}: {resp_json}", file=sys.stderr)
        return 1

    routing = resp_json.get("orchestrator_routing", {})
    choice = (resp_json.get("choices") or [{}])[0]
    content = (choice.get("message") or {}).get("content", "")
    usage = resp_json.get("usage", {})
    print(
        f"[bd-openrouter-local] Routed: requested={selected_model} -> "
        f"tier={routing.get('effective_tier')} model={routing.get('resolved_model')} "
        f"upstream={routing.get('upstream')} ({elapsed:.2f}s, usage={usage}) "
        f"| Argon-4: ENFORCED | Skills: {[r['skill'] for r in skill_receipts]}"
    )
    print(f"  Reason: {routing.get('reason')}")
    print("\n" + content.strip())
    return 0


