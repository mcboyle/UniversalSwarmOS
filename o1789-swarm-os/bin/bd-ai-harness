def configure_openclaw_provider(
    selected_model: str,
    effective_sys: str,
    effort: str,
    context_win: str,
    autocompact: str,
) -> str:
    openclaw_cfg = generate_openclaw_config(
        selected_model, effective_sys, effort, context_win, autocompact
    )
    cfg_path = os.path.expanduser("~/.openclaw/openclaw.json")
    for d_name in ("~/.openclaw", "~/.openclaw-dev"):
        d_path = os.path.expanduser(d_name)
        os.makedirs(d_path, mode=0o700, exist_ok=True)
        try:
            os.chmod(d_path, 0o700)
        except OSError:
            pass
        ws_dir = os.path.join(d_path, "workspace")
        os.makedirs(ws_dir, exist_ok=True)
        agents_md = os.path.join(ws_dir, "AGENTS.md")
        try:
            with open(agents_md, "w", encoding="utf-8") as af:
                af.write(f"# OpenClaw Argon-4 Fleet Contract\n\n{effective_sys}\n")
        except OSError:
            pass
        c_file = os.path.join(d_path, "openclaw.json")
        cfg_copy = json.loads(json.dumps(openclaw_cfg))
        cfg_copy["agents"]["defaults"]["workspace"] = ws_dir
        with open(c_file, "w", encoding="utf-8") as f:
            json.dump(cfg_copy, f, indent=2)
        try:
            os.chmod(c_file, 0o600)
        except OSError:
            pass
    return cfg_path


def run_harness_openclaw(
    tier: str,
    model: Optional[str],
    prompt: Optional[str],
    print_env: bool,
    extra_args: List[str],
    skills: Optional[List[str]] = None,
    role_block: str = "",
    effort: str = "high",
    context_win: str = "1m",
    autocompact: str = "150k",
) -> int:
    selected_model = resolve_model("openclaw", tier, model)
    skill_block, skill_receipts = bd_local_mcp_bridge.build_skill_injection_block(
        skills, prompt=prompt
    )
    effective_sys = ARGON4_SYSTEM_PROMPT + role_block + skill_block
    cfg_path = configure_openclaw_provider(
        selected_model, effective_sys, effort, context_win, autocompact
    )
    argon_status = verify_argon4_pretool_hooks(run_live_probe=False)
    env = os.environ.copy()
    env["PATH"] = (
        f"/home/mboyle/.local/node24/bin:/home/mboyle/.local/bin:{env.get('PATH', '')}"
    )
    env["OPENAI_BASE_URL"] = f"{LITELLM_BASE}/v1"
    env["OPENAI_API_KEY"] = DEFAULT_API_KEY
    env["OPENCLAW_CONFIG"] = cfg_path
    env["BD_ARGON4_CONTRACT"] = effective_sys

    if print_env:
        print(f"export OPENAI_BASE_URL={env['OPENAI_BASE_URL']}")
        print(f"export OPENAI_API_KEY={env['OPENAI_API_KEY']}")
        print(f"export OPENCLAW_CONFIG={cfg_path}")
        print(f"export BD_ARGON4_CONTRACT={json.dumps(effective_sys)}")
        return 0

    print(
        f"[bd-openclaw-local] Configured OpenClaw 2026.10.4 -> {cfg_path}\n"
        f"  LiteLLM Gateway     : {LITELLM_BASE}/v1\n"
        f"  Orchestrator Direct : {ORCHESTRATOR_BASE}/v1\n"
        f"  Selected Model      : {selected_model} (effort={effort}, context={context_win}, autocompact={autocompact})\n"
        f"  Argon-4 Contract    : ENFORCED (hooks_verified={argon_status['argon4_enforced']})\n"
        f"  Fleet MCP & Web     : 12 TOOLS ENABLED"
    )

    if prompt:
        return run_harness_hermes(
            tier, selected_model, prompt, max_steps=5, skills=skills
        )

    openclaw_bin = (
        "/home/mboyle/.local/bin/openclaw"
        if os.path.isfile("/home/mboyle/.local/bin/openclaw")
        else shutil.which("openclaw")
    )
    if openclaw_bin and extra_args:
        proc = subprocess.run([openclaw_bin] + extra_args, env=env, check=False)
        return proc.returncode
    return run_harness_hermes(tier, selected_model, None, max_steps=5, skills=skills)


def load_role_systemprompt_block(role: Optional[str]) -> str:
    if not role:
        return ""
    for cand in (
        f"/home/mboyle/bd-persist/role-systemprompts/{role}.frozen.systemprompt",
        f"/home/mboyle/bd-persist/role-prompts/{role}.prompt",
    ):
        if os.path.isfile(cand):
            try:
                with open(cand, "r", encoding="utf-8") as f:
                    return (
                        f"\n\n=== FLEET ROLE SYSTEM PROMPT ({role}) ===\n"
                        + f.read().strip()
                        + "\n"
                    )
            except Exception:
                pass
    return f"\n\n=== FLEET ROLE: {role} ===\n"


def detect_default_harness_from_argv0(argv0: str) -> Optional[str]:
    base = os.path.basename(argv0)
    mapping = {
        "bd-claude-local": "claude",
        "bd-codex-local": "codex",
        "bd-opencode-local": "opencode",
        "bd-hermes-local": "hermes",
        "bd-openclaw-local": "openclaw",
        "bd-deepseek-local": "deepseek",
        "bd-openrouter-local": "openrouter",
    }
    return mapping.get(base)


def main() -> int:
    inferred_harness = detect_default_harness_from_argv0(sys.argv[0])

    parser = argparse.ArgumentParser(
        description="Boylenet Unified Local AI Harness Launcher (claude, codex, opencode, hermes, openclaw, deepseek, openrouter-local)"
    )
    parser.add_argument(
        "--harness",
        "-H",
        default=inferred_harness or "hermes",
        choices=[
            "claude",
            "codex",
            "opencode",
            "hermes",
            "openclaw",
            "deepseek",
            "openrouter",
            "openrouter-local",
        ],
        help="Target harness paradigm",
    )
    parser.add_argument(
        "--tier",
        "-t",
        default=os.environ.get("BD_AI_TIER", "tier1"),
        choices=["tier1", "tier2", "tier3", "auto"],
        help="Target hardware tier (tier1, tier2, tier3, auto)",
    )
    parser.add_argument(
        "--model",
        "-m",
        default=os.environ.get("BD_LAUNCH_MODEL", None),
        help="Explicit model ID or alias override",
    )
    parser.add_argument(
        "--role",
        "-r",
        default=os.environ.get("BD_ROLE", None),
        help="Optional fleet role name (attaches role-systemprompts/<role>.frozen.systemprompt)",
    )
    parser.add_argument(
        "--effort",
        "-e",
        default=os.environ.get("BD_LAUNCH_EFFORT", "high"),
        help="Reasoning effort level (low, medium, high, extra, xhigh, ultra, max)",
    )
    parser.add_argument(
        "--context",
        "--ctx",
        default=os.environ.get("BD_LAUNCH_CONTEXT", "1m"),
        help="Context window (200k, standard, 1m, extralong)",
    )
    parser.add_argument(
        "--autocompact",
        "--ceiling",
        default=os.environ.get("BD_LAUNCH_AUTOCOMPACT", "150k"),
        help="Autocompact ceiling or toggle (off, on, 150k, 200k, 500k, 1m)",
    )
    parser.add_argument(
        "--prompt",
        "-p",
        default=None,
        help="Single-turn prompt for non-interactive execution",
    )
    parser.add_argument(
        "--skill",
        "-s",
        action="append",
        default=[],
        help="Fleet skill(s) to inject from /home/mboyle/.agents/skills/<skill>/SKILL.md or plugin skills (repeatable or comma-separated, or 'auto')",
    )
    parser.add_argument(
        "--list-skills",
        action="store_true",
        help="List all available Fleet skills and exit",
    )
    parser.add_argument(
        "--list-mcp-tools",
        action="store_true",
        help="List all exposed Fleet MCP & Native tools and exit",
    )
    parser.add_argument(
        "--tools",
        default=None,
        help="Optional comma-separated subset of MCP tools to expose in hermes loop (default: all 12 tools)",
    )
    parser.add_argument(
        "--switch",
        action="store_true",
        help="Explicitly trigger bd-tier-switch before running the harness",
    )
    parser.add_argument(
        "--print-env",
        action="store_true",
        help="Print environment variables for shell eval and exit",
    )
    parser.add_argument(
        "--list-models",
        action="store_true",
        help="List models on the local OpenRouter/Orchestrator gateway",
    )
    parser.add_argument(
        "--verify-argon4",
        action="store_true",
        help="Verify Argon-4 Anti-Sycophancy & PreToolUse Hooks (claude, codex, agy, shield.py, bd-token-guard.py)",
    )
    parser.add_argument(
        "--max-steps",
        type=int,
        default=5,
        help="Maximum tool-calling turns for hermes harness",
    )

    args, extra = parser.parse_known_args()
    if args.verify_argon4:
        res = verify_argon4_pretool_hooks(run_live_probe=True)
        print(json.dumps(res, indent=2))
        return 0 if res.get("argon4_enforced") else 1

    if args.list_skills:
        skills_map = bd_local_mcp_bridge.discover_all_skills()
        print(
            json.dumps(
                {"rc": 0, "skill_count": len(skills_map), "skills": skills_map},
                indent=2,
            )
        )
        return 0

    if args.list_mcp_tools:
        print(
            json.dumps(
                {
                    "rc": 0,
                    "tool_count": len(bd_local_mcp_bridge.FLEET_MCP_TOOLS_OPENAI),
                    "tools": bd_local_mcp_bridge.FLEET_MCP_TOOLS_OPENAI,
                },
                indent=2,
            )
        )
        return 0

    role_block = load_role_systemprompt_block(args.role)
    if role_block:
        global ARGON4_SYSTEM_PROMPT
        ARGON4_SYSTEM_PROMPT = ARGON4_SYSTEM_PROMPT + role_block

    tool_subset = (
        [x.strip() for x in args.tools.split(",") if x.strip()] if args.tools else None
    )

    harness = "openrouter" if args.harness == "openrouter-local" else args.harness

    try:
        stream_dir = "/var/tmp/bd-headless-streams"
        os.makedirs(stream_dir, exist_ok=True)
        latest_log = os.path.join(stream_dir, f"{harness}-latest.log")
        ts_str = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
        with open(latest_log, "a", encoding="utf-8") as sf:
            sf.write(
                f"\n{'='*72}\n"
                f"[HEADLESS-{harness.upper()}] START {ts_str} | tier={args.tier} | model={args.model or 'auto'}\n"
                f"Prompt: {(args.prompt or '(interactive/extra args)')[:240]}\n"
                f"{'-'*72}\n"
            )

        class _TeeOut:
            def __init__(self, orig: Any, path: str) -> None:
                self._orig = orig
                self._path = path

            def write(self, data: str) -> int:
                res = self._orig.write(data)
                try:
                    with open(self._path, "a", encoding="utf-8") as f:
                        f.write(data)
                except Exception:
                    pass
                return res

            def flush(self) -> None:
                try:
                    self._orig.flush()
                except Exception:
                    pass

            def __getattr__(self, name: str) -> Any:
                return getattr(self._orig, name)

        sys.stdout = _TeeOut(sys.stdout, latest_log)  # type: ignore[assignment]
        sys.stderr = _TeeOut(sys.stderr, latest_log)  # type: ignore[assignment]
    except Exception:
        pass

    maybe_switch_tier(args.tier, args.model, args.switch)

    if harness == "claude":
        return run_harness_claude(
            args.tier, args.model, args.prompt, args.print_env, extra, skills=args.skill
        )
    if harness == "codex":
        return run_harness_codex(
            args.tier, args.model, args.prompt, args.print_env, extra, skills=args.skill
        )
    if harness == "opencode":
        return run_harness_opencode(
            args.tier, args.model, args.prompt, args.print_env, extra, skills=args.skill
        )
    if harness == "openclaw":
        return run_harness_openclaw(
            args.tier,
            args.model,
            args.prompt,
            args.print_env,
            extra,
            skills=args.skill,
            role_block="",
            effort=args.effort,
            context_win=args.context,
            autocompact=args.autocompact,
        )
    if harness == "hermes":
        return run_harness_hermes(
            args.tier,
            args.model,
            args.prompt,
            max_steps=args.max_steps,
            skills=args.skill,
            tool_subset=tool_subset,
        )
    if harness == "deepseek":
        return run_harness_deepseek(
            args.tier, args.model, args.prompt, skills=args.skill
        )
    if harness == "openrouter":
        return run_harness_openrouter(
            args.tier,
            args.model,
            args.prompt,
            list_models=args.list_models,
            skills=args.skill,
        )

    print(f"ERROR: Unsupported harness: {harness}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
