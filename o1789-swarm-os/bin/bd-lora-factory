#!/usr/bin/env python3
"""
bd-lora-factory — LoRA Dataset Factory (Swarm #20)
Harvests high-signal Boylenet engineering receipts, BOARD review verdicts, and multi-harness
trajectories from PostgreSQL (boylenet_episodic_memory) and
/home/mboyle/bd-persist/harness-work/O1789/infra-upgrade/*.md, exporting ShareGPT / ChatML
instruction-tuning JSONL datasets (/var/tmp/bd-lora-dataset-chatml.jsonl) ready for QLoRA
fine-tuning of Qwen3-Coder-30B-A3B on .83.
"""

import argparse
import datetime
import glob
import hashlib
import json
import os
import re
import subprocess
import sys
from pathlib import Path
from typing import Any, Dict, List, Optional, Tuple

DEFAULT_OUTPUT = Path("/var/tmp/bd-lora-dataset-chatml.jsonl")
RECEIPT_GLOBS = [
    "/home/mboyle/bd-persist/harness-work/O1789/infra-upgrade/*.md",
    "/home/mboyle/bd-persist/harness-work/**/*.md",
]

SYSTEM_PROMPT = (
    "You are an autonomous Boylenet Swarm Staff Engineer and Fleet Integrator operating on a "
    "27-node cluster (656 vCPUs, 1.4 TB RAM, ESXi vc04, LiteLLM/vLLM GPU nodes .83/.125/.228/.137). "
    "Produce deterministic, production-hardened infrastructure code, verifiable CLI receipts, "
    "and strict Protocol B/F BOARD review verdicts with zero filler."
)


def query_pg_episodic_memory() -> Tuple[str, List[Dict[str, Any]]]:
    """Query boylenet_episodic_memory from PostgreSQL with strict non-blocking timeouts."""
    records: List[Dict[str, Any]] = []
    env = dict(os.environ)
    env["PGCONNECT_TIMEOUT"] = "2"

    # Try psycopg2 first if available
    pg_urls = [
        env.get("DATABASE_URL", ""),
        "postgresql://postgres:postgres@127.0.0.1:5432/postgres",
        "postgresql://mboyle@127.0.0.1:5432/postgres",
        "postgresql://postgres:postgres@10.0.70.164:5432/postgres",
        "postgresql://postgres:postgres@10.0.70.72:5432/postgres",
    ]
    sql_candidates = [
        "SELECT COALESCE(role, 'engineer') AS role, COALESCE(topic, 'boylenet_ops') AS topic, content, created_at::text FROM boylenet_episodic_memory ORDER BY created_at DESC LIMIT 250;",
        "SELECT row_to_json(t)::text FROM (SELECT * FROM boylenet_episodic_memory LIMIT 250) t;",
    ]

    for dsn in [u for u in pg_urls if u]:
        try:
            proc = subprocess.run(
                [
                    "psql",
                    dsn,
                    "-X",
                    "-w",
                    "-t",
                    "-A",
                    "-c",
                    "SELECT row_to_json(t)::text FROM (SELECT * FROM boylenet_episodic_memory LIMIT 250) t;",
                ],
                env=env,
                capture_output=True,
                text=True,
                timeout=3,
            )
            if proc.returncode == 0 and proc.stdout.strip():
                for line in proc.stdout.splitlines():
                    line = line.strip()
                    if not line:
                        continue
                    try:
                        obj = json.loads(line)
                        if isinstance(obj, dict):
                            records.append(obj)
                    except Exception:
                        continue
                if records:
                    return f"pg:{dsn.split('@')[-1]}", records
        except Exception:
            continue

    # Try local unix socket without password prompt (-w)
    for db in ("postgres", "boylenet", "hivemind", "mboyle"):
        try:
            proc = subprocess.run(
                [
                    "psql",
                    "-w",
                    "-X",
                    "-d",
                    db,
                    "-t",
                    "-A",
                    "-c",
                    "SELECT row_to_json(t)::text FROM (SELECT * FROM boylenet_episodic_memory LIMIT 250) t;",
                ],
                env=env,
                capture_output=True,
                text=True,
                timeout=2,
            )
            if proc.returncode == 0 and proc.stdout.strip():
                for line in proc.stdout.splitlines():
                    if line.strip().startswith("{"):
                        try:
                            records.append(json.loads(line.strip()))
                        except Exception:
                            pass
                if records:
                    return f"pg:unix/{db}", records
        except Exception:
            continue

    return "pg:none_or_empty", records


def parse_markdown_receipt(md_path: Path) -> List[Dict[str, Any]]:
    """Convert an engineering receipt / BOARD verdict markdown file into instruction-tuning examples."""
    try:
        text = md_path.read_text(encoding="utf-8", errors="replace").strip()
    except Exception:
        return []
    if len(text) < 80:
        return []

    samples: List[Dict[str, Any]] = []
    lines = text.splitlines()
    title = lines[0].lstrip("# ").strip() if lines else md_path.stem

    # Extract mission/context vs implementation/verification sections if structured
    headings = list(re.finditer(r"(?m)^##+\s+(.+)$", text))
    is_board = "BOARD" in text or "verdict" in text.lower() or "RECEIPT" in md_path.name.upper()

    user_prompt = (
        f"Execute Boylenet engineering task '{title}' ({md_path.name}). "
        f"Implement the required cluster tooling/verification and provide a complete, reproducible "
        f"engineering receipt with command outputs and verification proofs."
    )
    samples.append(
        {
            "source_path": str(md_path),
            "sample_type": "board_receipt" if is_board else "engineering_receipt",
            "user": user_prompt,
            "assistant": text,
        }
    )

    # Also extract sub-sections with code blocks or JSON verdicts as focused trajectories
    if len(headings) >= 2:
        for idx, h in enumerate(headings):
            sec_title = h.group(1).strip()
            start = h.end()
            end = headings[idx + 1].start() if idx + 1 < len(headings) else len(text)
            sec_body = text[start:end].strip()
            if len(sec_body) >= 160 and ("```" in sec_body or '"verdict"' in sec_body or "PASS" in sec_body):
                sub_prompt = (
                    f"In context of Boylenet task '{title}' ({md_path.stem}), "
                    f"produce the exact implementation or verification evidence for section: '{sec_title}'."
                )
                samples.append(
                    {
                        "source_path": f"{md_path}#{sec_title}",
                        "sample_type": "section_trajectory",
                        "user": sub_prompt,
                        "assistant": f"## {sec_title}\n\n{sec_body}",
                    }
                )

    return samples


def format_chatml_sharegpt(
    user_text: str,
    assistant_text: str,
    source: str,
    sample_type: str,
) -> Dict[str, Any]:
    digest = hashlib.sha256(f"{user_text}\n---\n{assistant_text}".encode("utf-8", errors="ignore")).hexdigest()
    chatml_prompt = (
        f"<|im_start|>system\n{SYSTEM_PROMPT}<|im_end|>\n"
        f"<|im_start|>user\n{user_text}<|im_end|>\n"
        f"<|im_start|>assistant\n{assistant_text}<|im_end|>"
    )
    return {
        "id": f"boylenet-{digest[:16]}",
        "model_target": "Qwen3-Coder-30B-A3B",
        "train_node": "10.0.70.83",
        "format": "chatml+sharegpt",
        "messages": [
            {"role": "system", "content": SYSTEM_PROMPT},
            {"role": "user", "content": user_text},
            {"role": "assistant", "content": assistant_text},
        ],
        "conversations": [
            {"from": "system", "value": SYSTEM_PROMPT},
            {"from": "human", "value": user_text},
            {"from": "gpt", "value": assistant_text},
        ],
        "text": chatml_prompt,
        "metadata": {
            "source": source,
            "sample_type": sample_type,
            "sha256": digest,
            "char_length": len(chatml_prompt),
            "exported_at": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        },
    }


def harvest_all(max_files: int = 400) -> Tuple[Dict[str, Any], List[Dict[str, Any]]]:
    pg_source, pg_rows = query_pg_episodic_memory()
    seen_hashes = set()
    dataset: List[Dict[str, Any]] = []

    pg_converted = 0
    for row in pg_rows:
        content = (
            row.get("content")
            or row.get("summary")
            or row.get("trajectory")
            or row.get("output")
            or json.dumps(row)
        )
        if not content or len(str(content)) < 40:
            continue
        topic = row.get("topic") or row.get("task_id") or row.get("cut_id") or "boylenet-episodic"
        prompt = (
            row.get("prompt")
            or row.get("query")
            or f"Synthesize Boylenet engineering execution and verification for episodic memory topic '{topic}'."
        )
        item = format_chatml_sharegpt(str(prompt), str(content), f"{pg_source}:{topic}", "pg_episodic_memory")
        h = item["metadata"]["sha256"]
        if h not in seen_hashes:
            seen_hashes.add(h)
            dataset.append(item)
            pg_converted += 1

    # Gather markdown files from O1789/infra-upgrade first, then additional harness-work receipts
    primary_dir = Path("/home/mboyle/bd-persist/harness-work/O1789/infra-upgrade")
    md_files: List[Path] = []
    if primary_dir.exists():
        md_files.extend(sorted(primary_dir.glob("*.md")))

    extra_root = Path("/home/mboyle/bd-persist/harness-work")
    if extra_root.exists() and len(md_files) < max_files:
        for p in sorted(extra_root.rglob("*.md")):
            if p not in md_files:
                md_files.append(p)
                if len(md_files) >= max_files:
                    break

    o1789_files_count = 0
    md_samples_count = 0
    board_verdicts_count = 0

    for md_path in md_files:
        if "/O1789/infra-upgrade/" in str(md_path):
            o1789_files_count += 1
        extracted = parse_markdown_receipt(md_path)
        for s in extracted:
            item = format_chatml_sharegpt(
                s["user"],
                s["assistant"],
                s["source_path"],
                s["sample_type"],
            )
            h = item["metadata"]["sha256"]
            if h not in seen_hashes:
                seen_hashes.add(h)
                dataset.append(item)
                md_samples_count += 1
                if s["sample_type"] == "board_receipt":
                    board_verdicts_count += 1

    stats = {
        "status": "OK",
        "target_model": "Qwen3-Coder-30B-A3B",
        "target_node": "10.0.70.83",
        "pg_source": pg_source,
        "pg_records_harvested": pg_converted,
        "o1789_infra_upgrade_md_files": o1789_files_count,
        "total_md_files_scanned": len(md_files),
        "md_samples_harvested": md_samples_count,
        "board_verdict_samples": board_verdicts_count,
        "total_jsonl_examples": len(dataset),
    }
    return stats, dataset


def main() -> int:
    parser = argparse.ArgumentParser(
        description="bd-lora-factory: Export ShareGPT / ChatML QLoRA JSONL datasets for Qwen3-Coder-30B-A3B (.83)"
    )
    parser.add_argument("--export", action="store_true", help="Harvest sources and export JSONL dataset")
    parser.add_argument("--stats", action="store_true", help="Print dataset statistics")
    parser.add_argument("--output", type=Path, default=DEFAULT_OUTPUT, help=f"Output JSONL path (default: {DEFAULT_OUTPUT})")
    parser.add_argument("--json", action="store_true", help="Emit structured JSON summary")
    args = parser.parse_args()

    if not (args.export or args.stats):
        args.export = True

    stats, dataset = harvest_all()
    out_path: Path = args.output
    out_path.parent.mkdir(parents=True, exist_ok=True)

    if args.export:
        with out_path.open("w", encoding="utf-8") as fh:
            for row in dataset:
                fh.write(json.dumps(row, ensure_ascii=False) + "\n")

    size_bytes = out_path.stat().st_size if out_path.exists() else 0
    stats["output_path"] = str(out_path)
    stats["output_size_bytes"] = size_bytes
    stats["output_size_kb"] = round(size_bytes / 1024, 2)

    if args.json:
        print(json.dumps(stats, indent=2))
    else:
        print(
            f"[bd-lora-factory] status={stats['status']} model={stats['target_model']} node={stats['target_node']} "
            f"examples={stats['total_jsonl_examples']} (o1789_md={stats['o1789_infra_upgrade_md_files']}, "
            f"board_receipts={stats['board_verdict_samples']}, pg={stats['pg_records_harvested']}) "
            f"output={stats['output_path']} ({stats['output_size_kb']} KB)"
        )
    return 0


if __name__ == "__main__":
    sys.exit(main())
