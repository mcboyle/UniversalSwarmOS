#!/usr/bin/env python3
"""Toolchain CLI wrapper for Binary Payload Protocol.

Canonical path: toolchain/bin/bd-binary-payload
High-density MessagePack and Tabular TOON codec for inter-agent state.
"""

import runpy
import sys
from pathlib import Path

TOOLCHAIN_BIN_DIR = Path(__file__).resolve().parent
PROJECT_ROOT = TOOLCHAIN_BIN_DIR.parent.parent
BIN_DIR = PROJECT_ROOT / "bin"
TARGET_SCRIPT = BIN_DIR / "bd_binary_payload.py"

if str(BIN_DIR) not in sys.path:
    sys.path.insert(0, str(BIN_DIR))

try:
    from bd_binary_payload import main

    if __name__ == "__main__":
        sys.exit(main())
except ImportError:
    if TARGET_SCRIPT.exists():
        runpy.run_path(str(TARGET_SCRIPT), run_name="__main__")
        sys.exit(0)
    else:
        sys.stderr.write(f"Error: Target binary payload script not found at {TARGET_SCRIPT}\n")
        sys.exit(1)
