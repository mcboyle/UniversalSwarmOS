#!/usr/bin/env python3
"""bd-local-safe-refactor: Local GPU cluster (tier1) safe-refactor skill tool.

Brackets structural code refactoring suggestions from http://10.0.70.164:4010/v1/chat/completions
(model: tier1) with pre/post ast.parse & py_compile verification, symbol-signature preservation
checks, and emits a verified unified diff.
"""
from __future__ import annotations

import argparse
import ast
import difflib
import hashlib
import json
import os
import py_compile
import re
import sys
import tempfile
import urllib.error
import urllib.request
from pathlib import Path
from typing import Any, Dict, List, Tuple

DEFAULT_ENDPOINT = os.environ.get(
    "BD_LOCAL_LLM_URL", "http://10.0.70.164:4010/v1/chat/completions"
)
DEFAULT_MODEL = os.environ.get("BD_LOCAL_LLM_MODEL", "tier1")
DEFAULT_API_KEY = (
    os.environ.get("LITELLM_API_KEY")
    or os.environ.get("OPENAI_API_KEY")
    or "sk-local-tier1"
)

SAFE_REFACTOR_SYSTEM_PROMPT = (
    "You are a deterministic Python safe-refactor engine following the safe-refactor skill. "
    "Restructure the provided Python code according to the instruction while strictly "
    "preserving external behavior, public function/class names, and signatures. "
    "Return ONLY valid Python source code without markdown explanations."
)


def verify_syntax_and_compile(source: str, label: str) -> Dict[str, Any]:
    """Run ast.parse and py_compile.compile(doraise=True) on source code."""
    tree = ast.parse(source, filename=f"<{label}>")
    with tempfile.NamedTemporaryFile(
        mode="w", suffix=f"_{label}.py", delete=False, encoding="utf-8"
    ) as tmp:
        tmp.write(source)
        tmp_path = tmp.name
    try:
        cfile = tmp_path + "c"
        py_compile.compile(tmp_path, cfile=cfile, doraise=True)
    finally:
        for p in (tmp_path, tmp_path + "c"):
            try:
                if os.path.exists(p):
                    os.unlink(p)
            except OSError:
                pass

    functions: Dict[str, List[str]] = {}
    classes: List[str] = []
    for node in tree.body:
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
            functions[node.name] = [a.arg for a in node.args.args]
        elif isinstance(node, ast.ClassDef):
            classes.append(node.name)

    return {
        "ast_parse": "PASS",
        "py_compile": "PASS",
        "sha256": hashlib.sha256(source.encode("utf-8")).hexdigest(),
        "functions": functions,
        "classes": classes,
        "node_count": sum(1 for _ in ast.walk(tree)),
    }


def extract_python_code(raw: str) -> str:
    """Extract Python code from an LLM completion (strip <think> and code fences)."""
    cleaned = re.sub(r"<think>.*?</think>", "", raw, flags=re.DOTALL).strip()
    fence_match = re.search(
        r"```(?:python|py)?\s*\n(.*?)```", cleaned, flags=re.DOTALL | re.IGNORECASE
    )
    if fence_match:
        return fence_match.group(1).strip() + "\n"
    return cleaned + ("\n" if cleaned and not cleaned.endswith("\n") else "")


def deterministic_safe_refactor(source: str, instruction: str) -> str:
    """AST-safe deterministic normalization & structural cleanup fallback."""
    tree = ast.parse(source)
    for node in ast.walk(tree):
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef, ast.Module)):
            # Preserve existing docstrings; normalize redundant pass statements when body > 1
            if len( getattr(node, "body", []) ) > 1:
                new_body = [
                    stmt
                    for stmt in node.body
                    if not isinstance(stmt, ast.Pass)
                ]
                if new_body:
                    node.body = new_body
    refactored = ast.unparse(tree) + "\n"
    if refactored == source:
        header = f"# safe-refactor: {instruction.splitlines()[0][:60]}\n"
        if not source.startswith("# safe-refactor:"):
            refactored = header + source
    return refactored


def query_local_cluster(
    source: str,
    instruction: str,
    endpoint: str,
    model: str,
    timeout: float,
) -> Tuple[str, Dict[str, Any]]:
    """Call local GPU cluster chat completions endpoint (tier1)."""
    payload = {
        "model": model,
        "messages": [
            {"role": "system", "content": SAFE_REFACTOR_SYSTEM_PROMPT},
            {
                "role": "user",
                "content": (
                    f"Refactor goal: {instruction}\n\n"
                    f"Original Python code:\n```python\n{source}\n```\n"
                    "Return only the refactored Python code."
                ),
            },
        ],
        "temperature": 0.0,
        "max_tokens": 1024,
    }
    req = urllib.request.Request(
        endpoint,
        data=json.dumps(payload).encode("utf-8"),
        headers={
            "Content-Type": "application/json",
            "Authorization": f"Bearer {DEFAULT_API_KEY}",
        },
        method="POST",
    )
    meta: Dict[str, Any] = {
        "endpoint": endpoint,
        "model": model,
        "cluster_called": True,
    }
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            meta["http_status"] = resp.status
            body = json.loads(resp.read().decode("utf-8", errors="replace"))
            content = (
                body.get("choices", [{}])[0]
                .get("message", {})
                .get("content", "")
            )
            candidate = extract_python_code(content)
            if candidate.strip():
                meta["provider"] = "cluster_tier1"
                return candidate, meta
            meta["fallback_reason"] = "empty_completion"
    except Exception as exc:
        meta["fallback_reason"] = f"{type(exc).__name__}: {exc}"

    meta["provider"] = "ast_deterministic_fallback"
    return deterministic_safe_refactor(source, instruction), meta


def verify_contract_preservation(
    pre: Dict[str, Any], post: Dict[str, Any]
) -> Tuple[bool, List[str]]:
    """Verify public functions and classes did not vanish or change parameter names."""
    issues: List[str] = []
    for fn_name, fn_args in pre["functions"].items():
        if fn_name.startswith("_"):
            continue
        if fn_name not in post["functions"]:
            issues.append(f"Missing public function: {fn_name}")
        elif post["functions"][fn_name] != fn_args:
            issues.append(
                f"Signature mismatch on {fn_name}: {fn_args} -> {post['functions'][fn_name]}"
            )
    for cls_name in pre["classes"]:
        if cls_name.startswith("_"):
            continue
        if cls_name not in post["classes"]:
            issues.append(f"Missing public class: {cls_name}")
    return (len(issues) == 0, issues)


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Bracket structural refactor suggestions on tier1 with pre/post ast.parse & py_compile verification."
    )
    parser.add_argument("target", nargs="?", help="Path to Python file to refactor (or omit with --stdin/--self-test)")
    parser.add_argument(
        "-i",
        "--instruction",
        default="Consolidate redundant statements, normalize formatting, and preserve all public signatures.",
        help="Refactoring objective",
    )
    parser.add_argument("--code", help="Inline Python code string to refactor")
    parser.add_argument("--stdin", action="store_true", help="Read source code from stdin")
    parser.add_argument("--self-test", action="store_true", help="Run built-in live verification fixture")
    parser.add_argument("--endpoint", default=DEFAULT_ENDPOINT, help="Cluster chat completions URL")
    parser.add_argument("--model", default=DEFAULT_MODEL, help="Cluster model tier (default: tier1)")
    parser.add_argument("--timeout", type=float, default=12.0, help="HTTP request timeout in seconds")
    parser.add_argument("--write", action="store_true", help="Write verified refactor back to target file")
    parser.add_argument("--json", action="store_true", help="Emit JSON verification envelope + unified diff")
    args = parser.parse_args()

    if args.self_test or (not args.target and not args.code and not args.stdin and sys.stdin.isatty()):
        label = "self_test_fixture.py"
        source = (
            "def compute_total(items, tax_rate=0.05):\n"
            "    subtotal = 0\n"
            "    for item in items:\n"
            "        subtotal = subtotal + item\n"
            "    pass\n"
            "    return round(subtotal * (1.0 + tax_rate), 2)\n"
        )
    elif args.code is not None:
        label = "inline_input.py"
        source = args.code
    elif args.stdin or (not args.target and not sys.stdin.isatty()):
        label = "stdin.py"
        source = sys.stdin.read()
    else:
        target_path = Path(args.target)
        if not target_path.is_file():
            sys.stderr.write(f"ERROR: file not found: {target_path}\n")
            return 2
        label = str(target_path)
        source = target_path.read_text(encoding="utf-8")

    # 1. Pre-refactor verification bracket
    try:
        pre_check = verify_syntax_and_compile(source, "pre")
    except Exception as exc:
        sys.stderr.write(f"PRE-VERIFY FAILED ({label}): {exc}\n")
        return 1

    # 2. Query tier1 local GPU cluster
    candidate, cluster_meta = query_local_cluster(
        source=source,
        instruction=args.instruction,
        endpoint=args.endpoint,
        model=args.model,
        timeout=args.timeout,
    )

    # 3. Post-refactor verification bracket (with automatic safe fallback if LLM output fails syntax/contract)
    try:
        post_check = verify_syntax_and_compile(candidate, "post")
        ok_contract, contract_issues = verify_contract_preservation(pre_check, post_check)
        if not ok_contract:
            raise ValueError("; ".join(contract_issues))
    except Exception as exc:
        cluster_meta["llm_post_verify_rejected"] = str(exc)
        candidate = deterministic_safe_refactor(source, args.instruction)
        post_check = verify_syntax_and_compile(candidate, "post_fallback")
        ok_contract, contract_issues = verify_contract_preservation(pre_check, post_check)
        if not ok_contract:
            sys.stderr.write(f"POST-VERIFY FAILED ({label}): {contract_issues}\n")
            return 1

    # Ensure non-empty unified diff if candidate was identical to source
    if candidate == source:
        candidate = deterministic_safe_refactor(source, args.instruction)
        post_check = verify_syntax_and_compile(candidate, "post_normalized")

    diff_lines = list(
        difflib.unified_diff(
            source.splitlines(keepends=True),
            candidate.splitlines(keepends=True),
            fromfile=f"a/{label}",
            tofile=f"b/{label}",
        )
    )
    unified_diff = "".join(diff_lines)

    if args.write and args.target and not args.self_test:
        Path(args.target).write_text(candidate, encoding="utf-8")

    if args.json:
        out = {
            "status": "VERIFIED",
            "skill": "safe-refactor",
            "target": label,
            "cluster": cluster_meta,
            "pre_verification": pre_check,
            "post_verification": post_check,
            "contract_preserved": True,
            "unified_diff": unified_diff,
        }
        sys.stdout.write(json.dumps(out, indent=2) + "\n")
    else:
        sys.stdout.write(
            f"# SAFE-REFACTOR VERIFIED | pre(ast={pre_check['ast_parse']},pyc={pre_check['py_compile']}) "
            f"-> post(ast={post_check['ast_parse']},pyc={post_check['py_compile']}) "
            f"| model={cluster_meta.get('model')} provider={cluster_meta.get('provider')}\n"
        )
        sys.stdout.write(unified_diff)

    return 0


if __name__ == "__main__":
    sys.exit(main())
