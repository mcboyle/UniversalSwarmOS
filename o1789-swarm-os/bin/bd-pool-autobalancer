)
LITELLM_API_KEY = os.environ.get("BD_LOCAL_API_KEY", "sk-boylenet-local")

SOFT_CAP_PCT = 80.0
COMMAND_FAILOVER_PCT = 85.0
HARD_STOP_PCT = 95.0
GLOBAL_HEAVY_LIFTER_CAP = 30

DISPLAY_POOLS = ["A", "B", "C", "D", "codex", "kimi", "AGY", "local-4xt4"]
CLAUDE_POOLS = ["A", "B", "C", "D"]

