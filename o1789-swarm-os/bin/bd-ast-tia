#!/usr/bin/env python3
"""
bd-ast-tia: Semantic Test Impact Analysis for BulkDownloader and Agent Fleets.
Analyzes git diffs, extracts modified AST symbols, and maps them to the
highest-relevance pytest targets. Cuts inner-loop feedback from minutes to seconds.
"""

import sys
import os
import ast
import subprocess
import argparse
import json
import re
from typing import List, Dict, Set

def get_repo_root(start_dir: str = ".") -> str:
    try:
        out = subprocess.check_output(
            ["git", "rev-parse", "--show-toplevel"],
            cwd=start_dir,
            stderr=subprocess.DEVNULL,
            text=True
        ).strip()
        return out
    except Exception:
        return os.path.abspath(start_dir)

def is_python_path(repo_root: str, rel_path: str) -> bool:
    """*.py, or an extensionless file whose shebang names python (harness tools, F3)."""
    if rel_path.endswith(".py"):
        return True
    if os.path.splitext(rel_path)[1]:
        return False
    try:
        with open(os.path.join(repo_root, rel_path), "rb") as fh:
            first = fh.readline(200)
    except OSError:
        return False
    return first.startswith(b"#!") and b"python" in first

def get_modified_py_files(repo_root: str, base_ref: str = None) -> List[str]:
    """Get modified python files via git status/diff."""
    cmd = ["git", "diff", "--name-only", "--diff-filter=d"]
    if base_ref:
        cmd.append(base_ref)
    else:
        # Check staged and unstaged
        cmd.append("HEAD")
        
    try:
        out = subprocess.check_output(cmd, cwd=repo_root, stderr=subprocess.DEVNULL, text=True)
        files = [f.strip() for f in out.splitlines() if f.strip() and is_python_path(repo_root, f.strip())]
        # Deleted and untracked files never reach the diff above; merge them from status always (F7),
        # not only when the diff has no python file.
        out_status = subprocess.check_output(
            ["git", "status", "--porcelain"], cwd=repo_root, stderr=subprocess.DEVNULL, text=True
        )
        for line in out_status.splitlines():
            parts = line.strip().split()
            if len(parts) >= 2 and is_python_path(repo_root, parts[-1]):
                files.append(parts[-1])
        return list(dict.fromkeys(files))
    except Exception:
        return []

def symbol_nodes(source: str):
    """Class, function, and method def nodes of a Python source (dunders excluded)."""
    try:
        tree = ast.parse(source)
    except (SyntaxError, ValueError):
        return []
    return [node for node in ast.walk(tree)
            if isinstance(node, ast.ClassDef)
            or isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)) and not node.name.startswith("__")]

def extract_ast_symbols(file_path: str) -> Set[str]:
    """Extract class, function, and method names from a Python source file."""
    if not os.path.isfile(file_path):
        return set()
    try:
        with open(file_path, "r", encoding="utf-8", errors="ignore") as f:
            return {node.name for node in symbol_nodes(f.read())}
    except Exception:
        return set()

def get_changed_symbols(repo_root: str, rel_path: str, base_ref: str = None) -> Set[str]:
    """Compare current AST symbols with base AST symbols or git diff hunks."""
    full_path = os.path.join(repo_root, rel_path)
    current_symbols = extract_ast_symbols(full_path)
    ref_arg = base_ref if base_ref else "HEAD"
    # A symbol that left the file (deleted, renamed away) is changed too; its callers must still run (F17).
    try:
        base_src = subprocess.check_output(
            ["git", "show", f"{ref_arg}:{rel_path}"], cwd=repo_root, stderr=subprocess.DEVNULL, text=True
        )
        gone = {node.name for node in symbol_nodes(base_src)} - current_symbols
    except (subprocess.CalledProcessError, OSError):
        gone = set()
    if not current_symbols:
        return gone

    # Get git diff hunk lines to find symbols in changed regions
    try:
        diff_out = subprocess.check_output(
            ["git", "diff", "-U0", ref_arg, "--", rel_path],
            cwd=repo_root,
            stderr=subprocess.DEVNULL,
            text=True
        )
    except Exception:
        diff_out = ""

    if not diff_out:
        # If no diff vs HEAD, return all symbols as candidate
        return current_symbols | gone

    # A change belongs to the def(s) whose line range encloses a touched new-file line (F14), not to every
    # symbol merely named on an added line. A pure deletion hunk (+N,0) touches line N.
    touched = set()
    for m in re.finditer(r"^@@ -\d+(?:,\d+)? \+(\d+)(?:,(\d+))? @@", diff_out, re.MULTILINE):
        start, count = int(m.group(1)), int(m.group(2) if m.group(2) is not None else 1)
        touched.update(range(start, start + max(count, 1)))
    try:
        with open(full_path, "r", encoding="utf-8", errors="ignore") as f:
            nodes = symbol_nodes(f.read())
    except OSError:
        nodes = []
    changed = set(gone)
    for node in nodes:
        if any(node.lineno <= ln <= node.end_lineno for ln in touched):
            changed.add(node.name)

    return changed if changed else current_symbols

def module_name_from_path(rel_path: str) -> str:
    """e.g. backend/api/auth.py -> backend.api.auth or auth"""
    base = os.path.splitext(rel_path)[0]
    return base.replace("/", ".").replace("\\", ".")

def candidate_test_paths(repo_root: str, pattern: str) -> list[str]:
    """tests/**/test_*.py whose text matches pattern: rg when on PATH, else a python walk of tests/ (F1).
    rg's matches are kept whatever its exit code: exit 2 (an unreadable dir) still printed every match (F11a)."""
    try:
        res = subprocess.run(["rg", "-l", "--glob", "test_*.py", pattern, "tests"],
                             cwd=repo_root, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, check=False)
        return res.stdout.splitlines()
    except FileNotFoundError:
        pass
    rx = re.compile(pattern)
    found = []
    for dirpath, dirnames, filenames in os.walk(os.path.join(repo_root, "tests")):
        dirnames.sort()
        for name in sorted(filenames):
            if name.startswith("test_") and name.endswith(".py"):
                full = os.path.join(dirpath, name)
                try:
                    with open(full, "r", encoding="utf-8", errors="ignore") as fh:
                        if rx.search(fh.read()):
                            found.append(os.path.relpath(full, repo_root).replace(os.sep, "/"))
                except OSError:
                    continue
    return found

def score_test_files(repo_root: str, modified_files: List[str], base_ref: str = None) -> List[Dict]:
    """Score all test files based on AST symbol references and imports."""
    tests_dir = os.path.join(repo_root, "tests")
    if not os.path.isdir(tests_dir):
        return []

    test_scores: Dict[str, Dict] = {}

    for mod_file in modified_files:
        if os.path.basename(mod_file) == "conftest.py":
            # A conftest is not collectable; the tests it configures are everything under its directory (F8).
            conf_dir = os.path.dirname(mod_file) or "."
            test_scores[conf_dir] = {
                "file": conf_dir,
                "score": 100,
                "matched_symbols": ["(conftest)"],
                "specific_tests": []
            }
            continue
        if mod_file.startswith("tests/"):
            # The test file itself was modified!
            test_scores[mod_file] = {
                "file": mod_file,
                "score": 100,
                "matched_symbols": ["(self-modified)"],
                "specific_tests": []
            }
            continue

        symbols = get_changed_symbols(repo_root, mod_file, base_ref)
        base_name = os.path.basename(mod_file).replace(".py", "")
        mod_dotted = module_name_from_path(mod_file)

        # Quick candidate search using ripgrep or python fallback; a test reaching a changed symbol through a
        # re-export never names the module, so the changed symbols are searched too (F2)
        names = [base_name] + sorted(symbols)
        matched_test_paths = candidate_test_paths(repo_root, rf"\b({'|'.join(names)})\b")

        # If base name matches direct test file (e.g. test_<basename>.py; bd-tool -> test_bd_tool.py, F3)
        for canonical_test in dict.fromkeys((f"tests/test_{base_name}.py", f"tests/test_{base_name.replace('-', '_')}.py")):
            if os.path.isfile(os.path.join(repo_root, canonical_test)):
                matched_test_paths.append(canonical_test)

        matched_test_paths = list(set(matched_test_paths))

        for t_rel in matched_test_paths:
            t_full = os.path.join(repo_root, t_rel)
            if not os.path.isfile(t_full):
                continue

            try:
                with open(t_full, "r", encoding="utf-8", errors="ignore") as f:
                    content = f.read()
            except Exception:
                continue

            score = 10
            matched_syms = []
            specific_tests = []

            if f"test_{base_name}.py" in t_rel:
                score += 25

            if mod_dotted in content or f"import {base_name}" in content:
                score += 15

            # Search for specific symbols
            for sym in symbols:
                if re.search(rf"\b{re.escape(sym)}\b", content):
                    score += 20
                    matched_syms.append(sym)

            # Extract test function names that mention any symbol
            try:
                tree = ast.parse(content, filename=t_full)
                for node in ast.walk(tree):
                    if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
                        if node.name.startswith("test_"):
                            func_code = ast.unparse(node) if hasattr(ast, "unparse") else ""
                            for sym in matched_syms:
                                if sym in func_code or sym.lower() in node.name.lower():
                                    specific_tests.append(node.name)
                                    break
            except Exception:
                pass

            prev = test_scores.get(t_rel)
            if prev is not None:
                # merge, never drop the other module's entry (F13)
                prev["score"] = max(prev["score"], score)
                prev["matched_symbols"] = list(dict.fromkeys(prev["matched_symbols"] + matched_syms))
                prev["specific_tests"] = list(dict.fromkeys(prev["specific_tests"] + specific_tests))
            else:
                test_scores[t_rel] = {
                    "file": t_rel,
                    "score": score,
                    "matched_symbols": matched_syms,
                    "specific_tests": list(dict.fromkeys(specific_tests))
                }

    ranked = sorted(test_scores.values(), key=lambda x: x["score"], reverse=True)
    return ranked

def main():
    parser = argparse.ArgumentParser(description="Semantic Test Impact Analysis for LLM Coding Agents")
    parser.add_argument("--diff", metavar="BASE", nargs="?", const="HEAD", help="Inspect git diff against BASE (default: HEAD)")
    parser.add_argument("--file", help="Explicit python file to analyze")
    parser.add_argument("--repo", default=".", help="Repository root path")
    parser.add_argument("--limit", type=int, default=5, help="Max test files to return")
    parser.add_argument("--json", action="store_true", help="Output JSON results")
    parser.add_argument("--pytest-args", action="store_true", help="Print only pytest command line arguments")
    args = parser.parse_args()

    repo_root = get_repo_root(args.repo)
    if args.file:
        modified_files = [args.file]
    else:
        modified_files = get_modified_py_files(repo_root, args.diff)

    if not modified_files:
        if args.json:
            print(json.dumps({"status": "NO_CHANGES", "tests": []}))
        else:
            print("# No modified Python files found.")
        sys.exit(0)

    ranked = score_test_files(repo_root, modified_files, args.diff)[:args.limit]

    if args.json:
        print(json.dumps({"modified_files": modified_files, "impacted_tests": ranked}, indent=2))
        sys.exit(0)

    if not ranked:
        print("# No directly impacted tests identified. Run standard module tests.")
        sys.exit(0)

    if args.pytest_args:
        # Emit space-separated test paths only. No -k: pytest keeps only the last -k on a command line, and
        # specific_tests misses in-file tests that reach a changed symbol indirectly (F6).
        print(" ".join(dict.fromkeys(item["file"] for item in ranked)))
        sys.exit(0)

    # Human/Agent readable summary
    print("=== Semantic Test Impact Analysis (TIA) ===")
    print(f"Modified files: {', '.join(modified_files)}")
    print("Top Impacted Test Targets:")
    for i, item in enumerate(ranked, 1):
        sym_str = ", ".join(item['matched_symbols']) if item['matched_symbols'] else "module dependency"
        print(f" {i}. {item['file']} (Score: {item['score']})")
        print(f"    Symbols: {sym_str}")
        if item["specific_tests"]:
            print(f"    Focus tests: {', '.join(item['specific_tests'][:3])}")
    print("\nRecommended Fast Execution:")
    test_files = " ".join(item["file"] for item in ranked[:3])
    print(f"pytest -q {test_files}")

if __name__ == "__main__":
    main()
