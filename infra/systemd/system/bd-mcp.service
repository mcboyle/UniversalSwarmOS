[Unit]
Description=bd-mcp streamable-http on :8100 (fleet MCP; state lives on this host)
After=network.target
[Service]
User=mboyle
WorkingDirectory=/home/mboyle/bd-persist/harness/bd-mcp
Environment=PATH=/home/mboyle/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/mboyle/bd-persist/harness/bd-mcp/venv/bin/python /home/mboyle/bd-persist/harness/bd-mcp/server.py --http
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
