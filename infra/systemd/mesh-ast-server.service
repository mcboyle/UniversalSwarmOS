[Unit]
Description=Cluster Mesh Tree-sitter & AST Server
After=network.target

[Service]
Type=simple
User=mboyle
WorkingDirectory=/home/mboyle/infra/support-layer
ExecStart=/usr/bin/python3 /home/mboyle/infra/support-layer/ast_server.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
