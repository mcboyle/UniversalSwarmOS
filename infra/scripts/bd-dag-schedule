#!/usr/bin/env python3
"""bd-dag-schedule -- Canonical Quota-Aware DAG Scheduler & Wave Partitioner (Pillar 11).

Compiles task packets and test dependency graphs into topologically sorted execution waves,
monitors active accounting ledgers (usage.sqlite, POOL_STATE.tsv), enforces the 80% high-water
and >5% weekly pace skew circuit breaker, and automatically overflows non-destructive workloads
to the live Virtual Browser Oracle on Node 137 / Node 181 or local satellites.

Fleet Rule 21 compliant: zero site interactions touched.
"""
from __future__ import annotations

import argparse
import csv
import datetime
import json
import math
import os
import sqlite3
import sys
from pathlib import Path
from typing import Any

# Ensure dag_task_compiler is importable
try:
    from dag_task_compiler.compiler import DAGCompiler
    from dag_task_compiler.models import TaskDAG, TaskNode, TaskState
    from dag_task_compiler.scheduler import LeafDispatcher
except ImportError:
    alt_paths = [
        Path("/home/mboyle/teamwork_projects/frontier_blueprint_integration/src"),
        Path("/home/mboyle/UniversalSwarmOS"),
    ]
    for p in alt_paths:
        if p.exists() and str(p) not in sys.path:
            sys.path.insert(0, str(p))
    try:
        from dag_task_compiler.compiler import DAGCompiler
        from dag_task_compiler.models import TaskDAG, TaskNode, TaskState
        from dag_task_compiler.scheduler import LeafDispatcher
    except ImportError:
        # Fallback minimal definitions if package unavailable
        class TaskState:  # type: ignore[no-redef]
            PENDING = "PENDING"
            READY = "READY"
            RUNNING = "RUNNING"
            COMPLETED = "COMPLETED"
            FAILED = "FAILED"
            BLOCKED = "BLOCKED"
            SKIPPED = "SKIPPED"
            PAUSED_FOR_QUOTA_RESET = "PAUSED_FOR_QUOTA_RESET"

        class TaskNode:  # type: ignore[no-redef]
            def __init__(self, **kwargs: Any) -> None:
                self.task_id = kwargs.get("task_id", kwargs.get("id", ""))
                self.name = kwargs.get("name", self.task_id)
                self.dependencies = kwargs.get("dependencies", [])
                self.assigned_pool = kwargs.get("assigned_pool", "cluster")
                self.action_type = kwargs.get("action_type", "test")
                self.command = kwargs.get("command", "")
                self.timeout_sec = float(kwargs.get("timeout_sec", 60.0))
                state_val = kwargs.get("state", TaskState.PENDING)
                self.state = getattr(state_val, "value", state_val)

        class TaskDAG:  # type: ignore[no-redef]
            def __init__(self, nodes: dict[str, TaskNode] | None = None) -> None:
                self.nodes = nodes or {}

        class DAGCompiler:  # type: ignore[no-redef]
            def compile_waves(self, dag: Any) -> list[Any]:
                # Simple topological wave compilation
                waves = []
                remaining = dict(dag.nodes)
                wave_idx = 0
                completed_ids: set[str] = set()
                while remaining:
                    ready = [
                        node for node in remaining.values()
                        if all(d in completed_ids for d in node.dependencies)
                    ]
                    if not ready:
                        break
                    class Wave:
                        def __init__(self, idx: int, tasks: list[Any]) -> None:
                            self.wave_index = idx
                            self.tasks = tasks
                    waves.append(Wave(wave_idx, ready))
                    for node in ready:
                        completed_ids.add(node.task_id)
                        remaining.pop(node.task_id, None)
                    wave_idx += 1
                return waves

            def topological_sort(self, dag: Any) -> list[str]:
                order = []
                for wave in self.compile_waves(dag):
                    order.extend(t.task_id for t in wave.tasks)
                return order

            def prune_on_failure(self, dag: Any, failed_id: str) -> None:
                to_prune = {failed_id}
                changed = True
                while changed:
                    changed = False
                    for nid, node in list(dag.nodes.items()):
                        if any(d in to_prune for d in node.dependencies) and nid not in to_prune:
                            to_prune.add(nid)
                            changed = True
                for nid in to_prune:
                    if nid in dag.nodes:
                        dag.nodes[nid].state = TaskState.SKIPPED

        class LeafDispatcher:  # type: ignore[no-redef]
            def get_ready_leaves(self, dag: Any) -> list[Any]:
                return [
                    node for node in dag.nodes.values()
                    if not node.dependencies and node.state in (TaskState.PENDING, TaskState.READY, "PENDING", "READY")
                ]


